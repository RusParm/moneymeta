---
import wowEconomyWorld from "../assets/game-worlds/wow-economy-world.webp";
import { wowPatchContext } from "../data/wow-economy";
import { wowEconomyNodes, wowMarks, wowMarketRoutes, wowScenarios } from "../data/wow-hub";
import { insights } from "../data/insights";
import "../styles/wow-hub.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "./BrandHeader.astro";
import GameWorldHero from "./GameWorldHero.astro";
import HubDecisionGateway from "./HubDecisionGateway.astro";
import HubGuideFeature from "./HubGuideFeature.astro";
import SiteFooter from "./SiteFooter.astro";
import WowCalculators from "./WowCalculators.astro";
import WowDecisionDeck from "./WowDecisionDeck.astro";
import WowEconomyMap from "./WowEconomyMap.astro";
import WowLibrary from "./WowLibrary.astro";
import WowMarketLedger from "./WowMarketLedger.astro";
import WowMarketMark from "./WowMarketMark.astro";
import WowPlayerPaths from "./WowPlayerPaths.astro";
import WowPulse from "./WowPulse.astro";
import WowRankings from "./WowRankings.astro";

interface Props { lang: "ru" | "en"; }
const { lang } = Astro.props;
const root = lang === "ru" ? "/wow/" : "/en/wow/";
const wowInsightCount = insights.filter((insight) => insight.game === "wow").length;

const copy = lang === "ru" ? {
  title: "Экономика WoW Retail: аукцион, профессии и золото | Money Meta",
  description: "Живая модель экономики WoW Retail: карта рынка, персональные пути, актуальные изменения, рейтинги способов заработка, сценарии и калькуляторы.",
  back: "← Все экономики",
  live: "Модель рынка Retail · проверено 2026-08-18",
  eyebrow: "World of Warcraft Retail · Живой рынок",
  heading: "Не фарми красивую цену. Управляй потоком золота.",
  lede: "Проследи путь капитала от материалов до полученной прибыли. Выбери свою роль на рынке, проверь ликвидность и узнай, где привлекательная маржа перестаёт быть реальной.",
  primary: "Найти мой путь на рынке",
  secondary: "Открыть калькуляторы",
  proof: [
    [String(wowEconomyNodes.length), "звеньев экономики"],
    [String(wowMarketRoutes.length), "рыночных маршрутов"],
    [String(wowScenarios.length), "готовых решений"],
    [String(wowInsightCount), "полных разборов"]
  ],
  loadoutLabel: "Ключевые системы WoW-хаба",
  loadout: [
    [wowMarks.knowledge, "ЗНАНИЯ", "Сброс специализации"],
    [wowMarks.craft, "МАРЖА", "Экономика рецепта"],
    [wowMarks.orders, "ЗАКАЗЫ", "Минимальная комиссия"],
    [wowMarks.liquidity, "ЗОЛОТО", "Реальный доход в час"]
  ] as const,
  navLabel: "Навигация по экономике WoW",
  navBrand: "WOW / РЫНОК",
  nav: [
    ["01", "Старт", "#quick-start"],
    ["02", "Баланс", "#market-ledger"],
    ["03", "Карта", "#economy-map"],
    ["04", "Мой путь", "#player-paths"],
    ["05", "Изменения", "#market-pulse"],
    ["06", "Рейтинги", "#market-rankings"],
    ["07", "Модели", "#scenario-lab"],
    ["08", "Разборы", "#research-library"]
  ],
  manifestoKicker: "Подход Money Meta",
  manifestoTitle: "В WoW есть три разных вида богатства. Не смешивай их.",
  manifestoText: "Золото в сумках, товары по цене выставления и доступ профессии к рынку имеют разную ликвидность. Хаб показывает, как одно превращается в другое и где цепочка ломается.",
  principles: [
    ["ЗОЛОТО", "Только полученное золото финансирует следующий ход."],
    ["ЗАПАСЫ", "Непроданный товар является вложенным капиталом, а не прибылью."],
    ["ЗНАНИЯ", "Специализация создаёт преимущество только при повторяемом спросе."],
    ["ВРЕМЯ", "Фарм, изготовление и работа с заказами по-разному расходуют твоё время."]
  ],
  trustKicker: "Методика · источники · независимость",
  trustTitle: "Официальный контекст отдельно. Рыночная модель отдельно.",
  trustText: "Money Meta связывает изменения Blizzard с решениями игрока, но не выдаёт редактируемые цены и вероятность продажи за данные издателя.",
  trustCards: [
    ["01", "Проверенный контекст", "Curse of Ula’tek, сброс знаний профессии, стоимость декора и сохранение фильтров аукциона привязаны к официальным материалам Blizzard.", "официальный источник"],
    ["02", "Редактируемая модель рынка", "Цены, комиссия аукциона, вероятность продажи, залоги, запас на повторное изготовление и целевой доход в час остаются допущениями игрока.", "рабочая модель"],
    ["03", "Независимый анализ", "Money Meta не связан с Blizzard Entertainment. Визуальный язык и знаки рынка созданы специально для этого продукта.", "независимый проект"]
  ],
  methodology: "Открыть методологию и источники",
  disclaimer: "World of Warcraft и связанные названия являются собственностью Blizzard Entertainment. Money Meta является независимым аналитическим продуктом.",
  roadmap: "Следующий этап WoW после проверки спроса: актуальные региональные цены, контекст WoW Token, отдельные балансы профессий и сохранённый набор рыночных маршрутов."
} : {
  title: "WoW Retail Economy Hub: Auction House, professions and gold | Money Meta",
  description: "A living WoW Retail economy model with a market map, personal paths, current changes, conditional route rankings, scenarios and calculators.",
  back: "← All economies",
  live: "Retail market model · checked 2026-08-18",
  eyebrow: "World of Warcraft Retail · Living Market Hub",
  heading: "Do not farm a price. Manage the flow of gold.",
  lede: "Follow capital from reagent to realized profit. Choose a market role, test liquidity and see where the attractive margin stops being real.",
  primary: "Find my market path",
  secondary: "Open Scenario Lab",
  proof: [
    [String(wowEconomyNodes.length), "economy links"],
    [String(wowMarketRoutes.length), "market routes"],
    [String(wowScenarios.length), "prepared decisions"],
    [String(wowInsightCount), "complete analyses"]
  ],
  loadoutLabel: "Key systems in the WoW hub",
  loadout: [
    [wowMarks.knowledge, "ALLOCATION", "Knowledge reset"],
    [wowMarks.craft, "MARGIN", "Recipe economics"],
    [wowMarks.orders, "SERVICE", "Order floor"],
    [wowMarks.liquidity, "CASH", "Realized GPH"]
  ] as const,
  navLabel: "WoW Economy Hub navigation",
  navBrand: "WOW / MARKET OS",
  nav: [
    ["01", "Start", "#quick-start"],
    ["02", "Snapshot", "#market-ledger"],
    ["03", "Map", "#economy-map"],
    ["04", "My path", "#player-paths"],
    ["05", "Pulse", "#market-pulse"],
    ["06", "Rankings", "#market-rankings"],
    ["07", "Models", "#scenario-lab"],
    ["08", "Research", "#research-library"]
  ],
  manifestoKicker: "The Money Meta difference",
  manifestoTitle: "WoW has three kinds of wealth. Do not mix them.",
  manifestoText: "Gold in bags, inventory at listing price and profession access to a market carry different liquidity. The hub shows how one becomes another and where the chain breaks.",
  principles: [
    ["CASH", "Only realized gold can fund the next move."],
    ["INVENTORY", "Unsold stock is working capital, not profit."],
    ["KNOWLEDGE", "Specialization creates a moat only with repeat demand."],
    ["TIME", "Gathering, crafting and service carry different opportunity costs."]
  ],
  trustKicker: "Methodology · evidence · independence",
  trustTitle: "Official context on one layer. Market model on another.",
  trustText: "Money Meta connects Blizzard changes to player decisions without presenting editable prices or sell-through as publisher data.",
  trustCards: [
    ["01", "Verified context", "Curse of Ula’tek, the profession reset, decor costs and persistent AH filters link to official Blizzard materials.", "official"],
    ["02", "Editable market layer", "Prices, the AH cut, sell-through, deposits, recraft reserve and target GPH remain user assumptions.", "model"],
    ["03", "Independent analysis", "Money Meta is not affiliated with Blizzard Entertainment. The visual system and market marks are original to this product.", "independent"]
  ],
  methodology: "Open methodology and sources",
  disclaimer: "World of Warcraft and related names are property of Blizzard Entertainment. Money Meta is an independent analytical product.",
  roadmap: "The next WoW layer after demand validation: live regional data, Token context, profession-specific ledgers and a saved portfolio of market routes."
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={root}
  alternatePath={lang === "ru" ? "/en/wow/" : "/wow/"}
  schema={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: copy.title,
    description: copy.description,
    inLanguage: lang,
    about: { "@type": "VideoGame", name: "World of Warcraft", publisher: "Blizzard Entertainment" },
    hasPart: [
      { "@type": "SoftwareApplication", name: "WoW Crafting Margin", applicationCategory: "GameApplication" },
      { "@type": "SoftwareApplication", name: "WoW Farm Liquidity", applicationCategory: "GameApplication" },
      { "@type": "SoftwareApplication", name: "WoW Crafting Order Floor", applicationCategory: "GameApplication" },
      { "@type": "ItemList", name: "Conditional WoW market route rankings", numberOfItems: wowMarketRoutes.length }
    ]
  }}
>
  <main id="wow-economy-hub" class="page game-page game-wow wow-living-hub" data-lang={lang}>
    <div class="shell">
      <BrandHeader lang={lang} ruPath="/wow/" enPath="/en/wow/" backPath={lang === "ru" ? "/" : "/en/"} backLabel={copy.back} />

      <GameWorldHero
        image={wowEconomyWorld}
        alt={lang === "ru" ? "Оригинальная иллюстрация Money Meta: магический рынок и потоки капитала WoW Retail" : "Original Money Meta illustration of an arcane market and WoW Retail capital flows"}
        worldCode={lang === "ru" ? "РЫНОЧНЫЙ ЦИКЛ / 03" : "MARKET FLYWHEEL / 03"}
        originalLabel={lang === "ru" ? "Оригинал Money Meta" : "Money Meta original"}
      >
        <div class="hero-live-line"><span></span>{copy.live}</div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="lede">{copy.lede}</p>
        <div class="hero-actions">
          <a class="button primary button-large wow-primary" href="#player-paths">{copy.primary} →</a>
          <a class="button ghost button-large" href="#scenario-lab">{copy.secondary}</a>
        </div>
        <div class="proof-strip">
          {copy.proof.map(([value, label]) => <div class="proof-item"><strong>{value}</strong><span>{label}</span></div>)}
        </div>
        <div class="wow-hero-loadout" aria-label={copy.loadoutLabel}>
          {copy.loadout.map(([mark, label, value]) => (
            <div><WowMarketMark mark={mark} lang={lang} /><span>{label}</span><strong>{value}</strong></div>
          ))}
        </div>
      </GameWorldHero>

      <nav class="hub-jump-nav wow-jump-nav" aria-label={copy.navLabel}>
        <span class="hub-jump-brand"><i aria-hidden="true"></i>{copy.navBrand}</span>
        <div>{copy.nav.map(([code, label, href]) => <a href={href}><span>{code}</span>{label}</a>)}</div>
      </nav>

      <section class="hub-manifesto wow-manifesto" aria-labelledby="wow-manifesto-title">
        <div>
          <span class="section-kicker">{copy.manifestoKicker}</span>
          <h2 id="wow-manifesto-title">{copy.manifestoTitle}</h2>
          <p>{copy.manifestoText}</p>
        </div>
        <div class="manifesto-grid">
          {copy.principles.map(([title, text], index) => (
            <div><span>0{index + 1} / {title}</span><strong>{title}</strong><p>{text}</p></div>
          ))}
        </div>
      </section>

      <HubDecisionGateway hub="wow" lang={lang} />
      <HubGuideFeature hub="wow" lang={lang} />
      <WowMarketLedger lang={lang} />
      <WowEconomyMap lang={lang} />
      <WowPlayerPaths lang={lang} />
      <WowPulse lang={lang} />
      <WowRankings lang={lang} />
      <WowDecisionDeck lang={lang} />
      <WowCalculators lang={lang} />
      <WowLibrary lang={lang} />

      <section id="methodology" class="section hub-section trust-rail wow-trust-rail" aria-labelledby="wow-methodology-title">
        <div class="section-head hub-section-head">
          <div>
            <span class="section-kicker">{copy.trustKicker}</span>
            <h2 id="wow-methodology-title">{copy.trustTitle}</h2>
            <p class="section-copy">{copy.trustText}</p>
          </div>
          <span class="count">{wowPatchContext.release} · {wowPatchContext.checkedAt}</span>
        </div>

        <div class="trust-grid">
          {copy.trustCards.map(([code, title, text, status], index) => (
            <article class="trust-card">
              <div><span>{code}</span><span class={`pill ${index === 0 ? "teal" : index === 1 ? "gold" : "muted"}`}>{status}</span></div>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>

        <details class="wow-method-details">
          <summary>{copy.methodology} ↓</summary>
          <div>
            <p>{wowPatchContext.note[lang]}</p>
            {wowPatchContext.sources.map((source) => (
              <p><a class="source-link" href={source.url} target="_blank" rel="noopener noreferrer"><strong>{source.label[lang]} ↗</strong></a>: {source.note[lang]}</p>
            ))}
            <p>{copy.disclaimer}</p>
            <p>{copy.roadmap}</p>
          </div>
        </details>
      </section>

      <SiteFooter lang={lang} />
    </div>
  </main>
</BaseLayout>
