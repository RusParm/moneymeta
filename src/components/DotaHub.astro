---
import dotaEconomyWorld from "../assets/game-worlds/dota-economy-world.webp";
import { dotaPatchContext } from "../data/dota-economy";
import { dotaMedia, dotaMediaPolicy } from "../data/dota-hub";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "./BrandHeader.astro";
import DotaCalculators from "./DotaCalculators.astro";
import DotaDecisionDeck from "./DotaDecisionDeck.astro";
import DotaEconomyMap from "./DotaEconomyMap.astro";
import DotaLibrary from "./DotaLibrary.astro";
import DotaMedia from "./DotaMedia.astro";
import DotaPlayerPaths from "./DotaPlayerPaths.astro";
import DotaPulse from "./DotaPulse.astro";
import DotaRoleLenses from "./DotaRoleLenses.astro";
import GameWorldHero from "./GameWorldHero.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props { lang: "ru" | "en"; }
const { lang } = Astro.props;
const root = lang === "ru" ? "/dota-2/" : "/en/dota-2/";

const copy = lang === "ru" ? {
  title: "Dota 2 Economy Hub: timing, Midas ROI и buyback | Money Meta",
  description: `Интерактивная экономика Dota 2: путь золота, role-specific решения, patch ${dotaPatchContext.patch} Pulse, Midas ROI, buyback reserve и replay-разборы.`,
  back: "← Все экономики",
  eyebrow: "Dota 2 · Living Match Economy",
  heading: "Золото не выигрывает матч. Но момент траты может.",
  lede: "Money Meta связывает last hits, item timings, Roshan и buyback в одну экономическую систему. Выбери момент матча и посмотри, где greed превращается в потерю tempo.",
  primary: "Открыть карту матча",
  secondary: "Проверить Midas ROI",
  live: `Patch ${dotaPatchContext.patch} · checked ${dotaPatchContext.checkedAt}`,
  proof: [["7", "узлов match economy"], ["3", "role lenses"], ["2", "живые модели"], ["6", "готовых сценариев"]],
  navBrand: "DOTA / MATCH SYSTEM",
  nav: [["01", "Карта", "#economy-map"], ["02", "Пути", "#player-paths"], ["03", "Pulse", "#patch-pulse"], ["04", "Роли", "#role-lenses"], ["05", "Сценарии", "#decision-deck"], ["06", "Модели", "#scenario-lab"], ["07", "Разборы", "#research-library"]],
  manifestoKicker: "Money Meta doctrine · Dota edition",
  manifestoTitle: "Каждая цифра должна заканчиваться игровым действием.",
  manifestoText: "GPM без момента покупки, item timing без objective и buyback без пути обратно в fight остаются неполными метриками. Хаб строится вокруг цепочки решений, а не вокруг ещё одного статичного build guide.",
  principles: [
    ["TIME VALUE", "Одна и та же покупка на 10-й и 30-й минутах работает по-разному."],
    ["OPTIONALITY", "Непотраченное золото может быть ликвидностью, а не ошибкой."],
    ["CONVERSION", "Timing ценен только если превращается в objective или пространство."],
    ["COUNTERFACTUAL", "Replay полезен, когда показывает, где другой ход менял бы результат."]
  ],
  trustKicker: "Methodology · sources · media boundary",
  trustTitle: "Видно, что взято из patch notes, что посчитано и где начинается judgement",
  trustText: "Money Meta не связан с Valve. Изображения предметов и героев используются только для редакционной идентификации механик и могут быть удалены независимо от продукта.",
  trustCards: [
    ["01", "Verified layer", "Версия патча, документированная формула buyback и изменения предметов ведут к официальным notes Valve.", "official source"],
    ["02", "Estimated layer", "Bounty для Midas, неденежная ценность и ожидаемый конец матча остаются редактируемыми допущениями.", "user scenario"],
    ["03", "Visual layer", "Оригинальный мир Money Meta задаёт атмосферу; официальные значки идентифицируют обсуждаемую механику.", "rights-aware"],
  ],
  methodology: "Открыть методологию и первоисточники",
  media: "Media record",
  disclaimer: "Dota, Dota 2 and related artwork are trademarks or property of Valve. Money Meta is an independent analytical product.",
  roadmap: "Следующий слой Dota: death cost, reliable/unreliable gold и post-match timeline import после проверки спроса."
} : {
  title: "Dota 2 Economy Hub: timings, Midas ROI and buyback | Money Meta",
  description: `Interactive Dota 2 economy: the path of gold, role-specific decisions, patch ${dotaPatchContext.patch} Pulse, Midas ROI, buyback reserve and replay research.`,
  back: "← All economies",
  eyebrow: "Dota 2 · Living Match Economy",
  heading: "Gold does not win the match. The timing decision might.",
  lede: "Money Meta connects last hits, item timings, Roshan and buyback into one economic system. Choose a match moment and see where greed becomes lost tempo.",
  primary: "Open the match map",
  secondary: "Test Midas ROI",
  live: `Patch ${dotaPatchContext.patch} · checked ${dotaPatchContext.checkedAt}`,
  proof: [["7", "match-economy nodes"], ["3", "role lenses"], ["2", "live models"], ["6", "prepared scenarios"]],
  navBrand: "DOTA / MATCH SYSTEM",
  nav: [["01", "Map", "#economy-map"], ["02", "Paths", "#player-paths"], ["03", "Pulse", "#patch-pulse"], ["04", "Roles", "#role-lenses"], ["05", "Scenarios", "#decision-deck"], ["06", "Models", "#scenario-lab"], ["07", "Research", "#research-library"]],
  manifestoKicker: "Money Meta doctrine · Dota edition",
  manifestoTitle: "Every number should end in an in-game action.",
  manifestoText: "GPM without a purchase minute, an item timing without an objective, and buyback without a route back into the fight are incomplete metrics. This hub is a chain of decisions, not another static build guide.",
  principles: [
    ["TIME VALUE", "The same purchase at minute 10 and 30 is a different investment."],
    ["OPTIONALITY", "Unspent gold can be liquidity rather than a mistake."],
    ["CONVERSION", "A timing matters only when it becomes an objective or map space."],
    ["COUNTERFACTUAL", "A replay is useful when it finds where another action changes the result."]
  ],
  trustKicker: "Methodology · sources · media boundary",
  trustTitle: "See what came from patch notes, what was modeled and where judgement begins",
  trustText: "Money Meta is not affiliated with Valve. Item and hero images are used only to identify the mechanics under editorial analysis and can be removed independently of the product.",
  trustCards: [
    ["01", "Verified layer", "Patch version, documented buyback formula and stated item changes link to Valve's notes.", "official source"],
    ["02", "Estimated layer", "Midas bounty, non-cash value and expected end time remain editable assumptions.", "user scenario"],
    ["03", "Visual layer", "Original Money Meta world carries the atmosphere; official icons identify the exact mechanic being discussed.", "rights-aware"],
  ],
  methodology: "Open methodology and primary sources",
  media: "Media record",
  disclaimer: "Dota, Dota 2 and related artwork are trademarks or property of Valve. Money Meta is an independent analytical product.",
  roadmap: "Next Dota layer: death cost, reliable/unreliable gold and post-match timeline import after demand validation."
};

const heroLoadout = [
  { asset: dotaMedia.handOfMidas, label: "GROWTH", value: "Midas ROI" },
  { asset: dotaMedia.bkb, label: "TIMING", value: "Fight power" },
  { asset: dotaMedia.aegis, label: "OBJECTIVE", value: "Map conversion" },
  { asset: dotaMedia.tp, label: "LIQUIDITY", value: "Buyback reserve" }
];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={root}
  alternatePath={lang === "ru" ? "/en/dota-2/" : "/dota-2/"}
  schema={{
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: copy.title,
    description: copy.description,
    applicationCategory: "GameApplication",
    operatingSystem: "Web",
    isAccessibleForFree: true,
    about: { "@type": "VideoGame", name: "Dota 2", publisher: "Valve" }
  }}
>
  <main class="page game-page game-dota dota-living-hub" id="dota-economy-hub" data-lang={lang}>
    <div class="shell">
      <BrandHeader lang={lang} ruPath="/dota-2/" enPath="/en/dota-2/" backPath={lang === "ru" ? "/" : "/en/"} backLabel={copy.back} />

      <GameWorldHero image={dotaEconomyWorld} worldCode={`MATCH ECONOMY / ${dotaPatchContext.patch}`}>
        <div class="hero-live-line"><span></span>{copy.live}</div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="lede">{copy.lede}</p>
        <div class="hero-actions">
          <a class="button primary dota-primary" href="#economy-map">{copy.primary} →</a>
          <a class="button ghost" href="#midas-irr">{copy.secondary}</a>
        </div>
        <div class="proof-strip">
          {copy.proof.map(([value, label]) => <div class="proof-item"><strong>{value}</strong><span>{label}</span></div>)}
        </div>
        <div class="dota-hero-loadout" aria-label={lang === "ru" ? "Ключевые Dota-механики хаба" : "Key Dota mechanics in the hub"}>
          {heroLoadout.map(({ asset, label, value }) => (
            <div><DotaMedia asset={asset} lang={lang} eager /><span>{label}</span><strong>{value}</strong></div>
          ))}
        </div>
      </GameWorldHero>

      <nav class="hub-jump-nav dota-jump-nav" aria-label={lang === "ru" ? "Навигация Dota-хаба" : "Dota hub navigation"}>
        <span class="hub-jump-brand"><i></i>{copy.navBrand}</span>
        <div>{copy.nav.map(([code, label, href]) => <a href={href}><span>{code}</span>{label}</a>)}</div>
      </nav>

      <section class="hub-manifesto dota-manifesto" aria-labelledby="dota-manifesto-title">
        <div>
          <span class="section-kicker">{copy.manifestoKicker}</span>
          <h2 id="dota-manifesto-title">{copy.manifestoTitle}</h2>
          <p>{copy.manifestoText}</p>
        </div>
        <div class="manifesto-grid">
          {copy.principles.map(([title, text], index) => (
            <div><span>0{index + 1} / {title}</span><strong>{title}</strong><p>{text}</p></div>
          ))}
        </div>
      </section>

      <DotaEconomyMap lang={lang} />
      <DotaPlayerPaths lang={lang} />
      <DotaPulse lang={lang} />
      <DotaRoleLenses lang={lang} />
      <DotaDecisionDeck lang={lang} />
      <DotaCalculators lang={lang} />
      <DotaLibrary lang={lang} />

      <section id="methodology" class="section hub-section trust-rail" aria-labelledby="dota-methodology-title">
        <div class="section-head hub-section-head">
          <div>
            <span class="section-kicker">{copy.trustKicker}</span>
            <h2 id="dota-methodology-title">{copy.trustTitle}</h2>
            <p class="section-copy">{copy.trustText}</p>
          </div>
          <span class="count">{dotaPatchContext.patch} · {dotaPatchContext.checkedAt}</span>
        </div>

        <div class="trust-grid">
          {copy.trustCards.map(([code, title, text, status]) => (
            <article class="trust-card">
              <div><span>{code}</span><span class="pill muted">{status}</span></div>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>

        <details class="dota-method-details">
          <summary>{copy.methodology} ↓</summary>
          <div>
            <p>{dotaPatchContext.note[lang]}</p>
            {dotaPatchContext.sources.map((source) => (
              <p><a class="source-link" href={source.url} target="_blank" rel="noopener noreferrer"><strong>{source.label} ↗</strong></a>: {source.note[lang]}</p>
            ))}
            <p><strong>{copy.media}:</strong> {dotaMediaPolicy.owner} · {dotaMediaPolicy.placement} · checked {dotaMediaPolicy.checkedAt}. {dotaMediaPolicy.licenseBasis}.</p>
            <p>{copy.disclaimer}</p>
            <p>{copy.roadmap}</p>
          </div>
        </details>
      </section>

      <SiteFooter lang={lang} />
    </div>
  </main>
</BaseLayout>
