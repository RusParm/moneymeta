---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ck3World from "../assets/game-worlds/ck3-economy-world.webp";
import dotaWorld from "../assets/game-worlds/dota-economy-world.webp";
import gtaWorld from "../assets/game-worlds/gta-economy-world.webp";
import totalWarWorld from "../assets/game-worlds/total-war-economy-world.webp";
import wowWorld from "../assets/game-worlds/wow-economy-world.webp";
import { getGoalPlannerPath, goalPlanners } from "../data/goal-planners";
import { getHubPath, hubPortals, type HubLocale, type HubPortalId } from "../data/hub-portals";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/wow-hub.css";
import "../styles/strategy-hub.css";
import "../styles/hub-portal.css";
import "../styles/goal-planner.css";
import BrandHeader from "./BrandHeader.astro";
import HubGameMark from "./HubGameMark.astro";
import ScenarioActions from "./ScenarioActions.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props { hub: HubPortalId; lang: HubLocale; }
const { hub: hubId, lang } = Astro.props;
const hub = hubPortals[hubId];
const planner = goalPlanners[hubId];
const worlds: Record<HubPortalId, ImageMetadata> = { gta: gtaWorld, dota: dotaWorld, wow: wowWorld, "total-war": totalWarWorld, ck3: ck3World };
const canonical = getGoalPlannerPath(hubId, lang);
const alternate = getGoalPlannerPath(hubId, lang === "ru" ? "en" : "ru");
const root = getHubPath(hubId, lang);
const tools = getHubPath(hubId, lang, "tools");
const guides = getHubPath(hubId, lang, "guides");
const insightPrefix = lang === "ru" ? "" : "/en";
const guidePath = `${insightPrefix}/insights/${planner.guideSlug}/`;
const localizedStatus = Object.fromEntries(Object.entries(planner.status).map(([key, value]) => [key, { title: value.title[lang], text: value.text[lang] }]));
const mainClass = hubId === "gta" ? "game-gta" : hubId === "dota" ? "game-dota" : hubId === "wow" ? "game-wow" : `strategy-${hubId}`;
const media = hub.media[0];

const copy = lang === "ru" ? {
  back: "← К инструментам игры",
  portal: "Портал",
  tools: "Инструменты",
  planner: "Планировщик цели",
  live: "Живая модель",
  inputs: "Твои вводные",
  inputsText: "Все числа - редактируемый сценарий. Официальный источник определяет только текущий контекст игры.",
  result: "Ответ для текущего сценария",
  gap: "Разрыв до цели",
  runway: "Срок при текущем темпе",
  requiredRate: "Нужный темп",
  projected: "К контрольной точке",
  slack: "Запас / дефицит",
  progress: "Профинансировано сейчас",
  readyAt: hubId === "dota" ? "Готово к минуте" : "Текущий темп",
  infinite: "темп равен нулю",
  methodKicker: "Как читать модель",
  methodTitle: "Один результат. Три проверки перед действием.",
  guideKicker: "Связанный полевой гайд",
  guideTitle: "Не просто срок - протокол пересборки плана",
  guideText: "Полный материал объясняет, какие вводные нельзя смешивать, как проверять плохой сценарий и что менять первым при дефиците.",
  readGuide: "Открыть полный гайд",
  source: "Текущий первоисточник",
  next: "Продолжить решение",
  deepTools: "Глубокие модели игры",
  allGuides: "Все гайды",
  gamePortal: "Карта хаба",
  checked: "проверено"
} : {
  back: "← Back to game tools",
  portal: "Portal",
  tools: "Tools",
  planner: "Goal runway",
  live: "Live model",
  inputs: "Your inputs",
  inputsText: "Every number is an editable scenario. The primary source defines only the current game context.",
  result: "Answer for the current scenario",
  gap: "Funding gap",
  runway: "Runway at current pace",
  requiredRate: "Required pace",
  projected: "At the checkpoint",
  slack: "Slack / shortfall",
  progress: "Funded now",
  readyAt: hubId === "dota" ? "Ready at minute" : "Current pace",
  infinite: "current pace is zero",
  methodKicker: "How to read the model",
  methodTitle: "One result. Three checks before acting.",
  guideKicker: "Connected field guide",
  guideTitle: "Not just a date - a protocol for rebuilding the plan",
  guideText: "The full guide explains which inputs must stay separate, how to run the adverse case and what to change first when the runway fails.",
  readGuide: "Read the complete guide",
  source: "Current primary source",
  next: "Continue the decision",
  deepTools: "Deep game models",
  allGuides: "All guides",
  gamePortal: "Hub map",
  checked: "checked"
};

const pageTitle = `${planner.title[lang]} · ${hub.name} | Money Meta`;
---

<BaseLayout
  title={pageTitle}
  description={`${planner.description[lang]} ${planner.payoff[lang]}`}
  lang={lang}
  canonicalPath={canonical}
  alternatePath={alternate}
  schema={{
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: pageTitle,
    description: planner.description[lang],
    inLanguage: lang,
    applicationCategory: "GameApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
    about: { "@type": "VideoGame", name: hub.name, publisher: hub.publisher }
  }}
>
  <main class={`page goal-planner-page ${mainClass} goal-planner-${hubId}`} data-goal-planner={hubId} data-lang={lang}>
    <div class="shell">
      <BrandHeader lang={lang} ruPath={getGoalPlannerPath(hubId, "ru")} enPath={getGoalPlannerPath(hubId, "en")} backPath={tools} backLabel={copy.back} />

      <section class="goal-planner-hero" aria-labelledby={`${hubId}-goal-planner-title`}>
        <Image class="goal-planner-hero-art" src={worlds[hubId]} alt="" widths={[520, 780, 1040, 1440]} sizes="(max-width: 760px) calc(100vw - 28px), 1180px" loading="eager" decoding="async" />
        <div class="goal-planner-hero-copy">
          <nav aria-label="Breadcrumb"><a href={root}>{hub.name}</a><span>/</span><a href={tools}>{copy.tools}</a><span>/</span><span>{copy.planner}</span></nav>
          <div class="goal-planner-title-row"><HubGameMark hub={hubId} section="tools" lang={lang} large /><div><span>{copy.live} · {hub.version[lang]}</span><h1 id={`${hubId}-goal-planner-title`}>{planner.title[lang]}</h1></div></div>
          <p>{planner.description[lang]}</p>
          <dl><div><dt>{lang === "ru" ? "Вопрос" : "Question"}</dt><dd>{planner.question[lang]}</dd></div><div><dt>{lang === "ru" ? "Результат" : "Outcome"}</dt><dd>{planner.payoff[lang]}</dd></div></dl>
        </div>
        <aside><span>{hub.shortName} / RUNWAY</span><strong>{planner.periodLabel[lang]}</strong><small>{hub.checkedAt} · {hub.sourceLabel[lang]}</small></aside>
      </section>

      <nav class="goal-planner-local-nav" aria-label={copy.planner}>
        <a href={root}><span>00</span><strong>{copy.portal}</strong></a>
        <a href={tools}><span>05</span><strong>{copy.tools}</strong></a>
        <a href={guides}><span>04</span><strong>{lang === "ru" ? "Гайды" : "Guides"}</strong></a>
      </nav>

      <section
        id="goal-runway"
        class="goal-planner-workbench"
        data-runway-root
        data-scenario-root
        data-scenario-key={`${hubId}-goal-runway`}
        data-status={JSON.stringify(localizedStatus)}
        data-prefix={planner.valuePrefix}
        data-suffix={planner.valueSuffix[lang]}
        data-rate-suffix={planner.rateSuffix[lang]}
        data-period={planner.periodShort[lang]}
        data-infinite={copy.infinite}
      >
        <div class="goal-planner-workbench-head"><div><span>{copy.live} · 01</span><h2>{planner.question[lang]}</h2><p>{copy.inputsText}</p></div><HubGameMark hub={hubId} section="tools" lang={lang} /></div>
        <div class="goal-planner-grid">
          <form class="goal-planner-input-card">
            <span>{copy.inputs}</span>
            <div class="goal-planner-fields">
              {planner.fields.map((item) => (
                <label>
                  <span>{item.label[lang]}</span>
                  <input data-role={item.role} type="number" min={item.min} step={item.step} value={item.defaultValue} inputmode="decimal" />
                  <small>{item.hint[lang]}</small>
                </label>
              ))}
            </div>
          </form>

          <article class="goal-planner-result" data-runway-result aria-live="polite">
            <span>{copy.result}</span>
            <h2 data-runway-status-title>-</h2>
            <p data-runway-status-text>-</p>
            <div class="goal-planner-progress" data-runway-progress role="progressbar" aria-label={copy.progress} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div><span>{copy.progress}</span><strong data-runway-progress-label>-</strong></div><i aria-hidden="true"><b data-runway-progress-bar></b></i></div>
            <dl>
              <div><dt>{copy.gap}</dt><dd data-runway-output="gap">-</dd></div>
              <div><dt>{copy.runway}</dt><dd data-runway-output="periods">-</dd></div>
              <div><dt>{copy.requiredRate}</dt><dd data-runway-output="required-rate">-</dd></div>
              <div><dt>{copy.projected}</dt><dd data-runway-output="projected">-</dd></div>
              <div><dt>{copy.slack}</dt><dd data-runway-output="slack">-</dd></div>
              <div><dt>{copy.readyAt}</dt><dd data-runway-output="ready-at">-</dd></div>
            </dl>
            <ScenarioActions lang={lang} />
          </article>
        </div>
      </section>

      <section class="goal-planner-method" aria-labelledby={`${hubId}-goal-method-title`}>
        <div><span>{copy.methodKicker}</span><h2 id={`${hubId}-goal-method-title`}>{copy.methodTitle}</h2></div>
        <ol>{planner.steps.map((step) => <li><b>{step.code}</b><div><strong>{step.title[lang]}</strong><p>{step.text[lang]}</p></div></li>)}</ol>
      </section>

      <section class="goal-planner-guide" aria-labelledby={`${hubId}-goal-guide-title`}>
        {media && <a class="goal-planner-guide-media" href={media.sourceUrl} target="_blank" rel="noopener noreferrer"><img src={media.src} alt={media.alt[lang]} loading="lazy" decoding="async" style={`object-position:${media.position ?? "50% 50%"}`} /><small>{media.sourceLabel} · {copy.source} ↗</small></a>}
        <div><span>{copy.guideKicker}</span><h2 id={`${hubId}-goal-guide-title`}>{copy.guideTitle}</h2><p>{copy.guideText}</p><a class="button primary" href={guidePath}>{copy.readGuide} →</a></div>
        <aside><span>{hub.version[lang]}</span><strong>{copy.checked} {hub.checkedAt}</strong><a href={hub.sourceUrl} target="_blank" rel="noopener noreferrer">{hub.sourceLabel[lang]} ↗</a></aside>
      </section>

      <section class="goal-planner-next" aria-labelledby={`${hubId}-goal-next-title`}>
        <div><span>{copy.next}</span><h2 id={`${hubId}-goal-next-title`}>{lang === "ru" ? "От горизонта - к точному решению" : "From runway to the exact decision"}</h2></div>
        <div><a href={tools}><span>Σ</span><strong>{copy.deepTools}</strong><small>{hub.sections.find((item) => item.slug === "tools")!.payoff[lang]}</small></a><a href={guides}><span>G</span><strong>{copy.allGuides}</strong><small>{hub.sections.find((item) => item.slug === "guides")!.payoff[lang]}</small></a><a href={root}><span>00</span><strong>{copy.gamePortal}</strong><small>{hub.valueTitle[lang]}</small></a></div>
      </section>

      <SiteFooter lang={lang} />
    </div>
  </main>
</BaseLayout>

<script>
  import { calculateRunway } from "../lib/runway";

  type StatusCopy = Record<string, { title: string; text: string }>;
  const plannerRoot = document.querySelector<HTMLElement>("[data-runway-root]");
  if (plannerRoot) {
    const input = (role: string) => plannerRoot.querySelector<HTMLInputElement>(`input[data-role="${role}"]`);
    const output = (role: string) => plannerRoot.querySelector<HTMLElement>(`[data-runway-output="${role}"]`)!;
    const value = (role: string) => {
      const numeric = Number(input(role)?.value ?? 0);
      return Number.isFinite(numeric) ? Math.max(0, numeric) : 0;
    };
    const lang = document.documentElement.lang === "ru" ? "ru" : "en";
    const locale = lang === "ru" ? "ru-RU" : "en-US";
    const prefix = plannerRoot.dataset.prefix ?? "";
    const suffix = plannerRoot.dataset.suffix ?? "";
    const rateSuffix = plannerRoot.dataset.rateSuffix ?? "";
    const period = plannerRoot.dataset.period ?? "";
    const infinite = plannerRoot.dataset.infinite ?? "∞";
    const status = JSON.parse(plannerRoot.dataset.status ?? "{}") as StatusCopy;
    const number = new Intl.NumberFormat(locale, { maximumFractionDigits: 0 });
    const decimal = new Intl.NumberFormat(locale, { maximumFractionDigits: 1 });
    const money = (amount: number) => `${prefix}${number.format(Math.round(amount))}${suffix}`;
    const signedMoney = (amount: number) => `${amount >= 0 ? "+" : "−"}${money(Math.abs(amount))}`;
    const controls = [...plannerRoot.querySelectorAll<HTMLInputElement>("input[data-role]")];
    const resultPanel = plannerRoot.querySelector<HTMLElement>("[data-runway-result]")!;
    const statusTitle = plannerRoot.querySelector<HTMLElement>("[data-runway-status-title]")!;
    const statusText = plannerRoot.querySelector<HTMLElement>("[data-runway-status-text]")!;
    const progressLabel = plannerRoot.querySelector<HTMLElement>("[data-runway-progress-label]")!;
    const progressBar = plannerRoot.querySelector<HTMLElement>("[data-runway-progress-bar]")!;
    const progressRegion = plannerRoot.querySelector<HTMLElement>("[data-runway-progress]")!;

    const render = () => {
      const clock = value("clock");
      const horizon = input("deadline") ? Math.max(0, value("deadline") - clock) : value("horizon");
      const result = calculateRunway({ current: value("current"), target: value("target"), reserve: value("reserve"), rate: value("rate"), horizon });
      const copy = status[result.state] ?? { title: result.state, text: "" };
      const progress = Math.round(result.progress * 100);
      statusTitle.textContent = copy.title;
      statusText.textContent = copy.text;
      resultPanel.dataset.state = result.state;
      output("gap").textContent = money(result.gap);
      output("periods").textContent = Number.isFinite(result.periods) ? `${decimal.format(result.periods)} ${period}` : infinite;
      output("required-rate").textContent = Number.isFinite(result.requiredRate) ? `${prefix}${number.format(Math.ceil(result.requiredRate))}${rateSuffix}` : infinite;
      output("projected").textContent = money(result.projected);
      output("slack").textContent = signedMoney(result.slack);
      output("ready-at").textContent = input("clock")
        ? (Number.isFinite(result.periods) ? `${decimal.format(clock + result.periods)} ${lang === "ru" ? "мин" : "min"}` : infinite)
        : `${prefix}${number.format(value("rate"))}${rateSuffix}`;
      progressLabel.textContent = `${progress}%`;
      progressBar.style.width = `${progress}%`;
      progressRegion.setAttribute("aria-valuenow", String(progress));
    };

    controls.forEach((control) => control.addEventListener("input", render));
    render();
  }
</script>
