---
import type { StrategyHubData, StrategyLocale } from "../data/strategy-hubs";
import ScenarioActions from "./ScenarioActions.astro";
import StrategyMark from "./StrategyMark.astro";
import { strategyDecisionCopy } from "../lib/strategy-decision-copy";
import { strategyMoneyLimit } from "../lib/strategy-decision";
import "../styles/strategy-decision.css";

interface Props { lang: StrategyLocale; data: StrategyHubData; }
const { lang, data } = Astro.props;

const copy = lang === "ru" ? {
  kicker: "Модели сценариев · значения можно менять",
  title: "Три модели, которые превращают кампанию в решение",
  text: "Ниже стоят демонстрационные значения. Замени их цифрами из своей кампании и сразу проверь срок окупаемости, запас прочности или другой вариант развития событий.",
  status: "Расчёт · можно настроить",
  inputTitle: "Вводные сценария",
  result: "Результат модели",
  reset: "Вернуть исходные значения",
  optionA: "Вариант A",
  optionB: "Вариант B"
} : {
  kicker: "Scenario Lab · editable assumptions",
  title: "Three models that turn a campaign into a decision",
  text: "The values below are demonstration baselines. Replace them with numbers from your campaign and test payback, runway or the counterfactual immediately.",
  status: "Estimated · editable",
  inputTitle: "Scenario inputs",
  result: "Model result",
  reset: "Restore baseline",
  optionA: "Option A",
  optionB: "Option B"
};
---

<section id="scenario-lab" class="section hub-section strategy-scenario-lab" aria-labelledby={`${data.id}-scenario-lab-title`}>
  <div class="section-head hub-section-head">
    <div>
      <span class="section-kicker">{copy.kicker}</span>
      <h2 id={`${data.id}-scenario-lab-title`}>{copy.title}</h2>
      <p class="section-copy">{copy.text}</p>
    </div>
    <span class="pill strategy-pill">{copy.status}</span>
  </div>

  {data.models.map((model, modelIndex) => {
    const decision = strategyDecisionCopy(lang, data.id, model.id);
    return (
    <section
      id={model.id}
      class="strategy-model"
      aria-labelledby={`${model.id}-title`}
      data-strategy-model
      data-model-kind={model.kind}
      data-currency-unit={data.currencyUnit[lang]}
      data-period-unit={data.periodUnit[lang]}
      data-winner-a={model.winnerLabels?.a[lang] ?? "A"}
      data-winner-b={model.winnerLabels?.b[lang] ?? "B"}
      data-winner-tie={model.winnerLabels?.tie[lang] ?? "Tie"}
      data-lang={lang}
      data-game-id={data.id}
    >
      <div class="strategy-model-head">
        <StrategyMark mark={model.mark} lang={lang} label={`0${modelIndex + 1}`} large />
        <div>
          <span class="section-kicker">{model.kicker[lang]}</span>
          <h3 id={`${model.id}-title`}>{model.kind === "reserve" ? decision.title : model.title[lang]}</h3>
          <p>{model.kind === "reserve" ? decision.intro : model.text[lang]}</p>
        </div>
        <span class="pill muted">{data.version[lang]}</span>
      </div>

      <div class="grid-2 strategy-model-grid" data-scenario-root data-scenario-key={`${data.id}-${model.id}`}>
        <form class="card strategy-input-card">
          <div class="strategy-input-title"><span>{copy.inputTitle}</span><strong>0{modelIndex + 1}</strong></div>
          {model.kind === "reserve" && <p class="strategy-decision-help">{decision.inputs}</p>}
          <div class="form-grid strategy-form-grid">
            {model.inputs.map((input, index) => (
              <div class:list={["field", input.group && `option-${input.group}`]}>
                {input.group && (index === 0 || model.inputs[index - 1]?.group !== input.group) && (
                  <span class="strategy-option-label">{input.group === "a" ? copy.optionA : copy.optionB}</span>
                )}
                <label for={`${data.id}-${model.id}-${input.key}`}>{input.label[lang]}</label>
                <input
                  id={`${data.id}-${model.id}-${input.key}`}
                  data-model-input={input.key}
                  data-role={input.key}
                  type="number"
                  value={input.value}
                  min={model.kind === "reserve" && input.key === "incomePerPeriod" ? -strategyMoneyLimit : input.min}
                  max={model.kind === "reserve" ? (input.key === "horizonPeriods" ? 600 : strategyMoneyLimit) : input.max}
                  step={model.kind === "reserve" && input.key !== "horizonPeriods" ? "any" : input.step ?? 1}
                  required
                />
              </div>
            ))}
          </div>
          {model.kind === "reserve" && <>
            <p class="strategy-decision-help">{decision.sourceHint}</p>
            <details class="strategy-decision-changes">
              <summary>{decision.changes}</summary>
              <div class="form-grid strategy-form-grid">
                <div class="field">
                  <label for={`${data.id}-${model.id}-actionDelayPeriods`}>{decision.delay}</label>
                  <input id={`${data.id}-${model.id}-actionDelayPeriods`} type="number" data-model-input="actionDelayPeriods" data-role="actionDelayPeriods" value="1" min="0" max="600" step="1" required />
                </div>
                <div class="field">
                  <label for={`${data.id}-${model.id}-incomeChangePeriod`}>{decision.changePeriod}</label>
                  <input id={`${data.id}-${model.id}-incomeChangePeriod`} type="number" data-model-input="incomeChangePeriod" data-role="incomeChangePeriod" value="0" min="0" max="600" step="1" required />
                </div>
                <div class="field">
                  <label for={`${data.id}-${model.id}-incomeChange`}>{decision.change}</label>
                  <input id={`${data.id}-${model.id}-incomeChange`} type="number" data-model-input="incomeChange" data-role="incomeChange" value="0" min={-strategyMoneyLimit} max={strategyMoneyLimit} step="any" required />
                </div>
              </div>
              <p class="strategy-decision-help">{decision.changeHelp}</p>
            </details>
          </>}
          <button class="button ghost strategy-reset" data-model-reset type="button">↺ {copy.reset}</button>
        </form>

        <article class="card result-panel strategy-result-panel" data-model-result aria-live="polite">
          <div class="strategy-result-top"><span class="result-label">{copy.result}</span><StrategyMark mark={model.mark} lang={lang} /></div>
          <div class="result-name" data-model-verdict>{model.title[lang]}</div>
          {model.kind === "reserve" ? <>
            <p class="strategy-decision-invalid" data-decision-invalid hidden>{decision.invalid}</p>
            <div data-decision-body>
              <p class="strategy-decision-answer" data-decision-answer></p>
              <div class="result-metrics strategy-result-metrics">
                <div class="result-metric is-primary"><span>{decision.final}</span><strong data-decision-output="cashAtTarget">-</strong></div>
                <div class="result-metric"><span>{decision.minimum}</span><strong data-decision-output="lowestCash">-</strong></div>
                <div class="result-metric"><span>{decision.breach}</span><strong data-decision-output="firstBreach">-</strong></div>
                <div class="result-metric"><span>{decision.maxAdded}</span><strong data-decision-output="maxAdded">-</strong></div>
              </div>
              <section class="strategy-decision-income-threshold" aria-label={decision.incomeThresholdTitle}>
                <h4>{decision.incomeThresholdTitle}</h4>
                <p data-decision-income-threshold></p>
                <button class="button ghost" type="button" data-decision-income-apply hidden></button>
                <details><summary>{lang === "ru" ? "Что меняется в проверке" : "What changes in this check"}</summary><p>{decision.incomeThresholdHelp}</p></details>
              </section>
              <div class="strategy-decision-table-wrap">
                <table class="strategy-decision-table">
                  <caption>{decision.tableLabel}</caption>
                  <thead><tr><th scope="col">{decision.choice}</th><th scope="col">{decision.cash}</th><th scope="col">{decision.first}</th></tr></thead>
                  <tbody>{["now", "later", "keep"].map((choice) => <tr data-decision-choice={choice}>
                    <th scope="row" data-decision-choice-name>{decision[choice as "now" | "later" | "keep"]}</th>
                    <td data-decision-choice-cash>-</td><td data-decision-choice-breach>-</td>
                  </tr>)}</tbody>
                </table>
              </div>
              <p class="strategy-decision-help" data-decision-income-note></p>
              <p class="strategy-decision-help">{decision.timing}</p>
              <details class="strategy-decision-path">
                <summary>{decision.path}</summary>
                <p class="strategy-decision-help">{decision.pathHelp}</p>
                <div class="strategy-decision-table-wrap" tabindex="0" role="region" aria-label={decision.path}>
                  <table class="strategy-decision-table">
                    <thead><tr><th scope="col">{decision.period}</th><th scope="col">{decision.now}</th><th scope="col">{decision.later}</th><th scope="col">{decision.keep}</th></tr></thead>
                    <tbody data-decision-path></tbody>
                  </table>
                </div>
              </details>
              <p class="strategy-decision-help">{decision.after}</p>
            </div>
          </> : <>
          <p class="result-reason">{model.note[lang]}</p>
          <div class="result-metrics strategy-result-metrics">
            {model.results.map((result) => (
              <div class={`result-metric ${result.accent ? `is-${result.accent}` : ""}`}>
                <span>{result.label[lang]}</span>
                <strong data-model-output={result.key} data-output-format={result.format}>-</strong>
              </div>
            ))}
          </div>
          </>}
          <ScenarioActions lang={lang} />
        </article>
      </div>
    </section>
  );})}
</section>

<script>
  import {
    calculateComparisonMetrics,
    calculateInvestmentMetrics
  } from "../lib/strategy-economy";
  import { calculateReserveDecision, strategyMoneyLimit } from "../lib/strategy-decision";
  import { strategyDecisionCopy } from "../lib/strategy-decision-copy";

  document.querySelectorAll<HTMLElement>("[data-strategy-model]").forEach((root) => {
    root.querySelector("form")?.addEventListener("submit", (event) => event.preventDefault());
    const inputs = [...root.querySelectorAll<HTMLInputElement>("[data-model-input]")];
    const outputs = [...root.querySelectorAll<HTMLElement>("[data-model-output]")];
    const resultPanel = root.querySelector<HTMLElement>("[data-model-result]")!;
    const verdict = root.querySelector<HTMLElement>("[data-model-verdict]")!;
    const reset = root.querySelector<HTMLButtonElement>("[data-model-reset]")!;
    const baselines = new Map(inputs.map((input) => [input.dataset.modelInput ?? "", input.value]));
    const lang = root.dataset.lang === "ru" ? "ru" : "en";
    const decision = strategyDecisionCopy(lang, root.dataset.gameId ?? "", root.id);
    const scenario = root.querySelector<HTMLElement>("[data-scenario-root]")!;
    const formatter = new Intl.NumberFormat(lang === "ru" ? "ru-RU" : "en-US", { maximumFractionDigits: 1 });

    const value = (key: string) => {
      const input = inputs.find((candidate) => candidate.dataset.modelInput === key);
      const parsed = Number(input?.value ?? 0);
      return Number.isFinite(parsed) ? parsed : 0;
    };

    const format = (number: number, kind: string) => {
      if (!Number.isFinite(number)) return "∞";
      if (kind === "currency") return `${formatter.format(number)} ${root.dataset.currencyUnit ?? ""}`.trim();
      if (kind === "percent") return `${formatter.format(number)}%`;
      if (kind === "periods") return `${formatter.format(number)} ${root.dataset.periodUnit ?? ""}`.trim();
      return formatter.format(number);
    };

    const render = () => {
      const kind = root.dataset.modelKind;
      let metrics: Record<string, number | string> = {};
      let positive = true;

      if (kind === "reserve") {
        const invalid = inputs.some((input) => !input.value.trim() || !Number.isFinite(Number(input.value)) || input.validity.rangeOverflow || input.validity.rangeUnderflow);
        const calculated = invalid ? null : calculateReserveDecision({
          treasury: value("treasury"), incomePerPeriod: value("incomePerPeriod"),
          currentOutflow: value("currentOutflow"), newOutflow: value("newOutflow"),
          oneOffCost: value("oneOffCost"), horizonPeriods: value("horizonPeriods"), reserve: value("reserve"),
          actionDelayPeriods: value("actionDelayPeriods"), incomeChangePeriod: value("incomeChangePeriod"), incomeChange: value("incomeChange")
        });
        scenario.dataset.scenarioValid = String(calculated !== null);
        root.querySelector<HTMLElement>("[data-decision-invalid]")!.hidden = calculated !== null;
        root.querySelector<HTMLElement>("[data-decision-body]")!.hidden = calculated === null;
        if (!calculated) {
          verdict.textContent = lang === "ru" ? "Проверь вводные" : "Check the inputs";
          resultPanel.dataset.state = "invalid";
          root.querySelectorAll<HTMLElement>("[data-decision-output]").forEach((output) => { output.textContent = "-"; });
          return;
        }
        const isRu = lang === "ru";
        const precise = new Intl.NumberFormat(isRu ? "ru-RU" : "en-US", { maximumFractionDigits: 2 });
        const cash = (amount: number) => `${precise.format(amount)} ${root.dataset.currencyUnit}`;
        const period = (number: number | null) => number === null ? decision.none
          : number === 0 ? decision.immediate : `${decision.period} ${number}`;
        const cap = calculated.maxAddedOutflow;
        // Display an affordable cap rounded down; do not round an unaffordable amount up.
        const capText = cap === null ? decision.impossible : `${precise.format(Math.floor(cap * 100 + 1e-8) / 100)} ${root.dataset.currencyUnit}`;
        const extraCash = `${precise.format(Math.ceil(calculated.extraTreasuryNeeded * 100 - 1e-8) / 100)} ${root.dataset.currencyUnit}`;
        verdict.textContent = calculated.now.firstBreachPeriod === null ? decision.safe : decision.unsafe;
        resultPanel.dataset.state = calculated.now.firstBreachPeriod === null ? "positive" : "negative";
        const outputValues: Record<string, string> = {
          cashAtTarget: cash(calculated.now.cashAtTarget), lowestCash: cash(calculated.now.lowestCash),
          firstBreach: period(calculated.now.firstBreachPeriod), maxAdded: capText
        };
        root.querySelectorAll<HTMLElement>("[data-decision-output]").forEach((output) => { output.textContent = outputValues[output.dataset.decisionOutput ?? ""] ?? "-"; });
        const unit = root.dataset.periodUnit ?? "";
        const perUnit = root.dataset.gameId === "total-war" ? (isRu ? "ход" : "turn") : (isRu ? "месяц" : "month");
        const threshold = calculated.incomeThreshold;
        const thresholdText = root.querySelector<HTMLElement>("[data-decision-income-threshold]")!;
        const thresholdButton = root.querySelector<HTMLButtonElement>("[data-decision-income-apply]")!;
        thresholdButton.hidden = true;
        delete thresholdButton.dataset.income;
        if (!threshold) thresholdText.textContent = decision.incomeThresholdImmediate;
        else if (threshold.incomeToApply === null) thresholdText.textContent = threshold.minimumIncome < -strategyMoneyLimit
          ? decision.incomeThresholdBelowRange : decision.incomeThresholdRange;
        else {
          const neededIncome = threshold.incomeToApply;
          const change = neededIncome - value("incomePerPeriod");
          // Lower tolerance is rounded down; required additional income is rounded up.
          // Normalize only sub-nanocent representation noise, e.g. 22 - 5.17.
          const scaled = Math.abs(change) * 100;
          const cents = Math.abs(scaled - Math.round(scaled)) <= 1e-9 ? Math.round(scaled) : scaled;
          const distance = (change > 0 ? Math.ceil(cents) : Math.floor(cents)) / 100;
          const changeText = change > 0
            ? (isRu ? `Нужно прибавить к доходу не менее ${cash(distance)} / ${perUnit}.` : `Income needs to rise by at least ${cash(distance)} / ${perUnit}.`)
            : distance > 0
              ? (isRu ? `Доход может снизиться на ${cash(distance)} / ${perUnit}.` : `Income can fall by ${cash(distance)} / ${perUnit}.`)
              : (isRu ? "Запаса на снижение дохода почти нет." : "There is almost no room for income to fall.");
          thresholdText.textContent = isRu
            ? `${changeText} Для этой проверки укажи доход не ниже ${cash(neededIncome)} / ${perUnit}. Границу задаёт период ${threshold.limitingPeriod}.`
            : `${changeText} For this check, use income of at least ${cash(neededIncome)} / ${perUnit}. Period ${threshold.limitingPeriod} sets the boundary.`;
          thresholdButton.textContent = isRu ? `Проверить доход ${cash(neededIncome)}` : `Check income of ${cash(neededIncome)}`;
          thresholdButton.dataset.income = String(neededIncome);
          thresholdButton.hidden = neededIncome === value("incomePerPeriod");
        }
        root.querySelector<HTMLElement>("[data-decision-answer]")!.textContent = cap === null
          ? (isRu ? `Даже без нового регулярного расхода этот платёж и текущие обязательства затрагивают резерв. Чтобы начать сейчас с указанным расходом, нужно ещё ${extraCash} в начальной казне либо пересмотреть платёж и обязательства.` : `Even with no added recurring outflow, this payment and existing commitments breach the reserve. Acting now with the entered costs needs ${extraCash} more initial cash, or a change to the payment and commitments.`)
          : (isRu ? `Чтобы начать сейчас и сохранить резерв на всём горизонте, новый регулярный расход должен быть не выше ${capText} / ${perUnit}.${calculated.now.firstBreachPeriod !== null ? ` При указанном расходе не хватает ${extraCash} начальной казны.` : ""}` : `To act now and preserve the reserve throughout the horizon, added recurring outflow must stay at or below ${capText} / ${perUnit}.${calculated.now.firstBreachPeriod !== null ? ` The entered outflow needs ${extraCash} more initial cash.` : ""}`);
        root.querySelectorAll<HTMLElement>("[data-decision-choice]").forEach((row) => {
          const choice = row.dataset.decisionChoice as "now" | "later" | "keep";
          const path = calculated[choice];
          row.querySelector<HTMLElement>("[data-decision-choice-name]")!.textContent = choice === "later"
            ? (isRu ? `Начать через ${calculated.delayPeriods} ${unit}` : `Start after ${calculated.delayPeriods} ${unit}`) : decision[choice];
          row.querySelector<HTMLElement>("[data-decision-choice-cash]")!.textContent = cash(path.cashAtTarget);
          const breach = row.querySelector<HTMLElement>("[data-decision-choice-breach]")!;
          breach.textContent = period(path.firstBreachPeriod);
          breach.dataset.breached = String(path.firstBreachPeriod !== null);
        });
        const change = value("incomeChange");
        const activeChange = calculated.incomeChangePeriod > 0 && calculated.incomeChangePeriod <= value("horizonPeriods");
        const changeNote = activeChange
          ? (isRu ? `Во всех трёх вариантах доход меняется на ${cash(change)} с периода ${calculated.incomeChangePeriod}.` : `Income changes by ${cash(change)} from period ${calculated.incomeChangePeriod} in all three alternatives.`)
          : (isRu ? "На выбранном горизонте доход неизменен во всех трёх вариантах." : "Income stays unchanged throughout this horizon in all three alternatives.");
        root.querySelector<HTMLElement>("[data-decision-income-note]")!.textContent = changeNote + (calculated.delayPeriods > value("horizonPeriods")
          ? (isRu ? " Отложенное действие не начинается до конечной даты." : " The postponed action does not start within the horizon.") : "");
        const body = root.querySelector<HTMLElement>("[data-decision-path]")!;
        const rows = document.createDocumentFragment();
        calculated.points.forEach((point) => {
          const row = document.createElement("tr");
          const heading = document.createElement("th"); heading.scope = "row"; heading.textContent = String(point.period); row.append(heading);
          (["now", "later", "keep"] as const).forEach((choice) => {
            const cell = document.createElement("td"); cell.textContent = cash(point[choice]);
            cell.dataset.breached = String(point[choice] < value("reserve") - 1e-8); row.append(cell);
          });
          rows.append(row);
        });
        body.replaceChildren(rows);
        return;
      }

      if (kind === "investment") {
        const calculated = calculateInvestmentMetrics({
          cost: value("cost"),
          incomePerPeriod: value("incomePerPeriod"),
          delayPeriods: value("delayPeriods"),
          horizonPeriods: value("horizonPeriods"),
          riskPercent: value("riskPercent")
        });
        metrics = { ...calculated };
        positive = calculated.netValue >= 0;
        verdict.textContent = positive
          ? (lang === "ru" ? "Инвестиция окупается в горизонте" : "Investment pays back inside the horizon")
          : (lang === "ru" ? "Горизонт короче окупаемости" : "The horizon is shorter than payback");
      } else {
        const calculated = calculateComparisonMetrics({
          aImmediate: value("aImmediate"),
          aRecurring: value("aRecurring"),
          aDelay: value("aDelay"),
          aRiskPercent: value("aRiskPercent"),
          bImmediate: value("bImmediate"),
          bRecurring: value("bRecurring"),
          bDelay: value("bDelay"),
          bRiskPercent: value("bRiskPercent"),
          horizonPeriods: value("horizonPeriods")
        });
        const winner = calculated.winner === "a"
          ? root.dataset.winnerA ?? "A"
          : calculated.winner === "b"
            ? root.dataset.winnerB ?? "B"
            : root.dataset.winnerTie ?? "Tie";
        metrics = { ...calculated, winner };
        verdict.textContent = winner;
      }

      resultPanel.dataset.state = positive ? "positive" : "negative";
      outputs.forEach((output) => {
        const key = output.dataset.modelOutput ?? "";
        const metric = metrics[key];
        output.textContent = typeof metric === "string" ? metric : format(Number(metric ?? 0), output.dataset.outputFormat ?? "number");
      });
    };

    inputs.forEach((input) => input.addEventListener("input", render));
    root.querySelector<HTMLButtonElement>("[data-decision-income-apply]")?.addEventListener("click", (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const income = inputs.find((input) => input.dataset.modelInput === "incomePerPeriod");
      if (button.hidden || !button.dataset.income || !income) return;
      income.value = button.dataset.income;
      income.dispatchEvent(new Event("input", { bubbles: true }));
      income.dispatchEvent(new Event("change", { bubbles: true }));
      income.focus();
    });
    reset.addEventListener("click", () => {
      inputs.forEach((input) => { input.value = baselines.get(input.dataset.modelInput ?? "") ?? "0"; });
      render();
    });
    render();
  });
</script>
