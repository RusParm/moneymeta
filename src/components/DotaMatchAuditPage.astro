  purchasesText: "Компоненты и мелкие расходники скрыты. Для текущего патча доступно сравнение с первыми покупками профессиональной выборки.",
  boughtAt: "куплен на",
  minuteShort: "мин",
  cost: "цена",
  proMedian: "профмедиана",
  sample: "покупок",
  noBenchmark: "Надёжного сравнения для этой роли и версии нет",
  inspectItem: "Открыть предмет",
  noPurchases: "OpenDota не вернул крупные завершённые покупки из текущего каталога.",
  nextKicker: "ОДНО ПРАВИЛО",
  nextTitle: "Что перенести в следующий матч",
  copyRule: "Скопировать правило",
  ruleCopied: "Правило скопировано",
  plan: "Переиграть порядок предметов",
  methodKicker: "Границы разбора",
  methodTitle: "Наблюдение, не приговор",
  methods: [
    ["01", "Только явный запрос", "Страница ничего не загружает по Match ID до нажатия кнопки. Запрос идёт напрямую в OpenDota с отключённой отправкой cookies."],
    ["02", "Минимум данных", "После ответа остаются только игровые числа, номер героя и позиция игрока. Имена, идентификаторы аккаунтов, чат и остальные поля отбрасываются."],
    ["03", "Сравнимая версия", `Профессиональные тайминги показываются только для семейства ${dotaItemsSnapshot.patch.family} и при выборке не меньше ${dotaItemsSnapshot.methodology.minimumSample} покупок.`],
    ["04", "Один матч", "Драфт, карта и командная задача не восстанавливаются из финансовой хронологии. Итог должен изменить один вопрос следующего реплея, а не объявить игрока хорошим или плохим."]
  ],
  sources: "Источники и проверка",
  sourceText: `Контракт API и CORS проверены ${dotaMatchAuditConfig.checkedAt}. Hero ID берутся из OpenDota constants, предметы и профтайминги из снимка Money Meta по патчу ${dotaItemsSnapshot.patch.label}.`,
  source: "Открыть источник",
  loading: "Запрашиваем публичный матч напрямую у OpenDota...",
  invalid: "Не удалось распознать Match ID. Вставь только число или обычную ссылку на страницу матча.",
  notFound: "OpenDota не нашёл этот публичный матч. Проверь ID и видимость истории матчей.",
  rateLimited: "Лимит OpenDota для этого подключения исчерпан. Подожди немного и повтори запрос.",
  timeout: "OpenDota не ответил вовремя. Ничего не сохранено, можно повторить запрос.",
  failed: "Матч сейчас не загрузился. Проверь соединение или открой его напрямую в OpenDota.",
  malformed: "Провайдер вернул неполный или неожиданный ответ. Money Meta остановил разбор вместо догадки.",
  mismatch: "ID в ответе не совпал с запросом. Разбор остановлен.",
  choose: "Выбери героя, чтобы открыть разбор.",
  goldUnit: "золота"
} : {
  title: "Dota 2 match economy audit by Match ID | Money Meta",
  description: "Paste a public Dota 2 Match ID, choose a hero and audit gold pace, key purchases, buybacks and current pro timing deviations.",
  back: "← Dota 2 portal",
  kicker: "Dota 2 · one real match",
  heading: "Paste a Match ID. Find the economy fork.",
  lede: "This is not another KDA grade. Money Meta connects gold pace, checkpoints, major purchases and buybacks in one short audit. The output is one replay question and one rule for the next match.",
  inputLabel: "Match ID or match URL",
  inputPlaceholder: "For example, 8978544633",
  inputHelp: "Use the numeric ID or a normal OpenDota, Dotabuff or Stratz match link.",
  load: "Audit match",
  demo: "Run the public demo",
  demoNote: `Pro match ${dotaMatchAuditConfig.demoMatchId}, checked ${dotaMatchAuditConfig.demoCheckedAt}`,
  boundaryTitle: "Before the request",
  boundaryText: "Only after the button is pressed, Money Meta sends the entered ID directly to OpenDota. The provider receives ordinary web request data, including IP and page origin. We do not request Steam sign-in, read the game client or files, or submit a replay parse request.",
