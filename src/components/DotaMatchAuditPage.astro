---
import { dotaHeroes, dotaHeroSnapshot } from "../data/dota-heroes";
import { dotaMatchAuditConfig, getDotaMatchAuditPath } from "../data/dota-match";
import {
  dotaItems,
  dotaItemsSnapshot,
  getDotaItemPath,
  getDotaItemPlannerPath,
  type DotaItemsLocale
} from "../data/dota-items";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "./BrandHeader.astro";
import DotaItemNav from "./DotaItemNav.astro";
import DotaItemsStatus from "./DotaItemsStatus.astro";
import SiteFooter from "./SiteFooter.astro";
import "../styles/dota-match-audit.css";

interface Props { lang: DotaItemsLocale; }
const { lang } = Astro.props;
const path = getDotaMatchAuditPath(lang);
const alternate = getDotaMatchAuditPath(lang === "ru" ? "en" : "ru");
const itemPatchSource = dotaItemsSnapshot.patch.sourceUrl;
const copy = lang === "ru" ? {
  title: "Разбор экономики матча Dota 2 по Match ID | Money Meta",
  description: "Вставь публичный Match ID Dota 2, выбери героя и разбери темп золота, ключевые покупки, выкупы и отклонения от текущих профессиональных таймингов.",
  back: "← К порталу Dota 2",
  kicker: "Dota 2 · разбор реального матча",
  heading: "Вставь Match ID. Найди экономическую развилку.",
  lede: "Не ещё одна оценка KDA. Money Meta собирает темп золота, контрольные точки, крупные покупки и выкупы в один короткий разбор. Итогом становится один вопрос для реплея и одно правило на следующий матч.",
  inputLabel: "Match ID или ссылка на матч",
  inputPlaceholder: "Например, 8978544633",
  inputHelp: "Подойдёт числовой ID или обычная ссылка OpenDota, Dotabuff либо Stratz.",
  load: "Разобрать матч",
  demo: "Запустить публичное демо",
  demoNote: `Профматч ${dotaMatchAuditConfig.demoMatchId}, проверен ${dotaMatchAuditConfig.demoCheckedAt}`,
  boundaryTitle: "Перед запросом",
  boundaryText: "Только после нажатия Money Meta отправит указанный ID напрямую в OpenDota. Провайдер получит обычные данные веб-запроса, включая IP и адрес страницы. Мы не просим Steam-вход, не читаем клиент или файлы и не отправляем запрос на парсинг реплея.",
  sent: "Уйдёт",
  sentValue: "Match ID · GET-запрос",
  notSent: "Не уйдёт",
  notSentValue: "Steam-вход · файлы · локальные сценарии",
