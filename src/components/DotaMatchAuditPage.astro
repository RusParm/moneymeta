const payload = JSON.stringify({
  lang,
  copy,
  config: dotaMatchAuditConfig,
  patch: { id: dotaMatchAuditConfig.currentPatchId, label: dotaItemsSnapshot.patch.label, minimumSample: dotaItemsSnapshot.methodology.minimumSample },
  heroes: dotaHeroes,
  matchItems: dotaMatchItems,
  items: dotaItems.map((item) => ({
    ...item,
    image: dotaMatchItems.find((reference) => reference.id === item.id)?.image ?? item.image,
    attributes: [],
    abilities: [],
    components: []
  })),
  itemPaths: Object.fromEntries(dotaItems.map((item) => [item.key, getDotaItemPath(item, lang)])),
  plannerPath: getDotaItemPlannerPath(lang)
}).replace(/</gu, "\\u003c");
---

<BaseLayout title={copy.title} description={copy.description} lang={lang} canonicalPath={path} alternatePath={alternate}>
  <main class="page dota-items-page dota-match-audit" data-dota-match-audit>
    <div class="shell">
      <BrandHeader lang={lang} ruPath={getDotaMatchAuditPath("ru")} enPath={getDotaMatchAuditPath("en")} backPath={lang === "ru" ? "/dota-2/" : "/en/dota-2/"} backLabel={copy.back} />

      <header class="match-audit-hero">
        <div class="match-audit-hero-copy">
          <p class="eyebrow">{copy.kicker}</p>
          <h1>{copy.heading}</h1>
          <p>{copy.lede}</p>
        </div>
      </header>

      <DotaItemNav lang={lang} active="audit" />

      <section id="match-audit-console" class="match-audit-console" aria-labelledby="match-audit-input-title">
        <nav class="match-audit-steps" aria-label={lang === "ru" ? "Шаги разбора" : "Audit steps"}>
          {copy.steps.map((step, index) => <span class:list={{ "is-active": index === 0 }} data-audit-step={index + 1}>{step}</span>)}
        </nav>

        <div class="match-audit-input-stage">
          <form class="match-audit-form" data-match-form>
            <div>
              <label id="match-audit-input-title" for="match-audit-id">{copy.inputLabel}</label>
              <div class="match-audit-field-row">
                <input id="match-audit-id" name="match" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" placeholder={copy.inputPlaceholder} data-match-input />
                <button class="button primary" type="submit" data-match-submit>{copy.load} →</button>
              </div>
              <p>{copy.inputHelp}</p>
            </div>
            <button class="match-audit-demo" type="button" data-match-demo><span>DEMO</span><strong>{copy.demo}</strong><small>{copy.demoNote}</small></button>
          </form>

          <details class="match-audit-boundary">
            <summary>{copy.boundaryTitle}</summary>
            <p>{copy.boundaryText}</p>
            <dl>
              <div><dt>{copy.sent}</dt><dd>{copy.sentValue}</dd></div>
              <div><dt>{copy.notSent}</dt><dd>{copy.notSentValue}</dd></div>
              <div><dt>{copy.retention}</dt><dd>{copy.retentionValue}</dd></div>
            </dl>
          </details>
        </div>

        <div class="match-audit-status" data-match-status role="status" aria-live="polite" hidden></div>

        <section class="match-audit-selection" data-match-selection hidden aria-labelledby="match-player-title">
          <header>
            <div><span data-match-badge></span><h2 id="match-player-title">{copy.selectTitle}</h2><p>{copy.selectText}</p></div>
            <dl>
              <div><dt>{copy.match}</dt><dd data-match-id></dd></div>
              <div><dt>{copy.duration}</dt><dd data-match-duration></dd></div>
              <div><dt>{copy.played}</dt><dd data-match-date></dd></div>
              <div><dt>{copy.winner}</dt><dd data-match-winner></dd></div>
            </dl>
          </header>
          <div class="match-team-grid">
            <section aria-labelledby="radiant-team-title"><h3 id="radiant-team-title"><span>R</span>{copy.radiant}</h3><div data-team="radiant"></div></section>
            <section aria-labelledby="dire-team-title"><h3 id="dire-team-title"><span>D</span>{copy.dire}</h3><div data-team="dire"></div></section>
          </div>
          <p class="match-audit-choose" data-match-choose>{copy.choose}</p>
        </section>

        <aside class="match-recovery" data-match-recovery hidden>
          <div><h3>{copy.recoveryTitle}</h3><p>{copy.recoveryText}</p></div>
          <div class="match-recovery-actions">
            <button type="button" class="button primary" data-request-replay>{copy.recoveryRequest}</button>
            <button type="button" class="button ghost" data-refresh-replay>{copy.recoveryRefresh}</button>
            <button type="button" class="mini-action" data-stop-replay hidden>{copy.recoveryStop}</button>
            <a class="mini-action" data-recovery-provider href={dotaMatchAuditConfig.publicMatchBase} target="_blank" rel="noopener noreferrer">{copy.openProvider} ↗</a>
          </div>
          <p data-recovery-status role="status" aria-live="polite"></p>
        </aside>

        <section class="match-audit-result" data-audit-result hidden aria-labelledby="match-audit-result-title">
          <header class="match-audit-result-head">
            <div class="match-audit-player-title">
              <span class="match-audit-selected-portrait is-fallback"><b data-selected-fallback>?</b><img data-selected-image src="" alt="" width="160" height="90" /></span>
              <div><span>{copy.auditKicker}</span><h2 id="match-audit-result-title" data-selected-name>{copy.auditTitle}</h2><p data-selected-position></p></div>
            </div>
            <div class="match-audit-result-actions">
              <label for="match-audit-role"><span>{copy.roleLabel}</span><select id="match-audit-role" data-match-role><option value="unknown">{copy.roleUnknown}</option><option value="core">{copy.core}</option><option value="support">{copy.support}</option></select></label>
              <div><button type="button" class="mini-action" data-match-share>{copy.share}</button><a class="mini-action" href="#" target="_blank" rel="noopener noreferrer" data-provider-link>{copy.openProvider} ↗</a></div>
              <small>{copy.roleNote}</small>
              <p data-share-status role="status" aria-live="polite"></p>
            </div>
          </header>

          <div class="match-comparison-control">
            <label for="match-audit-opponent">{copy.compareLabel}</label>
            <select id="match-audit-opponent" data-match-opponent aria-describedby="match-comparison-help"><option value="auto">{copy.compareAuto}</option></select>
            <p id="match-comparison-help">{copy.compareHelp}</p>
          </div>
          <div class="match-result-tabs" role="tablist" aria-label={copy.tabsLabel}>
            {[['summary', copy.tabSummary], ['draft', copy.tabDraft], ['gold', copy.tabGold], ['items', copy.tabItems]].map(([key, label], index) => <button type="button" id={`match-tab-${key}`} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`match-panel-${key}`} tabindex={index === 0 ? 0 : -1} data-result-tab={key}>{label}</button>)}
          </div>
          <section id="match-panel-summary" role="tabpanel" aria-labelledby="match-tab-summary" tabindex="0" data-result-panel="summary">
          <aside class="match-draft-summary" data-draft-summary hidden>
            <div><strong>{copy.tabDraft}</strong><p data-draft-summary-text></p></div>
            <button type="button" class="button ghost" data-open-draft>{lang === "ru" ? "Разобрать возможности команд" : "Review both lineups"} →</button>
          </aside>
          <article class="match-audit-signal" data-audit-signal>
            <span>{copy.signal}</span>
            <strong data-signal-title></strong>
            <p data-signal-text></p>
          </article>

          <DotaMatchFinalReview lang={lang} />

          <section class="match-economic-autopsy" data-economic-autopsy aria-labelledby="economic-autopsy-title">
            <header class="match-economic-autopsy-head">
              <div><span class="section-kicker">{copy.autopsyKicker}</span><h3 id="economic-autopsy-title">{copy.autopsyTitle}</h3><p>{copy.autopsyText}</p></div>
              <div class="match-economic-confidence"><span>{copy.confidence}</span><strong data-economic-confidence></strong><small data-economic-coverage></small></div>
            </header>

            <div class="match-economic-opponent" data-economic-opponent></div>
            <div class="match-economic-verdicts" data-economic-verdicts></div>

            <aside class="match-economic-final-only" data-economic-final-only hidden></aside>

            <section class="match-replay-focus" data-replay-focus aria-labelledby="match-focus-title">
              <header><div><span class="section-kicker">{copy.replayKicker}</span><h4 id="match-focus-title">{copy.focusTitle}</h4></div><strong data-economic-replay-window></strong></header>
              <p data-focus-explanation></p>
              <div class="match-focus-columns">
                <div><h5>{copy.focusFacts}</h5><dl data-focus-facts></dl><details class="match-focus-other" data-focus-other hidden><summary>{copy.focusOtherPurchases}</summary><div data-focus-purchases></div></details></div>
                <div class="match-focus-question"><h5>{copy.focusQuestion}</h5><p data-focus-question></p><ol data-economic-replay-checks></ol><button class="mini-action" type="button" data-copy-focus>{copy.focusCopy}</button><p data-focus-copy-status role="status" aria-live="polite"></p></div>
              </div>
              <div class="match-episode-context" data-episode-context hidden></div>
            </section>
            <details class="match-economic-explanation"><summary>{copy.priceTitle}</summary>
              <article class="match-economic-price">
                <span>{copy.priceKicker}</span>
                <h4>{copy.priceTitle}</h4>
                <dl data-economic-price></dl>
                <p>{copy.priceNote}</p>
              </article>
            </details>

            <p class="match-economic-threshold" data-economic-boundary></p>
          </section>

          <section class="match-audit-next" aria-labelledby="match-next-title">
            <div><span>{copy.nextKicker}</span><h3 id="match-next-title">{copy.nextTitle}</h3></div>
            <blockquote data-next-rule></blockquote>
            <div><button type="button" class="button primary" data-copy-rule>{copy.copyRule}</button><a class="button ghost" data-plan-link href={getDotaItemPlannerPath(lang)}>{copy.plan} →</a></div>
            <p data-rule-status role="status" aria-live="polite"></p>
          </section>
          </section>
          <section id="match-panel-draft" role="tabpanel" aria-labelledby="match-tab-draft" tabindex="0" data-result-panel="draft" hidden>
            <div data-draft-review></div>
          </section>
          <section id="match-panel-gold" role="tabpanel" aria-labelledby="match-tab-gold" tabindex="0" data-result-panel="gold" hidden>
          <section class="match-audit-trajectory" data-trajectory aria-labelledby="match-chart-title">
            <header><div><span>{copy.chartKicker}</span><h3 id="match-chart-title" data-chart-title>{copy.chartTitle}</h3><p data-chart-text>{copy.chartText}</p><div class="match-audit-chart-series" data-chart-series></div></div><strong data-chart-total></strong></header>
            <div class="match-audit-chart-wrap"><svg data-audit-chart viewBox="0 0 900 320" role="img" aria-label={copy.chartAria}></svg></div>
            <div class="match-audit-chart-legend" data-chart-legend hidden></div>
          </section>

          <aside class="match-audit-no-timeline" data-no-timeline hidden>
            <span>FINAL ONLY</span><div><h3>{copy.noTimelineTitle}</h3><p>{copy.noTimelineText}</p></div>
          </aside>

          <section class="match-audit-checkpoints" data-checkpoint-section aria-labelledby="match-checkpoints-title">
            <header><div><span class="section-kicker">0:00 → GG</span><h3 id="match-checkpoints-title">{copy.checkpoints}</h3><p>{copy.checkpointsText}</p></div></header>
            <div data-audit-checkpoints></div>
          </section>

            <section class="match-economic-phases" data-economic-phases aria-labelledby="economic-phases-title">
              <header><div><span class="section-kicker">0:00 → GG</span><h4 id="economic-phases-title">{copy.phaseTitle}</h4><p>{copy.phaseText}</p></div></header>
              <div class="match-economic-table-wrap" data-economic-table></div>
            </section>

          </section>
          <section id="match-panel-items" role="tabpanel" aria-labelledby="match-tab-items" tabindex="0" data-result-panel="items" hidden>
            <DotaItemsStatus lang={lang} compact />
          <section class="match-audit-overview" aria-labelledby="match-overview-title">
            <h3 id="match-overview-title">{copy.overview}</h3>
            <div data-audit-stats></div>
          </section>

          <section class="match-audit-inventory" aria-labelledby="match-inventory-title">
            <header><div><span class="section-kicker">{copy.inventoryKicker}</span><h3 id="match-inventory-title">{copy.inventory}</h3><p>{copy.inventoryText}</p></div></header>
            <div data-audit-inventory></div>
            <p class="match-audit-empty" data-no-inventory hidden>{copy.noInventory}</p>
          </section>

          <section class="match-audit-purchases" aria-labelledby="match-purchases-title">
            <header><div><span class="section-kicker">PURCHASE LOG</span><h3 id="match-purchases-title">{copy.purchases}</h3><p>{copy.purchasesText}</p></div></header>
            <div data-audit-purchases></div>
            <p class="match-audit-empty" data-no-purchases hidden></p>
          </section>

          </section>
        </section>
      </section>

      <details class="section match-audit-method">
        <summary>{copy.methodToggle}</summary>
        <div class="section-head"><div><span class="section-kicker">{copy.methodKicker}</span><h2 id="match-method-title">{copy.methodTitle}</h2></div><span class="count">PUBLIC ID · NO LOGIN · NO STORE</span></div>
        <div class="match-audit-method-grid">{copy.methods.map(([code, title, text]) => <article><span>{code}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
        <aside class="match-audit-sources"><div><span>{copy.sources}</span><p>{copy.sourceText}</p></div><nav><a href={dotaMatchAuditConfig.docsUrl} target="_blank" rel="noopener noreferrer">OpenDota API · {copy.source} ↗</a><a href={dotaHeroSnapshot.sourceUrl} target="_blank" rel="noopener noreferrer">Hero constants · {copy.source} ↗</a><a href={dotaMatchItemSnapshot.sourceUrl} target="_blank" rel="noopener noreferrer">Item constants · {copy.source} ↗</a><a href={itemPatchSource} target="_blank" rel="noopener noreferrer">Valve · Patch {dotaItemsSnapshot.patch.label} ↗</a></nav></aside>
      </details>

      <SiteFooter lang={lang} />
    </div>
    <script is:inline type="application/json" data-match-audit-data set:html={payload} />
  </main>
</BaseLayout>

<script>
  import {
    buildDotaMatchAudit,
    inferredDotaMatchRole,
    parseDotaMatchId,
    parseDotaPlayerSlot,
    hasDotaMatchTimeline,
    resolveDotaMatchInventory,
    sanitizeDotaMatchResponse,
    type DotaEconomicWindow,
    type DotaMatch,
    type DotaMatchAudit,
    type DotaMatchPlayer,
    type DotaMatchRole
  } from "../lib/dota-match";
  import type { DotaMatchItemReference } from "../data/dota-match-items";
  import type { DotaItemRecord } from "../lib/dota-items";
  import { buildDotaFinalReview } from "../lib/dota-match-summary";
  import { dotaReviewMessage, renderDotaFinalReview } from "../lib/dota-match-review-ui";
  import { canReplaceDotaMatch, DotaMatchRecovery, type DotaRecoveryState } from "../lib/dota-match-recovery";
  import { buildDotaDraftReview, type DotaDraftReview } from "../lib/dota-draft";
  import { renderDotaDraftReview } from "../lib/dota-draft-review-ui";
  import { buildDotaEpisodeContext, selectDotaEpisodeOtherPurchases } from "../lib/dota-episode-context";
  import { buildDotaEpisodeNote, renderDotaEpisodeContext } from "../lib/dota-episode-context-ui";

  const root = document.querySelector<HTMLElement>("[data-dota-match-audit]");
  if (root) {
    const auditRoot = root;
    const data = JSON.parse(root.querySelector("[data-match-audit-data]")?.textContent ?? "{}");
    const copy: Record<string, string> = data.copy;
    let currentFocusNote = "";
    const lang: "ru" | "en" = data.lang;
    const items: DotaItemRecord[] = data.items;
    const matchItems: DotaMatchItemReference[] = data.matchItems;
    const heroes = new Map<number, { id: number; key: string; name: string; image: string }>(data.heroes.map((hero: { id: number; key: string; name: string; image: string }) => [hero.id, hero]));
    const itemPaths: Record<string, string> = data.itemPaths;
    const number = new Intl.NumberFormat(lang === "ru" ? "ru-RU" : "en-US", { maximumFractionDigits: 1 });
    const integer = new Intl.NumberFormat(lang === "ru" ? "ru-RU" : "en-US", { maximumFractionDigits: 0 });
    const date = new Intl.DateTimeFormat(lang === "ru" ? "ru-RU" : "en-US", { dateStyle: "medium", timeStyle: "short" });
    const form = root.querySelector<HTMLFormElement>("[data-match-form]")!;
    const input = root.querySelector<HTMLInputElement>("[data-match-input]")!;
    const submit = root.querySelector<HTMLButtonElement>("[data-match-submit]")!;
    const demo = root.querySelector<HTMLButtonElement>("[data-match-demo]")!;
    const status = root.querySelector<HTMLElement>("[data-match-status]")!;
    const selection = root.querySelector<HTMLElement>("[data-match-selection]")!;
    const result = root.querySelector<HTMLElement>("[data-audit-result]")!;
    const roleControl = root.querySelector<HTMLSelectElement>("[data-match-role]")!;
    const opponentControl = root.querySelector<HTMLSelectElement>("[data-match-opponent]")!;
    const params = new URL(window.location.href).searchParams;
    const sharedMatch = params.get("match");
    if (sharedMatch && parseDotaMatchId(sharedMatch)) input.value = sharedMatch;

    let currentMatch: DotaMatch | null = null;
    let currentSlot: number | null = null;
    let currentRule = "";
    const pendingSlot = parseDotaPlayerSlot(params.get("slot"));
    const pendingOpponent = parseDotaPlayerSlot(params.get("opponent"));
    const pendingRole = params.get("role") === "support" ? "support" : params.get("role") === "core" ? "core" : null;

    const setStatus = (message: string, state: "loading" | "error" | "success" = "error") => {
      status.hidden = !message;
      status.textContent = message;
      status.dataset.state = state;
    };
    const setStep = (step: number) => root.querySelectorAll<HTMLElement>("[data-audit-step]").forEach((node) => node.classList.toggle("is-active", Number(node.dataset.auditStep) <= step));
    const value = (inputValue: number | null, suffix = "") => inputValue === null ? copy.unavailable! : `${integer.format(inputValue)}${suffix}`;
    const heroFor = (heroId: number) => heroes.get(heroId) ?? { id: heroId, key: "unknown", name: `Hero #${heroId}`, image: "" };
    const outcome = (player: DotaMatchPlayer) => player.won === null ? copy.unknownResult! : player.won ? copy.victory! : copy.defeat!;
    const positionLabel = (player: DotaMatchPlayer) => {
      if (player.positionEstimate) return `${copy.position} ${player.positionEstimate}`;
      if (player.isRoaming) return copy.roaming!;
      const lanes: Record<number, string> = { 1: copy.safeLane!, 2: copy.midLane!, 3: copy.offLane!, 4: copy.jungle! };
      return player.laneRole ? lanes[player.laneRole] ?? copy.positionUnknown! : copy.positionUnknown!;
    };
    const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    };
    const initials = (label: string) => label.split(/\s+/u).filter(Boolean).slice(0, 2).map((word) => word[0]).join("").toUpperCase() || "?";
    const media = (className: string, label: string, imageUrl: string) => {
      const frame = make("span", `${className} is-fallback`);
      frame.setAttribute("aria-hidden", "true");
      frame.append(make("b", "", initials(label)));
      if (imageUrl) {
        const image = document.createElement("img");
        image.alt = "";
        image.width = 128;
        image.height = 72;
        image.loading = "lazy";
        image.decoding = "async";
        image.referrerPolicy = "no-referrer";
        image.addEventListener("load", () => frame.classList.remove("is-fallback"), { once: true });
        image.addEventListener("error", () => { frame.classList.add("is-fallback"); image.remove(); }, { once: true });
        image.src = imageUrl;
        frame.append(image);
      }
      return frame;
    };

    const renderPlayer = (player: DotaMatchPlayer) => {
      const hero = heroFor(player.heroId);
      const button = make("button", "match-audit-player");
      button.type = "button";
      button.dataset.playerSlot = String(player.playerSlot);
      button.setAttribute("aria-pressed", "false");
      const portrait = media("match-audit-player-portrait", hero.name, hero.image);
      const body = make("span", "match-audit-player-body");
      body.append(make("small", "", positionLabel(player)));
      body.append(make("strong", "", hero.name));
      body.append(make("span", "", `${value(player.kills)} / ${value(player.deaths)} / ${value(player.assists)} · ${value(player.goldPerMinute)} GPM`));
      const resultLabel = make("span", player.won ? "match-audit-outcome is-win" : "match-audit-outcome", outcome(player));
      button.append(portrait, body, resultLabel);
      button.addEventListener("click", () => {
        selectPlayer(player.playerSlot);
        result.tabIndex = -1;
        result.focus({ preventScroll: true });
        result.scrollIntoView({ block: "start", behavior: "instant" });
      });
      return button;
    };

    const renderMatch = (match: DotaMatch) => {
      currentMatch = match;
      currentSlot = null;
      result.hidden = true;
      selection.hidden = false;
      setStep(2);
      root.querySelector<HTMLElement>("[data-match-id]")!.textContent = String(match.matchId);
      root.querySelector<HTMLElement>("[data-match-duration]")!.textContent = `${number.format(match.durationSeconds / 60)} ${copy.minuteShort}`;
      root.querySelector<HTMLElement>("[data-match-date]")!.textContent = date.format(new Date(match.startTime * 1000));
      root.querySelector<HTMLElement>("[data-match-winner]")!.textContent = match.radiantWin === null ? copy.unknownResult! : match.radiantWin ? copy.radiant! : copy.dire!;
      root.querySelector<HTMLAnchorElement>("[data-provider-link]")!.href = `${data.config.publicMatchBase}/${match.matchId}`;
      const hasAnyTimeline = match.players.some(hasDotaMatchTimeline);
      const badge = root.querySelector<HTMLElement>("[data-match-badge]")!;
      badge.textContent = `${hasAnyTimeline ? copy.fullTimeline : copy.finalOnly} · ${match.patchId === data.patch.id ? copy.patchCurrent : copy.patchArchive}`;
      badge.dataset.state = hasAnyTimeline ? "parsed" : "final";
      const radiant = root.querySelector<HTMLElement>('[data-team="radiant"]')!;
      const dire = root.querySelector<HTMLElement>('[data-team="dire"]')!;
      radiant.replaceChildren(...match.players.filter((player) => player.isRadiant).map(renderPlayer));
      dire.replaceChildren(...match.players.filter((player) => !player.isRadiant).map(renderPlayer));
      root.querySelector<HTMLElement>("[data-match-choose]")!.hidden = false;
      const sharedPlayer = String(match.matchId) === sharedMatch ? match.players.find((player) => player.playerSlot === pendingSlot) : undefined;
      if (sharedPlayer) selectPlayer(sharedPlayer.playerSlot, pendingRole ?? undefined, pendingOpponent);
      syncAuditLanguageLinks();
      updateRecoveryControls();
    };

    const renderStats = (audit: DotaMatchAudit) => {
      const player = audit.player;
      const rows = [
        [outcome(player), `${value(player.kills)} / ${value(player.deaths)} / ${value(player.assists)}`],
        [copy.gpm!, value(player.goldPerMinute)],
        [copy.netWorth!, value(player.netWorth, ` ${copy.goldUnit}`)],
        [copy.goldSpent!, value(player.goldSpent, ` ${copy.goldUnit}`)],
        [copy.lastHits!, `${value(player.lastHits)} · ${value(player.denies)} ${copy.denies}`],
        [copy.deaths!, `${value(player.deaths)} · ${value(player.buybackCount)} ${copy.buybacks}`]
      ];
      root.querySelector<HTMLElement>("[data-audit-stats]")!.replaceChildren(...rows.map(([label, stat]) => {
        const card = make("div");
        card.append(make("span", "", label), make("strong", "", stat));
        return card;
      }));
    };

    const renderInventory = (audit: DotaMatchAudit) => {
      const container = root.querySelector<HTMLElement>("[data-audit-inventory]")!;
      const empty = root.querySelector<HTMLElement>("[data-no-inventory]")!;
      const inventory = resolveDotaMatchInventory(audit.player, matchItems);
      empty.hidden = inventory.length > 0;
      if (!inventory.length) {
        container.replaceChildren();
        return;
      }
      const bySlot = new Map(inventory.map((entry) => [`${entry.area}:${entry.slot}`, entry]));
      const areas = [
        { key: "main", count: 6, label: copy.mainInventory! },
        { key: "backpack", count: 3, label: copy.backpackInventory! },
        { key: "neutral", count: 2, label: copy.neutralInventory! }
      ] as const;
      const groups = areas.flatMap((area) => {
        const hasItem = inventory.some((entry) => entry.area === area.key);
        if (!hasItem) return [];
        const group = make("section", `match-inventory-group is-${area.key}`);
        group.append(make("h4", "", area.label));
        const slots = make("div", "match-inventory-slots");
        for (let slot = 0; slot < area.count; slot += 1) {
          const entry = bySlot.get(`${area.key}:${slot}`);
          const card = make("article", entry ? "match-inventory-item" : "match-inventory-item is-empty");
          if (!entry) {
            card.append(make("span", "match-inventory-empty-icon", String(slot + 1)));
            const emptyBody = make("div", "match-inventory-copy");
            emptyBody.append(make("small", "", `${copy.slot} ${slot + 1}`), make("strong", "", copy.emptySlot));
            card.append(emptyBody);
          } else {
            const label = entry.item?.name ?? `${copy.unknownItem} #${entry.itemId}`;
            const content = entry.item && itemPaths[entry.item.key] ? make("a", "match-inventory-content") : make("div", "match-inventory-content");
            if (content instanceof HTMLAnchorElement && entry.item) content.href = itemPaths[entry.item.key]!;
            content.append(media("match-inventory-image", label, entry.item?.image ?? ""));
            const body = make("span", "match-inventory-copy");
            body.append(make("small", "", `${copy.slot} ${slot + 1}`), make("strong", "", label));
            content.append(body);
            card.append(content);
          }
          slots.append(card);
        }
        group.append(slots);
        return [group];
      });
      container.replaceChildren(...groups);
    };

    const signedGold = (amount: number | null) => amount === null
      ? copy.unavailableShort!
      : `${amount > 0 ? "+" : ""}${integer.format(amount)} ${copy.goldUnit}`;
    const windowLabel = (window: Pick<DotaEconomicWindow, "startMinute" | "endMinute">) => `${number.format(window.startMinute)}-${number.format(window.endMinute)} ${copy.minuteShort}`;
    const gapState = (gap: number | null) => gap === null
      ? copy.unavailableShort!
      : gap > 500 ? copy.ahead! : gap < -500 ? copy.behind! : copy.even!;
    const kindLabel = (kind: DotaEconomicWindow["kind"]) => ({
      personal: copy.personalPattern!,
      team: copy.teamPattern!,
      mixed: copy.mixedPattern!,
      unavailable: copy.dataMissing!,
      stable: copy.stablePattern!
    })[kind];

    const renderSignal = (audit: DotaMatchAudit) => {
      const title = root.querySelector<HTMLElement>("[data-signal-title]")!;
      const text = root.querySelector<HTMLElement>("[data-signal-text]")!;
      const economy = audit.economy;
      const critical = economy.criticalWindow;
      const focus = economy.replayFocus ?? critical;
      const opponent = economy.counterpart ? heroFor(economy.counterpart.heroId) : null;
      if (critical && focus) {
        const individual = critical.kind !== "team" && focus.roleGapChange !== null && opponent;
        title.textContent = individual
          ? (lang === "ru" ? `${windowLabel(focus)}: ${opponent.name} набрал на ${integer.format(Math.max(0, -focus.roleGapChange!))} золота больше`
            : `${windowLabel(focus)}: ${opponent.name} gained ${integer.format(Math.max(0, -focus.roleGapChange!))} more gold`)
          : (lang === "ru" ? `${windowLabel(focus)}: разрыв команд ухудшился на ${integer.format(Math.max(0, -(focus.teamGapChange ?? 0)))} золота`
            : `${windowLabel(focus)}: the team gap worsened by ${integer.format(Math.max(0, -(focus.teamGapChange ?? 0))) } gold`);
        text.textContent = lang === "ru"
          ? `За всю фазу ${windowLabel(critical)}: разрыв с соперником ${signedGold(critical.roleGapChange)}, разрыв команд ${signedGold(critical.teamGapChange)}. ${critical.kind === "mixed" ? "Оба разрыва ухудшились одновременно." : critical.kind === "team" ? "Сигнал виден на уровне команды." : "Сигнал виден в сравнении двух героев."} Причину проверяем в реплее.`
          : `Across the full ${windowLabel(critical)} phase: opponent gap ${signedGold(critical.roleGapChange)}, team gap ${signedGold(critical.teamGapChange)}. ${critical.kind === "mixed" ? "Both gaps declined together." : critical.kind === "team" ? "The signal is at team level." : "The signal comes from comparing the two heroes."} Verify the cause in the replay.`;
        currentRule = lang === "ru"
          ? `Начни с ${windowLabel(focus)}. Сопоставь доступный фарм, перемещения и цели с возможностями составов. Проверь, какие варианты были у команды в этой фазе и что она получила за свои действия.`
          : `Start at ${windowLabel(focus)}. Compare available farm, movement and objectives with the lineups' capabilities. Review the options your team had in this phase and what its decisions achieved.`;
      } else if (!economy.windows.length) {
        const review = buildDotaFinalReview(currentMatch!, audit.player, roleControl.value === "unknown" ? null : audit.role, economy.counterpart);
        const message = dotaReviewMessage(review, review.findings[0], lang, opponent?.name ?? "");
        title.textContent = message.title;
        text.textContent = message.evidence;
        currentRule = message.action;
      } else if (economy.windows.every((window) => window.kind === "unavailable")) {
        title.textContent = copy.dataMissingTitle!;
        text.textContent = copy.dataMissingText!;
        currentRule = copy.compareHelp!;
      } else {
        title.textContent = lang === "ru" ? "На проверенных отрезках порог не пересечён" : "No threshold crossed in the observed intervals";
        text.textContent = copy.dataPartial!;
        const purchase = audit.majorPurchases[0];
        currentRule = purchase
          ? (lang === "ru" ? `Открой ${purchase.name} на ${number.format(purchase.minute)} мин. Проверь, был ли предмет доставлен и применён, а затем посмотри на действия команды в следующие три минуты.`
            : `Inspect ${purchase.name} at ${number.format(purchase.minute)} min. Check whether the item was delivered and used, then review the team's actions over the next three minutes.`)
          : copy.reviewSignalText!;
      }
      root.querySelector<HTMLElement>("[data-next-rule]")!.textContent = currentRule;
    };

    const renderEconomicAutopsy = (audit: DotaMatchAudit, draft: DotaDraftReview) => {
      const economy = audit.economy;
      root.querySelector<HTMLElement>("[data-economic-autopsy]")!.hidden = economy.windows.length === 0;
      const confidence = root.querySelector<HTMLElement>("[data-economic-confidence]")!;
      confidence.textContent = economy.confidence === "high"
        ? copy.confidenceHigh!
        : economy.confidence === "medium" ? copy.confidenceMedium! : copy.confidenceLow!;
      confidence.dataset.level = economy.confidence;
      root.querySelector<HTMLElement>("[data-economic-coverage]")!.textContent = `${economy.timelinePlayerCount}/${currentMatch?.players.length ?? 0} ${copy.timelineCoverage}`;

      const opponentRoot = root.querySelector<HTMLElement>("[data-economic-opponent]")!;
      if (economy.counterpart) {
        const opponent = heroFor(economy.counterpart.heroId);
        const body = make("div");
        body.append(make("span", "", copy.directOpponent), make("strong", "", opponent.name), make("small", "", economy.comparisonBasis === "manual" ? copy.compareManual : copy.comparePosition));
        opponentRoot.classList.remove("is-missing");
        opponentRoot.replaceChildren(media("match-economic-opponent-image", opponent.name, opponent.image), body);
      } else {
        opponentRoot.classList.add("is-missing");
        opponentRoot.replaceChildren(make("span", "", copy.directOpponent), make("strong", "", copy.noDirectOpponent));
      }

      const verdictCard = (code: string, title: string, main: string, detail: string, tone = "neutral") => {
        const card = make("article", `is-${tone}`);
        card.append(make("span", "", code));
        card.append(make("h4", "", title));
        card.append(make("strong", "", main));
        card.append(make("p", "", detail));
        return card;
      };
      const lane = economy.laneCheckpoint;
      const critical = economy.criticalWindow;
      const finalGap = economy.final.roleGap;
      const comparable = economy.windows.some((window) => window.kind !== "unavailable");
      const rankText = economy.final.teamRank !== null && economy.final.matchRank !== null
        ? `${economy.final.teamRank}/5 ${copy.ofTeam} · ${economy.final.matchRank}/10 ${copy.ofMatch}`
        : copy.unavailableShort!;
      const verdicts = [
        verdictCard(
          "01",
          lane ? `${copy.laneVerdict} · ${number.format(lane.minute)} ${copy.minuteShort}` : copy.laneVerdict!,
          lane ? signedGold(lane.roleGap) : copy.unavailableShort!,
          lane ? `${copy.roleGap}: ${gapState(lane.roleGap)}` : copy.dataMissing!,
          lane?.roleGap !== null && lane?.roleGap !== undefined ? (lane.roleGap > 500 ? "positive" : lane.roleGap < -500 ? "negative" : "neutral") : "neutral"
        ),
        verdictCard(
          "02",
          copy.breakVerdict!,
          critical ? windowLabel(critical) : comparable ? copy.noBreak! : copy.dataMissing!,
          critical ? `${kindLabel(critical.kind)} · ${critical.kind === "team" ? copy.teamGap : copy.roleGap}: ${signedGold(critical.kind === "team" ? critical.teamGapChange : critical.roleGapChange)}` : comparable ? copy.dataPartial! : copy.focusMissing!,
          critical?.kind ?? "stable"
        ),
        verdictCard(
          "03",
          copy.finishVerdict!,
          signedGold(finalGap),
          `${copy.netWorth} · ${copy.rank}: ${rankText}`,
          finalGap === null ? "neutral" : finalGap > 500 ? "positive" : finalGap < -500 ? "negative" : "neutral"
        )
      ];
      root.querySelector<HTMLElement>("[data-economic-verdicts]")!.replaceChildren(...verdicts);

      const phaseRoot = root.querySelector<HTMLElement>("[data-economic-phases]")!;
      const finalOnly = root.querySelector<HTMLElement>("[data-economic-final-only]")!;
      phaseRoot.hidden = economy.windows.length === 0;
      finalOnly.hidden = economy.windows.length > 0;
      if (economy.windows.length) {
        const table = make("table");
        const head = make("thead");
        const headRow = make("tr");
        [copy.phase, copy.yourPace, copy.opponentPace, copy.roleGap, copy.teamGap, copy.pattern].forEach((label) => headRow.append(make("th", "", label)));
        head.append(headRow);
        const body = make("tbody");
        economy.windows.forEach((window) => {
          const row = make("tr", `is-${window.kind}`);
          const pace = (gain: number | null, gpm: number | null) => gain === null || gpm === null
            ? copy.unavailableShort!
            : `${gain > 0 ? "+" : ""}${integer.format(gain)} · ${integer.format(gpm)} GPM`;
          const signal = make("span", `match-economic-kind is-${window.kind}`, kindLabel(window.kind));
          [
            windowLabel(window),
            pace(window.playerGoldGain, window.playerGoldPerMinute),
            pace(window.counterpartGoldGain, window.counterpartGoldPerMinute),
            signedGold(window.roleGapChange),
            signedGold(window.teamGapChange)
          ].forEach((entry) => row.append(make("td", "", entry)));
          const signalCell = make("td");
          signalCell.append(signal);
          row.append(signalCell);
          body.append(row);
        });
        table.append(head, body);
        root.querySelector<HTMLElement>("[data-economic-table]")!.replaceChildren(table);
      } else {
        const finalDetails = [
          copy.finalOnlyAutopsy!,
          `${copy.roleGap}: ${signedGold(economy.final.roleGap)}.`,
          `${copy.teamGap}: ${signedGold(economy.final.teamGap)}.`,
          `${copy.rank}: ${rankText}.`
        ];
        finalOnly.textContent = finalDetails.join(" ");
        root.querySelector<HTMLElement>("[data-economic-table]")!.replaceChildren();
      }

      const priceRows: Array<[string, string]> = [];
      if (economy.comparativeGoldSwing !== null && economy.comparativeGoldSwing > 0) {
        priceRows.push([copy.comparativeSwing!, `${integer.format(economy.comparativeGoldSwing)} ${copy.goldUnit}`]);
      }
      if (economy.estimatedItemDelayMinutes !== null) {
        priceRows.push([copy.delayEquivalent!, `≈ ${number.format(economy.estimatedItemDelayMinutes)} ${copy.minuteShort}`]);
      }
      if (audit.strongestItemDelta?.deltaMinutes !== null && audit.strongestItemDelta?.deltaMinutes !== undefined) {
        const delta = audit.strongestItemDelta.deltaMinutes;
        priceRows.push([copy.itemEvidence!, `${audit.strongestItemDelta.name} · ${delta > 0 ? "+" : ""}${number.format(delta)} ${copy.minuteShort}`]);
      }
      if (!priceRows.length) priceRows.push([copy.comparativeSwing!, comparable ? copy.noBreak! : copy.dataMissing!]);
      const priceList = root.querySelector<HTMLElement>("[data-economic-price]")!;
      priceList.replaceChildren(...priceRows.map(([label, result]) => {
        const row = make("div");
        row.append(make("dt", "", label), make("dd", "", result));
        return row;
      }));

      const focus = economy.replayFocus;
      const review = focus ?? critical;
      const focusHeading = root.querySelector<HTMLElement>("[data-economic-replay-window]")!;
      focusHeading.textContent = review ? windowLabel(review) : copy.focusNoFlag!;
      root.querySelector<HTMLElement>("[data-replay-focus]")!.dataset.available = String(Boolean(review));
      root.querySelector<HTMLElement>("[data-focus-explanation]")!.textContent = focus ? copy.focusNarrow! : critical ? copy.focusBroad! : comparable ? copy.focusStable! : copy.focusMissing!;
      const facts: Array<[string, string]> = [];
      if (review) {
        facts.push([copy.you!, signedGold(review.playerGoldGain)]);
        facts.push([copy.directOpponent!, signedGold(review.counterpartGoldGain)]);
        facts.push([copy.roleGap!, signedGold(review.roleGapChange)]);
        facts.push([copy.teamGap!, signedGold(review.teamGapChange)]);
      }
      if (focus) {
        facts.push([`${copy.lastHits} · ${copy.you}`, value(focus.playerLastHits)]);
        facts.push([`${copy.lastHits} · ${copy.directOpponent}`, value(focus.counterpartLastHits)]);
      }
      const factsRoot = root.querySelector<HTMLElement>("[data-focus-facts]")!;
      factsRoot.replaceChildren(...facts.map(([label, amount]) => {
        const row = make("div"); row.append(make("dt", "", label), make("dd", "", amount)); return row;
      }));
      const episodeContext = buildDotaEpisodeContext(draft, review);
      renderDotaEpisodeContext(root.querySelector<HTMLElement>("[data-episode-context]")!, episodeContext, lang, (id) => heroFor(id).name, () => {
        setResultTab("draft");
        root.querySelector<HTMLButtonElement>('[data-result-tab="draft"]')!.focus();
      });
      const otherPurchases = selectDotaEpisodeOtherPurchases(episodeContext, audit.player.heroId, audit.majorPurchases);
      const otherPurchaseDetails = root.querySelector<HTMLDetailsElement>("[data-focus-other]")!;
      otherPurchaseDetails.hidden = otherPurchases.length === 0;
      otherPurchaseDetails.open = false;
      root.querySelector<HTMLElement>("[data-focus-purchases]")!.replaceChildren(...otherPurchases.map((purchase) => {
        const link = make("a", "match-focus-purchase");
        link.href = itemPaths[purchase.key] ?? data.plannerPath;
        link.append(media("match-focus-item-image", purchase.name, purchase.image), make("span", "", `${purchase.name} · ${number.format(purchase.minute)} ${copy.minuteShort}`));
        return link;
      }));
      const question = !review ? copy.focusMissing! : critical?.kind === "team" ? copy.focusTeamQuestion!
        : focus?.playerLastHits != null && focus.counterpartLastHits != null && focus.playerLastHits < focus.counterpartLastHits
          ? copy.focusFarmQuestion! : copy.focusGoldQuestion!;
      root.querySelector<HTMLElement>("[data-focus-question]")!.textContent = question;
      const checks = lang === "ru"
        ? ["Начни за 30 секунд до эпизода: что было доступно обоим героям?", "В конце эпизода проверь результат действия, включая пользу для команды."]
        : ["Start 30 seconds before the episode: what was available to both heroes?", "At the end, inspect the action's outcome, including its value to the team."];
      root.querySelector<HTMLElement>("[data-economic-replay-checks]")!.replaceChildren(...(review ? checks.map((check) => make("li", "", check)) : []));
      currentFocusNote = currentMatch && review
        ? `Money Meta · ${currentMatch.matchId} · ${heroFor(audit.player.heroId).name} · ${windowLabel(review)}\n${economy.counterpart ? `${heroFor(economy.counterpart.heroId).name} · ${economy.comparisonBasis === "manual" ? copy.compareManual : copy.comparePosition}` : copy.noDirectOpponent}\n${facts.map(([label, amount]) => `${label}: ${amount}`).join("\n")}\n${question}` : "";
      const contextNote = buildDotaEpisodeNote(episodeContext, lang, (id) => heroFor(id).name);
      if (currentFocusNote && contextNote) currentFocusNote += `\n\n${contextNote}`;
      if (currentFocusNote && otherPurchases.length) currentFocusNote += `\n${copy.focusOtherPurchases}: ${otherPurchases.map((purchase) => `${purchase.name} · ${number.format(purchase.minute)} ${copy.minuteShort}`).join(", ")}`;
      root.querySelector<HTMLButtonElement>("[data-copy-focus]")!.disabled = !currentFocusNote;
      root.querySelector<HTMLElement>("[data-focus-copy-status]")!.textContent = "";
      root.querySelector<HTMLElement>("[data-economic-boundary]")!.textContent = `${copy.thresholdNote}${economy.counterpart ? "" : ` ${copy.noOpponentAutopsy}`}`;
    };

    const svgNode = <K extends keyof SVGElementTagNameMap>(tag: K, attributes: Record<string, string>) => {
      const node = document.createElementNS("http://www.w3.org/2000/svg", tag);
      Object.entries(attributes).forEach(([key, attribute]) => node.setAttribute(key, attribute));
      return node;
    };

    const renderChart = (audit: DotaMatchAudit) => {
      const trajectory = root.querySelector<HTMLElement>("[data-trajectory]")!;
      const fallback = root.querySelector<HTMLElement>("[data-no-timeline]")!;
      const checkpoints = root.querySelector<HTMLElement>("[data-checkpoint-section]")!;
      trajectory.hidden = !audit.timelineAvailable;
      checkpoints.hidden = !audit.timelineAvailable;
      fallback.hidden = audit.timelineAvailable;
      const legend = root.querySelector<HTMLElement>("[data-chart-legend]")!;
      const seriesLegend = root.querySelector<HTMLElement>("[data-chart-series]")!;
      legend.hidden = true;
      legend.replaceChildren();
      seriesLegend.replaceChildren();
      if (!audit.timelineAvailable || audit.series.length < 2) return;
      const svg = root.querySelector<SVGSVGElement>("[data-audit-chart]")!;
      svg.replaceChildren();
      const left = 54, right = 872, top = 28, bottom = 272;
      const opponentSeries = audit.economy.counterpartSeries;
      const maximumMinute = Math.max(1, audit.series.at(-1)!.minute, opponentSeries.at(-1)?.minute ?? 0);
      const maximumGold = Math.max(1, ...audit.series.map((point) => point.totalGold), ...opponentSeries.map((point) => point.totalGold));
      const x = (minute: number) => left + minute / maximumMinute * (right - left);
      const y = (gold: number) => bottom - gold / maximumGold * (bottom - top);
      [0, .5, 1].forEach((ratio) => {
        const line = svgNode("line", { x1: String(left), x2: String(right), y1: String(bottom - ratio * (bottom - top)), y2: String(bottom - ratio * (bottom - top)), class: "chart-grid" });
        svg.append(line);
      });
      const focus = audit.economy.replayFocus ?? audit.economy.criticalWindow;
      if (focus) {
        const band = svgNode("rect", { x: String(x(focus.startMinute)), y: String(top), width: String(Math.max(0, x(focus.endMinute) - x(focus.startMinute))), height: String(bottom - top), class: "chart-focus-band" });
        const title = svgNode("title", {}); title.textContent = `${copy.focusTitle}: ${windowLabel(focus)}`; band.append(title); svg.append(band);
      }
      const linePath = audit.series.map((point, index) => `${index ? "L" : "M"}${x(point.minute).toFixed(1)},${y(point.totalGold).toFixed(1)}`).join(" ");
      const areaPath = `${linePath} L${x(audit.series.at(-1)!.minute).toFixed(1)},${bottom} L${x(audit.series[0]!.minute).toFixed(1)},${bottom} Z`;
      svg.append(svgNode("path", { d: areaPath, class: "chart-area" }), svgNode("path", { d: linePath, class: "chart-line" }));
      if (opponentSeries.length >= 2) {
        const opponentPath = opponentSeries.map((point, index) => `${index ? "L" : "M"}${x(point.minute).toFixed(1)},${y(point.totalGold).toFixed(1)}`).join(" ");
        svg.append(svgNode("path", { d: opponentPath, class: "chart-line is-opponent" }));
      }
      [0, maximumMinute / 2, maximumMinute].forEach((minuteValue) => {
        const label = svgNode("text", { x: String(x(minuteValue)), y: "302", class: "chart-axis", "text-anchor": minuteValue === 0 ? "start" : minuteValue === maximumMinute ? "end" : "middle" });
        label.textContent = `${number.format(minuteValue)}m`;
        svg.append(label);
      });
      const chartPurchases = audit.majorPurchases.filter((purchase) => purchase.minute <= maximumMinute).slice(0, 6);
      chartPurchases.forEach((purchase, index) => {
        const purchaseMinute = Math.min(maximumMinute, Math.max(0, purchase.minute));
        const point = audit.series.reduce((nearest, candidate) => Math.abs(candidate.minute - purchase.minute) < Math.abs(nearest.minute - purchase.minute) ? candidate : nearest);
        const group = svgNode("g", { class: "chart-purchase" });
        const title = svgNode("title", {});
        title.textContent = `${index + 1}. ${purchase.name}, ${number.format(purchase.minute)} ${copy.minuteShort}`;
        group.append(title);
        group.append(svgNode("line", { x1: String(x(purchaseMinute)), x2: String(x(purchaseMinute)), y1: String(y(point.totalGold)), y2: String(bottom) }));
        group.append(svgNode("circle", { cx: String(x(purchaseMinute)), cy: String(y(point.totalGold)), r: "11" }));
        const marker = svgNode("text", { x: String(x(purchaseMinute)), y: String(y(point.totalGold) + 3.5), class: "chart-marker-label", "text-anchor": "middle", "aria-hidden": "true" });
        marker.textContent = String(index + 1);
        group.append(marker);
        svg.append(group);
      });
      const legendItems = chartPurchases.map((purchase, index) => {
        const card = make("article");
        card.append(make("span", "match-chart-index", String(index + 1)), media("match-chart-item-image", purchase.name, purchase.image));
        const body = make("div");
        body.append(make("strong", "", purchase.name), make("small", "", `${number.format(purchase.minute)} ${copy.minuteShort}`));
        card.append(body);
        return card;
      });
      legend.replaceChildren(...legendItems);
      legend.hidden = legendItems.length === 0;
      const chartTitle = root.querySelector<HTMLElement>("[data-chart-title]")!;
      const chartText = root.querySelector<HTMLElement>("[data-chart-text]")!;
      chartTitle.textContent = opponentSeries.length >= 2 ? copy.chartTitleCompared! : copy.chartTitle!;
      chartText.textContent = `${copy.chartText}${focus ? ` ${copy.focusTitle}: ${windowLabel(focus)}.` : ""}`;
      const playerKey = make("span", "is-player", copy.you);
      if (opponentSeries.length >= 2 && audit.economy.counterpart) {
        const opponent = heroFor(audit.economy.counterpart.heroId);
        seriesLegend.replaceChildren(playerKey, make("span", "is-opponent", `${opponent.name} · ${positionLabel(audit.economy.counterpart)}`));
      } else {
        seriesLegend.replaceChildren(playerKey);
      }
      root.querySelector<HTMLElement>("[data-chart-total]")!.textContent = `${integer.format(maximumGold)} ${copy.goldUnit}`;
    };

    const renderCheckpoints = (audit: DotaMatchAudit) => {
      let previous = 0;
      const cards = audit.checkpoints.map((checkpoint) => {
        const card = make("article");
        card.append(make("span", "", `${number.format(previous)}-${number.format(checkpoint.minute)} ${copy.minuteShort}`));
        card.append(make("strong", "", integer.format(checkpoint.totalGold)));
        card.append(make("small", "", copy.totalGold));
        const details = make("dl");
        const gpm = make("div");
        gpm.append(make("dt", "", copy.intervalGpm), make("dd", "", integer.format(checkpoint.intervalGoldPerMinute)));
        const cs = make("div");
        cs.append(make("dt", "", copy.intervalCs), make("dd", "", value(checkpoint.intervalLastHits)));
        details.append(gpm, cs);
        card.append(details);
        previous = checkpoint.minute;
        return card;
      });
      root.querySelector<HTMLElement>("[data-audit-checkpoints]")!.replaceChildren(...cards);
    };

    const renderPurchases = (audit: DotaMatchAudit) => {
      const container = root.querySelector<HTMLElement>("[data-audit-purchases]")!;
      const empty = root.querySelector<HTMLElement>("[data-no-purchases]")!;
      empty.hidden = audit.majorPurchases.length > 0;
      empty.textContent = audit.player.purchases.length ? copy.noMajorPurchases! : copy.noPurchaseLog!;
      const cards = audit.majorPurchases.map((purchase) => {
        const card = make("article");
        const top = make("div");
        const portrait = media("match-purchase-image", purchase.name, purchase.image);
        const heading = make("div");
        heading.append(make("span", "", `${copy.boughtAt} ${number.format(purchase.minute)} ${copy.minuteShort}`), make("strong", "", purchase.name), make("small", "", `${copy.cost}: ${integer.format(purchase.cost)} ${copy.goldUnit}`));
        top.append(portrait, heading);
        card.append(top);
        const benchmark = make("p", purchase.benchmark ? "has-benchmark" : "");
        benchmark.textContent = purchase.benchmark
          ? `${copy.proMedian}: ${number.format(purchase.benchmark.median)} ${copy.minuteShort} · ${purchase.deltaMinutes! > 0 ? "+" : ""}${number.format(purchase.deltaMinutes!)} ${copy.minuteShort} · n ${integer.format(purchase.benchmark.n)}`
          : copy.noBenchmark!;
        card.append(benchmark);
        const link = make("a", "", `${copy.inspectItem} →`);
        link.href = itemPaths[purchase.key] ?? "#";
        card.append(link);
        return card;
      });
      container.replaceChildren(...cards);
      const planUrl = new URL(data.plannerPath, window.location.origin);
      audit.majorPurchases.slice(0, 5).forEach((purchase, index) => planUrl.searchParams.set(`dota-item-plan.item${index + 1}`, purchase.key));
      if (roleControl.value !== "unknown") planUrl.searchParams.set("dota-item-plan.role", audit.role);
      root.querySelector<HTMLAnchorElement>("[data-plan-link]")!.href = `${planUrl.pathname}${planUrl.search}`;
    };

    const renderAudit = () => {
      if (!currentMatch || currentSlot === null) return;
      const role = roleControl.value === "support" ? "support" : "core";
      const audit = buildDotaMatchAudit(currentMatch, currentSlot, items, role, data.patch.id, data.patch.minimumSample, parseDotaPlayerSlot(opponentControl.value), roleControl.value !== "unknown");
      if (!audit) return;
      const hero = heroFor(audit.player.heroId);
      root.querySelector<HTMLElement>("[data-selected-name]")!.textContent = hero.name;
      root.querySelector<HTMLElement>("[data-selected-position]")!.textContent = `${outcome(audit.player)} · ${positionLabel(audit.player)} · ${currentMatch.matchId}`;
      root.querySelector<HTMLElement>("[data-selected-fallback]")!.textContent = initials(hero.name);
      const selectedImage = root.querySelector<HTMLImageElement>("[data-selected-image]")!;
      const selectedFrame = selectedImage.parentElement!;
      selectedFrame.classList.add("is-fallback");
      selectedImage.src = hero.image;
      selectedImage.alt = hero.name;
      selectedImage.hidden = !hero.image;
      renderSignal(audit);
      renderDotaFinalReview(root, buildDotaFinalReview(currentMatch, audit.player, roleControl.value === "unknown" ? null : audit.role, audit.economy.counterpart), lang, (id) => heroFor(id).name, audit.economy.windows.length === 0);
      const draft = buildDotaDraftReview(currentMatch, audit.player);
      renderEconomicAutopsy(audit, draft);
      renderStats(audit);
      renderInventory(audit);
      renderChart(audit);
      renderCheckpoints(audit);
      renderPurchases(audit);
      renderDotaDraftReview(root.querySelector<HTMLElement>("[data-draft-review]")!, draft, lang, heroFor);
      const draftSummary = root.querySelector<HTMLElement>("[data-draft-summary]")!;
      draftSummary.hidden = draft.status !== "ready" && draft.status !== "partial";
      const ownFinding = draft.opportunities[0];
      const enemyFinding = draft.threats[0];
      const ownFindingHeroes = ownFinding?.heroIds.map((id) => heroFor(id).name).join(" + ");
      const enemyFindingHeroes = enemyFinding?.heroIds.map((id) => heroFor(id).name).join(" + ");
      root.querySelector<HTMLElement>("[data-draft-summary-text]")!.textContent = [
        ownFinding ? `${lang === "ru" ? "Твоя команда" : "Your team"}${ownFindingHeroes ? ` (${ownFindingHeroes})` : ""}: ${ownFinding.title[lang]}.` : "",
        enemyFinding ? `${lang === "ru" ? "Соперники" : "Opponents"}${enemyFindingHeroes ? ` (${enemyFindingHeroes})` : ""}: ${enemyFinding.title[lang]}.` : ""
      ].filter(Boolean).join(" ") || (lang === "ru" ? "Сравни проверенные способности героев и покупки обеих команд." : "Compare reviewed hero abilities and purchases on both teams.");
      result.hidden = false;
      setStep(3);
      syncAuditLanguageLinks();
    };

    function selectPlayer(slot: number, role?: DotaMatchRole | "unknown", opponentSlot?: number) {
      if (!currentMatch) return;
      const player = currentMatch.players.find((candidate) => candidate.playerSlot === slot);
      if (!player) return;
      currentSlot = slot;
      const auto = make("option", "", copy.compareAuto); auto.value = "auto";
      const opponents = currentMatch.players.filter((candidate) => candidate.isRadiant !== player.isRadiant);
      opponentControl.replaceChildren(auto, ...opponents.map((candidate) => {
        const option = make("option", "", `${heroFor(candidate.heroId).name} · ${positionLabel(candidate)}`);
        option.value = String(candidate.playerSlot); return option;
      }));
      opponentControl.value = opponents.some((candidate) => candidate.playerSlot === opponentSlot) ? String(opponentSlot) : "auto";
      setResultTab("summary");
      auditRoot.querySelector<HTMLElement>("[data-share-status]")!.textContent = "";
      auditRoot.querySelector<HTMLElement>("[data-rule-status]")!.textContent = "";
      auditRoot.querySelectorAll<HTMLElement>("[data-player-slot]").forEach((node) => {
        const selected = Number(node.dataset.playerSlot) === slot;
        node.classList.toggle("is-selected", selected);
        node.setAttribute("aria-pressed", String(selected));
      });
      auditRoot.querySelector<HTMLElement>("[data-match-choose]")!.hidden = true;
      roleControl.value = role ?? inferredDotaMatchRole(player) ?? "unknown";
      renderAudit();
    }

    function syncAuditLanguageLinks() {
      const matchId = currentMatch?.matchId ?? parseDotaMatchId(sharedMatch ?? "");
      if (!matchId) return;
      const slot = currentMatch ? currentSlot : pendingSlot;
      const opponent = currentMatch ? parseDotaPlayerSlot(opponentControl.value) : pendingOpponent;
      auditRoot.querySelectorAll<HTMLAnchorElement>(".lang-switch a").forEach((link) => {
        const target = new URL(link.href, window.location.origin);
        target.search = "";
        target.searchParams.set("match", String(matchId));
        if (slot != null) {
          target.searchParams.set("slot", String(slot));
          const role = currentMatch ? roleControl.value : pendingRole;
          if (role === "core" || role === "support") target.searchParams.set("role", role);
          if (opponent !== undefined) target.searchParams.set("opponent", String(opponent));
        }
        link.href = `${target.pathname}${target.search}`;
      });
    }
    syncAuditLanguageLinks();

    function setResultTab(key: string) {
      auditRoot.querySelectorAll<HTMLButtonElement>("[data-result-tab]").forEach((button) => {
        const selected = button.dataset.resultTab === key;
        button.setAttribute("aria-selected", String(selected));
        button.tabIndex = selected ? 0 : -1;
      });
      auditRoot.querySelectorAll<HTMLElement>("[data-result-panel]").forEach((panel) => { panel.hidden = panel.dataset.resultPanel !== key; });
    }
    const resultTabs = [...root.querySelectorAll<HTMLButtonElement>("[data-result-tab]")];
    root.querySelector<HTMLButtonElement>("[data-open-draft]")!.addEventListener("click", () => {
      setResultTab("draft");
      root.querySelector<HTMLButtonElement>('[data-result-tab="draft"]')!.focus();
    });
    resultTabs.forEach((button, index) => {
      button.addEventListener("click", () => setResultTab(button.dataset.resultTab!));
      button.addEventListener("keydown", (event) => {
        const next = event.key === "ArrowRight" ? (index + 1) % resultTabs.length
          : event.key === "ArrowLeft" ? (index + resultTabs.length - 1) % resultTabs.length
          : event.key === "Home" ? 0 : event.key === "End" ? resultTabs.length - 1 : null;
        if (next === null) return;
        event.preventDefault(); setResultTab(resultTabs[next]!.dataset.resultTab!); resultTabs[next]!.focus();
      });
    });

    const copyText = async (text: string) => {
      try {
        if (!navigator.clipboard?.writeText) return false;
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        return false;
      }
    };

    const recoveryPanel = root.querySelector<HTMLElement>("[data-match-recovery]")!;
    const recoveryStatus = root.querySelector<HTMLElement>("[data-recovery-status]")!;
    const requestReplay = root.querySelector<HTMLButtonElement>("[data-request-replay]")!;
    const refreshReplay = root.querySelector<HTMLButtonElement>("[data-refresh-replay]")!;
    const stopReplay = root.querySelector<HTMLButtonElement>("[data-stop-replay]")!;

    const requestJson = async (endpoint: string, body: unknown, header: Record<string, string>, signal: AbortSignal, timeout: number) => {
      const controller = new AbortController();
      const abort = () => controller.abort();
      if (signal.aborted) controller.abort();
      else signal.addEventListener("abort", abort, { once: true });
      const timer = window.setTimeout(abort, timeout);
      try {
        const response = await fetch(endpoint, {
          method: "POST", credentials: "same-origin", cache: "no-store",
          headers: { Accept: "application/json", "Content-Type": "application/json", ...header },
          body: JSON.stringify(body), signal: controller.signal
        });
        if (response.status === 404) throw new Error("not-found");
        if (response.status === 429) throw new Error("rate-limit");
        if (response.status === 504) throw new Error("timeout");
        if (!response.ok) throw new Error("request-failed");
        return await response.json();
      } catch (error) {
        if (controller.signal.aborted) throw new Error("timeout");
        throw error;
      } finally { window.clearTimeout(timer); signal.removeEventListener("abort", abort); }
    };
    const readMatch = async (matchId: number, signal: AbortSignal) => {
      const payload = await requestJson(data.config.relayEndpoint, { matchId }, { "X-Money-Meta-Relay": "dota-match-v1" }, signal, data.config.relayTimeoutMs);
      const match = sanitizeDotaMatchResponse(payload);
      if (!match) throw new Error("malformed");
      if (match.matchId !== matchId) throw new Error("mismatch");
      return match;
    };
    const recovery = new DotaMatchRecovery({
      request: async (matchId, signal) => {
        const response = await requestJson(data.config.parseEndpoint, { matchId, requestReplay: true }, { "X-Money-Meta-Parse": "dota-parse-v1" }, signal, data.config.parseTimeoutMs);
        if (response.accepted !== true || response.matchId !== matchId) throw new Error("malformed");
      },
      read: readMatch,
      apply: (match) => {
        if (!currentMatch || currentMatch.matchId !== match.matchId) return;
        // A stale provider response must not remove an already available timeline.
        if (!canReplaceDotaMatch(currentMatch, match)) throw new Error("stale");
        const slot = currentSlot;
        const role = roleControl.value as DotaMatchRole | "unknown";
        const opponent = parseDotaPlayerSlot(opponentControl.value);
        const tab = root.querySelector<HTMLElement>('[data-result-tab][aria-selected="true"]')?.dataset.resultTab ?? "summary";
        const contributionExpanded = root.querySelector<HTMLDetailsElement>("[data-final-review]")!.open;
        renderMatch(match);
        if (slot !== null) selectPlayer(slot, role, opponent);
        setResultTab(tab);
        root.querySelector<HTMLDetailsElement>("[data-final-review]")!.open = contributionExpanded;
      },
      state: (state: DotaRecoveryState, error?: unknown) => {
        const labels: Record<DotaRecoveryState, string> = {
          requesting: copy.recoveryRequesting!, waiting: copy.recoveryWaiting!, checking: copy.recoveryChecking!,
          ready: copy.recoveryReady!, pending: copy.recoveryPending!, stopped: copy.recoveryStopped!, error: copy.recoveryError!
        };
        recoveryStatus.textContent = error instanceof Error && error.message === "rate-limit" ? copy.recoveryLimited! : labels[state];
        recoveryStatus.dataset.state = state;
        updateRecoveryControls();
      }
    });
    function updateRecoveryControls() {
      const complete = currentMatch?.players.length === 10 && currentMatch.players.every(hasDotaMatchTimeline);
      recoveryPanel.hidden = !currentMatch || Boolean(complete && !recoveryStatus.textContent);
      requestReplay.disabled = !currentMatch || recovery.busy || Boolean(complete) || recovery.wasRequested(currentMatch.matchId);
      refreshReplay.disabled = !currentMatch || recovery.busy;
      stopReplay.hidden = !recovery.busy;
      if (currentMatch) auditRoot.querySelector<HTMLAnchorElement>("[data-recovery-provider]")!.href = `${data.config.publicMatchBase}/${currentMatch.matchId}`;
    }
    requestReplay.addEventListener("click", () => { if (currentMatch) void recovery.run(currentMatch.matchId, true); });
    refreshReplay.addEventListener("click", () => { if (currentMatch) void recovery.run(currentMatch.matchId); });
    stopReplay.addEventListener("click", () => recovery.cancel());
    window.addEventListener("pagehide", () => recovery.cancel(false), { once: true });

    const loadMatch = async () => {
      const matchId = parseDotaMatchId(input.value);
      if (!matchId) {
        setStatus(copy.invalid!);
        input.focus();
        return;
      }
      submit.disabled = true;
      demo.disabled = true;
      recovery.cancel(false);
      recoveryPanel.hidden = true;
      recoveryStatus.textContent = "";
      selection.hidden = true;
      result.hidden = true;
      currentMatch = null;
      currentSlot = null;
      setStep(1);
      setStatus(copy.loading!, "loading");
      const controller = new AbortController();
      try {
        const match = await readMatch(matchId, controller.signal);
        setStatus("", "success");
        renderMatch(match);
      } catch (error) {
        const reason = error instanceof Error ? error.message : "request-failed";
        const aborted = controller.signal.aborted || (error instanceof DOMException && error.name === "AbortError");
        const message = reason === "not-found"
          ? copy.notFound!
          : reason === "rate-limit"
            ? copy.rateLimited!
            : reason === "malformed"
              ? copy.malformed!
              : reason === "mismatch"
                ? copy.mismatch!
                : reason === "timeout" || aborted
                  ? copy.timeout!
                  : copy.failed!;
        setStatus(message);
      } finally {
        submit.disabled = false;
        demo.disabled = false;
      }
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void loadMatch();
    });

    demo.addEventListener("click", () => {
      input.value = String(data.config.demoMatchId);
      form.requestSubmit();
    });
    if (sharedMatch && params.get("autoload") === "1") form.requestSubmit();
    roleControl.addEventListener("change", renderAudit);
    opponentControl.addEventListener("change", () => {
      auditRoot.querySelector<HTMLElement>("[data-share-status]")!.textContent = "";
      auditRoot.querySelector<HTMLElement>("[data-rule-status]")!.textContent = "";
      renderAudit();
    });
    root.querySelector<HTMLButtonElement>("[data-copy-focus]")!.addEventListener("click", async () => {
      if (!currentFocusNote) return;
      const copied = await copyText(currentFocusNote);
      root.querySelector<HTMLElement>("[data-focus-copy-status]")!.textContent = copied ? copy.focusCopied! : copy.copyFailed!;
    });
    root.querySelector<HTMLButtonElement>("[data-match-share]")!.addEventListener("click", async () => {
      if (!currentMatch || currentSlot === null) return;
      const share = new URL(window.location.origin + window.location.pathname);
      share.searchParams.set("match", String(currentMatch.matchId));
      share.searchParams.set("slot", String(currentSlot));
      if (roleControl.value === "core" || roleControl.value === "support") share.searchParams.set("role", roleControl.value);
      const opponentSlot = parseDotaPlayerSlot(opponentControl.value);
      if (opponentSlot !== undefined) share.searchParams.set("opponent", String(opponentSlot));
      const copied = await copyText(share.toString());
      root.querySelector<HTMLElement>("[data-share-status]")!.textContent = copied ? copy.shared! : copy.copyFailed!;
    });
    root.querySelector<HTMLButtonElement>("[data-copy-rule]")!.addEventListener("click", async () => {
      if (!currentRule) return;
      const copied = await copyText(currentRule);
      root.querySelector<HTMLElement>("[data-rule-status]")!.textContent = copied ? copy.ruleCopied! : copy.copyFailed!;
    });
    root.querySelector<HTMLImageElement>("[data-selected-image]")!.addEventListener("load", (event) => { (event.currentTarget as HTMLImageElement).parentElement?.classList.remove("is-fallback"); });
    root.querySelector<HTMLImageElement>("[data-selected-image]")!.addEventListener("error", (event) => {
      const image = event.currentTarget as HTMLImageElement;
      image.hidden = true;
      image.parentElement?.classList.add("is-fallback");
    });
  }
</script>
