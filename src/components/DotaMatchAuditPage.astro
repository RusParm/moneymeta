---
import { dotaHeroes, dotaHeroSnapshot } from "../data/dota-heroes";
import { dotaMatchAuditConfig, getDotaMatchAuditPath } from "../data/dota-match";
import { dotaMatchItems, dotaMatchItemSnapshot } from "../data/dota-match-items";
import {
  dotaItems,
  dotaItemsSnapshot,
  getDotaItemPath,
  getDotaItemPlannerPath,
  type DotaItemsLocale
} from "../data/dota-items";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "./BrandHeader.astro";
import DotaItemNav from "./DotaItemNav.astro";
import DotaItemsStatus from "./DotaItemsStatus.astro";
import SiteFooter from "./SiteFooter.astro";
import "../styles/dota-match-audit.css";

interface Props { lang: DotaItemsLocale; }
const { lang } = Astro.props;
const path = getDotaMatchAuditPath(lang);
const alternate = getDotaMatchAuditPath(lang === "ru" ? "en" : "ru");
const itemPatchSource = dotaItemsSnapshot.patch.sourceUrl;
const copy = lang === "ru" ? {
