  sentValue: "Match ID · GET request",
  notSent: "Not sent",
  notSentValue: "Steam sign-in · files · local scenarios",
  retention: "Retention",
  retentionValue: "The match is gone after reload",
  steps: ["01 · MATCH", "02 · HERO", "03 · AUDIT"],
  selectTitle: "Whose economy are we auditing?",
