---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ck3World from "../assets/game-worlds/ck3-economy-world.webp";
import dotaWorld from "../assets/game-worlds/dota-economy-world.webp";
import gtaWorld from "../assets/game-worlds/gta-economy-world.webp";
import totalWarWorld from "../assets/game-worlds/total-war-economy-world.webp";
import wowWorld from "../assets/game-worlds/wow-economy-world.webp";
import { dotaItemsSnapshot, getDotaItemComparePath, getDotaItemPlannerPath, getDotaItemsPath } from "../data/dota-items";
import { getDotaMatchAuditPath } from "../data/dota-match";
import { getHubJourneyPath, hubJourneys } from "../data/hub-journeys";
import { getHubFreshnessPolicy, getHubPath, hubPortals, type HubLocale, type HubPortalId } from "../data/hub-portals";
import { insights, type InsightGame } from "../data/insights";
import "../styles/wow-hub.css";
import "../styles/strategy-hub.css";
import "../styles/hub-portal.css";
import "../styles/hub-entry.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "./BrandHeader.astro";
import HubDecisionGateway from "./HubDecisionGateway.astro";
import HubGameMark from "./HubGameMark.astro";
import SiteFooter from "./SiteFooter.astro";
import FreshnessIndicator from "./FreshnessIndicator.astro";
import HomeDecisionExample from "./HomeDecisionExample.astro";

interface Props {
  hub: HubPortalId;
  lang: HubLocale;
}

const { hub: hubId, lang } = Astro.props;
const hub = hubPortals[hubId];
const freshness = getHubFreshnessPolicy(hubId);
const staleLabel = lang === "ru" ? (hubId === "gta" ? "Событие завершилось" : "Контекст требует проверки") : (hubId === "gta" ? "Event has ended" : "Context needs a review");
const root = getHubPath(hubId, lang);
const alternate = getHubPath(hubId, lang === "ru" ? "en" : "ru");
const worlds: Record<HubPortalId, ImageMetadata> = {
  gta: gtaWorld,
  dota: dotaWorld,
  wow: wowWorld,
  "total-war": totalWarWorld,
  ck3: ck3World
};
const mainClass = hubId === "gta"
  ? "game-gta gta-living-hub"
  : hubId === "dota"
    ? "game-dota dota-living-hub"
    : hubId === "wow"
      ? "game-wow wow-living-hub"
      : `strategy-living-hub strategy-${hubId}`;
const insightGame: InsightGame = hubId === "total-war" ? "totalwar" : hubId;
const journeys = hubJourneys[hubId];
const featuredGuides = insights
  .filter((insight) => insight.game === insightGame)
  .sort((left, right) => Number(Boolean(right.featuredInHub)) - Number(Boolean(left.featuredInHub)) || right.updatedAt.localeCompare(left.updatedAt))
  .slice(0, 2);

const entry = {
  gta: {
    ru: { title: "GTA Online: накопить на покупку и сохранить резерв", text: "Проверь, какой недельный доход нужен к твоему сроку, чтобы после покупки в банке остался выбранный запас." },
    en: { title: "GTA Online: fund a purchase and keep a reserve", text: "Check the weekly income needed by your deadline while preserving the cash reserve you choose." }
  },
  dota: {
    ru: { title: "Dota 2: экономика твоего матча", text: "Начни разбор с изменения золота относительно соперника и команды. Когда есть хронология, найди эпизод для просмотра." },
    en: { title: "Dota 2: your match economy", text: "Start with gold changes against an opponent and the teams. When a timeline is available, find an episode to review." }
  },
  wow: {
    ru: { title: "WoW: прибыль и свободное золото", text: "Перед изготовлением партии проверь, сколько продаж вернёт затраты и сколько золота останется в товаре." },
    en: { title: "WoW: profit and spendable gold", text: "Before crafting a batch, check how many sales recover its cost and how much gold stays in stock." }
  },
  "total-war": {
    ru: { title: "Total War: казна после найма армии", text: "Проверь, хватит ли золота на найм и содержание до выбранного хода, с запасом на непредвиденные расходы." },
    en: { title: "Total War: cash after recruiting an army", text: "Check recruitment and upkeep through your target turn while protecting an emergency reserve." }
  },
  ck3: {
    ru: { title: "CK3: хватит ли казны на затяжную войну?", text: "Сопоставь разовые затраты, военные расходы и длительность войны с запасом золота, который хочешь сохранить." },
    en: { title: "CK3: can your treasury cover a longer war?", text: "Compare one-off costs, wartime spending and duration with the gold reserve you want to preserve." }
  }
}[hubId][lang];

const copy = lang === "ru" ? {
  back: "← Все экономики",
  live: "Рабочий контекст",
  checked: "проверено",
  secondary: "Что изменилось",
  value: "Ценность",
  valueLink: "Понять экономику",
  destinations: "Пять направлений",
  commandKicker: "Куда дальше",
  commandTitle: "Другие задачи и разборы",
  commandText: "Механики, расчёты и примеры для других решений в этой игре.",
  choose: "Не знаю, с чего начать",
  commandCount: "05 РАЗДЕЛОВ · 03 МАРШРУТА",
  result: "Что получишь",
  playbooks: "Готовые маршруты",
  playbooksText: "Если вопрос состоит из нескольких шагов, открой связанный маршрут вместо пяти вкладок наугад.",
  start: "Начать маршрут",
  guides: "Свежие разборы",
  guidesText: "Два материала для входа. Полная библиотека живёт на отдельной странице.",
  read: "Читать разбор",
  allGuides: "Открыть всю библиотеку",
  dotaLayer: "Реальный матч и предметы",
  dotaLayerText: "Начни со своего Match ID или заранее проверь предмет и порядок сборки.",
  audit: "Разбор матча",
  atlas: "Атлас предметов",
  compare: "Сравнить предметы",
  planner: "План сборки",
  context: "Актуальный контекст",
  sourceText: "Факты версии и вывод Money Meta остаются разными слоями.",
  openSource: "Открыть первоисточник",
  independent: "Независимый аналитический продукт"
} : {
  back: "← All economies",
  live: "Working context",
  checked: "checked",
  secondary: "What changed",
  value: "Value",
  valueLink: "Understand the economy",
  destinations: "Five destinations",
  commandKicker: "Where next",
  commandTitle: "More decisions and analysis",
  commandText: "Mechanics, calculations and examples for other decisions in this game.",
  choose: "Help me choose",
  commandCount: "05 PAGES · 03 PLAYBOOKS",
  result: "What you get",
  playbooks: "Connected playbooks",
  playbooksText: "When the question needs several steps, follow one authored route instead of opening five random tabs.",
  start: "Start playbook",
  guides: "Current analysis",
  guidesText: "Two deliberate entry points. The full research library lives on its own page.",
  read: "Read analysis",
  allGuides: "Open the full library",
  dotaLayer: "Real match and items",
  dotaLayerText: "Start with your Match ID or inspect an item and build order before the next game.",
  audit: "Match audit",
  atlas: "Item atlas",
  compare: "Compare items",
  planner: "Build planner",
  context: "Current context",
  sourceText: "Version facts and Money Meta conclusions remain separate layers.",
  openSource: "Open primary source",
  independent: "Independent analytical product"
};
---

<BaseLayout
  title={hub.title[lang]}
  description={hub.description[lang]}
  lang={lang}
  canonicalPath={root}
  alternatePath={alternate}
  schema={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: hub.title[lang],
    description: hub.description[lang],
    inLanguage: lang,
    about: { "@type": "VideoGame", name: hub.name, publisher: hub.publisher },
    hasPart: [
      ...hub.sections.map((item) => ({
        "@type": "WebPage",
        name: item.title[lang],
        url: new URL(getHubPath(hubId, lang, item.slug), Astro.site).toString()
      })),
      ...journeys.map((journey) => ({
        "@type": "HowTo",
        name: journey.title[lang],
        url: new URL(getHubJourneyPath(journey, lang), Astro.site).toString()
      }))
    ]
  }}
>
  <main class={`page game-page hub-portal hub-portal-v14 hub-entry ${mainClass}`} data-hub-portal={hubId} data-insight-game={insightGame}>
    <div class="shell">
      <BrandHeader
        lang={lang}
        ruPath={getHubPath(hubId, "ru")}
        enPath={getHubPath(hubId, "en")}
        backPath={lang === "ru" ? "/" : "/en/"}
        backLabel={copy.back}
      />

      <section class="portal-hero" aria-labelledby={`${hubId}-portal-title`}>
        <Image
          class="portal-hero-art"
          src={worlds[hubId]}
          alt={lang === "ru" ? `Оригинальный игровой мир Money Meta для ${hub.name}` : `Original Money Meta game world for ${hub.name}`}
          widths={[640, 960, 1280, 1672]}
          sizes="(max-width: 1180px) calc(100vw - 40px), 1180px"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="portal-hero-shade" aria-hidden="true"></div>
        <div class="portal-hero-copy">
          <FreshnessIndicator lang={lang} policy={freshness} current={copy.live} stale={staleLabel} dateLabel={copy.checked} />
          <h1 id={`${hubId}-portal-title`}>{entry.title}</h1>
          <p class="lede">{entry.text}</p>
          <a class="hub-entry-context" href={getHubPath(hubId, lang, "meta")}>{hub.version[lang]} · {copy.secondary} →</a>
        </div>
      </section>

      <section class="hub-entry-example" aria-label={lang === "ru" ? "Проверь решение на примере" : "Test a decision with an example"}>
        <HomeDecisionExample gameId={hubId} lang={lang} />
      </section>

      <details class="hub-entry-help">
        <summary>{copy.choose}</summary>
        <HubDecisionGateway hub={hubId} lang={lang} />
      </details>

      <section class="section hub-section portal-command-center" aria-labelledby={`${hubId}-command-title`}>
        <header class="portal-command-head">
          <div>
            <span class="section-kicker">{copy.commandKicker}</span>
            <h2 id={`${hubId}-command-title`}>{copy.commandTitle}</h2>
            <p>{copy.commandText}</p>
          </div>
          <span class="count">{copy.commandCount}</span>
        </header>

        <div class="portal-command-grid">
          <nav class="portal-route-list" aria-label={copy.destinations}>
            {hub.sections.map((item) => (
              <a href={getHubPath(hubId, lang, item.slug)}>
                <HubGameMark hub={hubId} section={item.slug} lang={lang} />
                <div>
                  <span>{item.code} · {item.label[lang]}</span>
                  <strong>{item.title[lang]}</strong>
                  <small><b>{copy.result}:</b> {item.payoff[lang]}</small>
                </div>
                <b aria-hidden="true">→</b>
              </a>
            ))}
          </nav>

          <div class="portal-command-side">
            {hubId === "dota" && (
              <section class="portal-dota-shortcuts" aria-labelledby="portal-dota-shortcuts-title">
                <div>
                  <span>DOTA 2 · {dotaItemsSnapshot.patch.label}</span>
                  <h3 id="portal-dota-shortcuts-title">{copy.dotaLayer}</h3>
                  <p>{copy.dotaLayerText}</p>
                </div>
                <nav>
                  <a href={getDotaMatchAuditPath(lang)}><span>ID</span><strong>{copy.audit}</strong><b>→</b></a>
                  <a href={getDotaItemsPath(lang)}><span>{dotaItemsSnapshot.items.length}</span><strong>{copy.atlas}</strong><b>→</b></a>
                  <a href={getDotaItemComparePath(lang)}><span>A/B</span><strong>{copy.compare}</strong><b>→</b></a>
                  <a href={getDotaItemPlannerPath(lang)}><span>2-5</span><strong>{copy.planner}</strong><b>→</b></a>
                </nav>
              </section>
            )}

            <section class="portal-playbook-panel" aria-labelledby={`${hubId}-playbooks-title`}>
              <header><div><span>{copy.playbooks}</span><h3 id={`${hubId}-playbooks-title`}>{copy.playbooks}</h3></div><p>{copy.playbooksText}</p></header>
              <div>
                {journeys.map((journey) => (
                  <a href={getHubJourneyPath(journey, lang)}>
                    <HubGameMark hub={hubId} section={journey.steps[0].destination.section} lang={lang} />
                    <span>{journey.code}</span>
                    <strong>{journey.title[lang]}</strong>
                    <small>{copy.start} →</small>
                  </a>
                ))}
              </div>
            </section>

            <section class="portal-guide-panel" aria-labelledby={`${hubId}-guides-title`}>
              <header><div><span>{copy.guides}</span><h3 id={`${hubId}-guides-title`}>{copy.guides}</h3></div><p>{copy.guidesText}</p></header>
              <div>
                {featuredGuides.map((guide) => (
                  <a href={`${lang === "en" ? "/en" : ""}/insights/${guide.slug}/`}>
                    <span>{guide.content[lang].readTime} · {guide.updatedAt}</span>
                    <strong>{guide.content[lang].title}</strong>
                    <small>{copy.read} →</small>
                  </a>
                ))}
              </div>
              <a class="portal-all-guides" href={getHubPath(hubId, lang, "guides")}>{copy.allGuides} →</a>
            </section>

            <aside class="portal-freshness-card">
              <div><strong>{hub.version[lang]}</strong><FreshnessIndicator lang={lang} policy={freshness} current={copy.context} stale={staleLabel} dateLabel={copy.checked} /></div>
              <p>{copy.sourceText}</p>
              <a href={hub.sourceUrl} target="_blank" rel="noopener noreferrer">{hub.sourceLabel[lang]} · {copy.openSource} ↗</a>
              <small>{copy.independent}</small>
            </aside>
          </div>
        </div>
      </section>

      <SiteFooter lang={lang} />
    </div>
  </main>
</BaseLayout>

<script>
  // Preserve existing links to the optional route finder.
  const revealRouteFinder = () => {
    if (window.location.hash !== "#quick-start") return;
    const target = document.getElementById("quick-start");
    const details = target?.closest("details");
    if (details) details.open = true;
    target?.scrollIntoView({ block: "start" });
  };
  revealRouteFinder();
  window.addEventListener("hashchange", revealRouteFinder);
</script>
