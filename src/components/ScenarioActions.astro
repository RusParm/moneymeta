---
interface Props { lang: "ru" | "en"; }
const { lang } = Astro.props;
const copy = lang === "ru"
  ? { share: "Поделиться сценарием", reset: "Сбросить", copied: "Ссылка скопирована", saved: "Параметры сохраняются локально", unavailable: "Хранилище недоступно. Сохрани ссылку на сценарий.", manual: "Ссылку можно скопировать вручную" }
  : { share: "Share scenario", reset: "Reset", copied: "Link copied", saved: "Inputs save locally", unavailable: "Local storage unavailable. Save a scenario link instead.", manual: "You can copy the link manually" };
---

<div class="scenario-actions" data-scenario-actions data-storage-unavailable={copy.unavailable} data-manual-copy={copy.manual}>
  <button class="mini-action" type="button" data-share-scenario data-copied-label={copy.copied}>↗ {copy.share}</button>
  <button class="mini-action" type="button" data-reset-scenario>↺ {copy.reset}</button>
  <span class="scenario-feedback" data-scenario-feedback aria-live="polite">{copy.saved}</span>
</div>

<script>
  type Control = HTMLInputElement | HTMLSelectElement;

  const ready = (callback: () => void) => {
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", callback, { once: true });
    else callback();
  };

  ready(() => requestAnimationFrame(() => {
    document.querySelectorAll<HTMLElement>("[data-scenario-root]").forEach((root) => {
      if (root.dataset.scenarioReady === "true") return;
      root.dataset.scenarioReady = "true";
      const key = root.dataset.scenarioKey;
      if (!key) return;
      const controls = [...root.querySelectorAll<Control>("input[data-role], select[data-role]")];
      const actions = root.querySelector<HTMLElement>("[data-scenario-actions]");
      const share = actions?.querySelector<HTMLButtonElement>("[data-share-scenario]");
      const reset = actions?.querySelector<HTMLButtonElement>("[data-reset-scenario]");
      const feedback = actions?.querySelector<HTMLElement>("[data-scenario-feedback]");
      if (!controls.length || !actions || !share || !reset || !feedback) return;

      const storageKey = `money-meta:scenario:${key}:v1`;
      const defaults = Object.fromEntries(controls.map((control) => [control.dataset.role!, control.value]));
      const params = new URLSearchParams(window.location.search);
      const fromUrl = Object.fromEntries(controls
        .map((control) => [control.dataset.role!, params.get(`${key}.${control.dataset.role}`)] as const)
        .filter((entry): entry is [string, string] => entry[1] !== null));
      let stored: Record<string, string> = {};
      const storageUnavailable = () => { feedback.textContent = actions.dataset.storageUnavailable ?? ""; };
      try {
        const candidate = JSON.parse(localStorage.getItem(storageKey) ?? "{}");
        if (candidate && typeof candidate === "object" && !Array.isArray(candidate)) stored = candidate;
      } catch { storageUnavailable(); }
      const restored = Object.keys(fromUrl).length ? fromUrl : stored;

      const dispatch = (control: Control) => control.dispatchEvent(new Event(control instanceof HTMLSelectElement ? "change" : "input", { bubbles: true }));
      const apply = (values: Record<string, string>) => {
        controls.filter((control) => control instanceof HTMLSelectElement).forEach((control) => {
          const value = values[control.dataset.role!];
          if (typeof value === "string" && control instanceof HTMLSelectElement && [...control.options].some((option) => option.value === value)) {
            control.value = value;
            dispatch(control);
          }
        });
        controls.filter((control) => control instanceof HTMLInputElement).forEach((control) => {
          const value = values[control.dataset.role!];
          if (typeof value !== "string") return;
          if (control instanceof HTMLInputElement && control.type === "number") {
            const numeric = Number(value);
            if (value.trim() === "" || !Number.isFinite(numeric)) return;
            const minimum = control.min === "" ? -Infinity : Number(control.min);
            const maximum = control.max === "" ? Infinity : Number(control.max);
            control.value = String(Math.min(maximum, Math.max(minimum, numeric)));
          } else control.value = value;
          dispatch(control);
        });
      };
      apply(restored);

      const save = () => {
        const values = Object.fromEntries(controls.map((control) => [control.dataset.role!, control.value]));
        try { localStorage.setItem(storageKey, JSON.stringify(values)); } catch { storageUnavailable(); }
      };
      controls.forEach((control) => {
        control.addEventListener("input", save);
        control.addEventListener("change", save);
      });

      const setFeedback = (message: string) => {
        const previous = feedback.textContent ?? "";
        feedback.textContent = message;
        window.setTimeout(() => { feedback.textContent = previous; }, 1800);
      };

      share.addEventListener("click", async () => {
        const url = new URL(window.location.href);
        controls.forEach((control) => url.searchParams.set(`${key}.${control.dataset.role}`, control.value));
        const section = root.closest<HTMLElement>("section[id]");
        if (section) url.hash = section.id;
        try {
          await navigator.clipboard.writeText(url.toString());
          setFeedback(share.dataset.copiedLabel ?? (document.documentElement.lang === "ru" ? "Ссылка скопирована" : "Link copied"));
        } catch {
          window.prompt(document.documentElement.lang === "ru" ? "Скопируй ссылку" : "Copy this link", url.toString());
          setFeedback(actions.dataset.manualCopy ?? "");
        }
      });

      reset.addEventListener("click", () => {
        apply(defaults);
        try { localStorage.removeItem(storageKey); } catch { storageUnavailable(); }
        const url = new URL(window.location.href);
        [...url.searchParams.keys()].filter((name) => name.startsWith(`${key}.`)).forEach((name) => url.searchParams.delete(name));
        window.history.replaceState({}, "", url);
      });
    });
  }));
</script>
