---
import { scenarioContexts, scenarioEngineVersion } from "../data/scenario-context";
import { getSavedScenariosPath, scenarioTools } from "../data/scenario-tools";
import "../styles/saved-scenarios.css";
interface Props { lang: "ru" | "en"; }
const { lang } = Astro.props;
const allContexts = scenarioContexts(lang);
const path = Astro.url.pathname.replace(/^\/en\//, "/");
const contexts = JSON.stringify(Object.fromEntries(scenarioTools.filter((tool) => tool.path === path).map((tool) => [tool.key, allContexts[tool.key]])));
const copy = lang === "ru"
  ? { share: "Поделиться сценарием", reset: "Сбросить", copied: "Ссылка скопирована", saved: "Параметры сохраняются локально", unavailable: "Хранилище недоступно. Сохрани ссылку на сценарий.", manual: "Ссылку можно скопировать вручную" }
  : { share: "Share scenario", reset: "Reset", copied: "Link copied", saved: "Inputs save locally", unavailable: "Local storage unavailable. Save a scenario link instead.", manual: "You can copy the link manually" };
---

<div class="scenario-actions" data-scenario-actions data-storage-unavailable={copy.unavailable} data-manual-copy={copy.manual} data-contexts={contexts} data-engine={scenarioEngineVersion}>
  <button class="mini-action save-calculation" type="button" data-open-save aria-expanded="false" hidden>{lang === "ru" ? "Сохранить расчёт" : "Save calculation"}</button>
  <button class="mini-action" type="button" data-share-scenario data-copied-label={copy.copied}>↗ {copy.share}</button>
  <button class="mini-action" type="button" data-reset-scenario>↺ {copy.reset}</button>
  <a class="mini-action saved-calculations-link" href={getSavedScenariosPath(lang)}>{lang === "ru" ? "Мои расчёты" : "My calculations"}</a>
  <div class="save-calculation-editor" data-save-editor hidden>
    <label>{lang === "ru" ? "Название расчёта" : "Calculation name"}<input type="text" data-save-name maxlength="80" autocomplete="off" placeholder={lang === "ru" ? "Например: план на вечер" : "For example: plan for tonight"} /></label>
    <p>{lang === "ru" ? "Сохраним вводные и результат в этом браузере. Каждый вариант останется отдельным расчётом." : "Inputs and the result stay in this browser. Each variant is saved separately."}</p>
    <div><button type="button" data-save-calculation>{lang === "ru" ? "Сохранить" : "Save"}</button><button type="button" data-cancel-save>{lang === "ru" ? "Отмена" : "Cancel"}</button></div>
    <p data-save-status role="status"></p>
  </div>
  <span class="scenario-feedback" data-scenario-feedback aria-live="polite">{copy.saved}</span>
</div>

<script>
  import { initializeScenarioActions } from "../lib/scenario-actions";
  const ready = () => requestAnimationFrame(initializeScenarioActions);
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", ready, { once: true });
  else ready();
</script>
