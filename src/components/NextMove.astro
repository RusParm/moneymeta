---
import ScenarioActions from "./ScenarioActions.astro";

interface Props { lang: "ru" | "en"; }
const { lang } = Astro.props;

const copy = lang === "ru" ? {
  kicker: "Returner Toolkit · Decision Engine v1",
  title: "Что мне купить или запустить следующим?",
  text: "Это не tier list. Рекомендация учитывает твой капитал, время и отношение к ручной возне. Все исходные цифры можно проверить ниже.",
  profile: "Как ты играешь",
  profiles: [["returner", "Вернулся после перерыва"], ["casual", "Solo / мало времени"], ["grinder", "Продвинутый grinder"]],
  budget: "Доступный капитал, GTA$",
  hours: "Часов игры в неделю",
  priority: "Главная цель",
  priorities: [["fast-payback", "Быстрее вернуть вложения"], ["max-income", "Максимум дохода"], ["low-friction", "Минимум ручной возни"]],
  friction: "Допустимый friction",
  frictions: [["4", "Низкий — хочу спокойно"], ["6", "Средний"], ["10", "Любой — готов grind"]],
  button: "Рассчитать следующий ход",
  label: "Твой Next Best Move",
  empty: "Пока ничего не подходит",
  emptyReason: "Увеличь бюджет или допустимый friction — Money Meta не будет советовать недоступный актив.",
  payback: "Окупаемость",
  income: "Чистыми / ч производства",
  setup: "Вложения",
  fit: "Decision fit",
  alternatives: "Альтернативы",
  estimated: "Estimated · editable below",
  productionHours: "ч производства"
} : {
  kicker: "Returner Toolkit · Decision Engine v1",
  title: "What should I buy or run next?",
  text: "This is not a tier list. The recommendation uses your capital, time and tolerance for manual friction. Every input can be inspected below.",
  profile: "How you play",
  profiles: [["returner", "Returning after a break"], ["casual", "Solo / limited time"], ["grinder", "Advanced grinder"]],
  budget: "Available capital, GTA$",
  hours: "Play hours per week",
  priority: "Primary objective",
  priorities: [["fast-payback", "Recover capital faster"], ["max-income", "Maximize income"], ["low-friction", "Minimize manual work"]],
  friction: "Maximum friction",
  frictions: [["4", "Low — keep it calm"], ["6", "Medium"], ["10", "Any — ready to grind"]],
  button: "Calculate next move",
  label: "Your Next Best Move",
  empty: "Nothing fits yet",
  emptyReason: "Increase the budget or friction tolerance. Money Meta will not recommend an unavailable asset.",
  payback: "Payback",
  income: "Net / production h",
  setup: "Investment",
  fit: "Decision fit",
  alternatives: "Alternatives",
  estimated: "Estimated · editable below",
  productionHours: "production h"
};
---

<section id="next-move" class="section" data-lang={lang}>
  <div class="section-head">
    <div>
      <span class="section-kicker">{copy.kicker}</span>
      <h2>{copy.title}</h2>
      <p class="section-copy">{copy.text}</p>
    </div>
    <span class="pill gold">{copy.estimated}</span>
  </div>

  <div class="grid-2" data-scenario-root data-scenario-key="gta-next-move">
    <form class="card" data-role="decision-form">
      <div class="form-grid">
        <div class="field">
          <label for="player-profile">{copy.profile}</label>
          <select id="player-profile" data-role="profile">
            {copy.profiles.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="decision-budget">{copy.budget}</label>
          <input id="decision-budget" data-role="budget" type="number" min="0" step="100000" value="2500000" inputmode="numeric" />
        </div>
        <div class="field">
          <label for="decision-hours">{copy.hours}</label>
          <input id="decision-hours" data-role="hours" type="number" min="1" max="80" step="1" value="6" />
        </div>
        <div class="field">
          <label for="decision-priority">{copy.priority}</label>
          <select id="decision-priority" data-role="priority">
            {copy.priorities.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </div>
        <div class="field" style="grid-column:1/-1">
          <label for="decision-friction">{copy.friction}</label>
          <select id="decision-friction" data-role="friction">
            {copy.frictions.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </div>
      </div>
      <button class="button primary" type="submit" style="margin-top:18px;width:100%">{copy.button} →</button>
    </form>

    <article class="card result-panel" aria-live="polite">
      <span class="result-label">{copy.label}</span>
      <div class="result-name" data-role="result-name">—</div>
      <p class="result-reason" data-role="result-reason">—</p>
      <div class="result-metrics">
        <div class="result-metric"><span>{copy.payback}</span><strong data-role="result-payback">—</strong></div>
        <div class="result-metric"><span>{copy.income}</span><strong class="teal" data-role="result-income">—</strong></div>
        <div class="result-metric"><span>{copy.setup}</span><strong data-role="result-setup">—</strong></div>
        <div class="result-metric"><span>{copy.fit}</span><strong class="magenta" data-role="result-fit">—</strong></div>
      </div>
      <div class="alternatives" data-role="alternatives" aria-label={copy.alternatives}></div>
      <ScenarioActions lang={lang} />
    </article>
  </div>
</section>

<script>
  import { gtaBusinesses, type DecisionPriority, type Locale } from "../data/gta-businesses";
  import { recommendBusinesses } from "../lib/economy";

  const root = document.querySelector<HTMLElement>("#next-move");

  if (root) {
    const lang = (root.dataset.lang ?? "ru") as Locale;
    const form = root.querySelector<HTMLFormElement>("[data-role='decision-form']")!;
    const profile = root.querySelector<HTMLSelectElement>("[data-role='profile']")!;
    const budget = root.querySelector<HTMLInputElement>("[data-role='budget']")!;
    const hours = root.querySelector<HTMLInputElement>("[data-role='hours']")!;
    const priority = root.querySelector<HTMLSelectElement>("[data-role='priority']")!;
    const friction = root.querySelector<HTMLSelectElement>("[data-role='friction']")!;
    const resultName = root.querySelector<HTMLElement>("[data-role='result-name']")!;
    const resultReason = root.querySelector<HTMLElement>("[data-role='result-reason']")!;
    const resultPayback = root.querySelector<HTMLElement>("[data-role='result-payback']")!;
    const resultIncome = root.querySelector<HTMLElement>("[data-role='result-income']")!;
    const resultSetup = root.querySelector<HTMLElement>("[data-role='result-setup']")!;
    const resultFit = root.querySelector<HTMLElement>("[data-role='result-fit']")!;
    const alternatives = root.querySelector<HTMLElement>("[data-role='alternatives']")!;
    const storageKey = "money-meta:gta-profile:v1";

    const text = lang === "ru" ? {
      empty: "Пока ничего не подходит",
      emptyReason: "Увеличь бюджет или допустимый friction — Money Meta не будет советовать недоступный актив.",
      alternatives: "Альтернативы",
      hours: "ч производства"
    } : {
      empty: "Nothing fits yet",
      emptyReason: "Increase the budget or friction tolerance. Money Meta will not recommend an unavailable asset.",
      alternatives: "Alternatives",
      hours: "production h"
    };

    const formatter = new Intl.NumberFormat(lang === "ru" ? "ru-RU" : "en-US", { maximumFractionDigits: 0 });
    const money = (value: number) => `$${formatter.format(Math.round(value))}`;

    function readInput() {
      return {
        budget: Math.max(0, Number(budget.value) || 0),
        weeklyHours: Math.max(1, Number(hours.value) || 1),
        priority: priority.value as DecisionPriority,
        maxFriction: Math.max(1, Number(friction.value) || 10)
      };
    }

    function render() {
      const recommendations = recommendBusinesses(gtaBusinesses, readInput());
      const best = recommendations[0];
      alternatives.replaceChildren();

      if (!best) {
        resultName.closest<HTMLElement>(".result-panel")!.dataset.state = "negative";
        resultName.textContent = text.empty;
        resultReason.textContent = text.emptyReason;
        resultPayback.textContent = "—";
        resultIncome.textContent = "—";
        resultSetup.textContent = "—";
        resultFit.textContent = "—";
        return;
      }

      resultName.closest<HTMLElement>(".result-panel")!.dataset.state = best.score >= 70 ? "positive" : "caution";
      resultName.textContent = best.business.name[lang];
      resultReason.textContent = best.business.summary[lang];
      resultPayback.textContent = `${formatter.format(Math.round(best.metrics.paybackProductionHours))} ${text.hours}`;
      resultIncome.textContent = money(best.metrics.profitPerProductionHour);
      resultSetup.textContent = money(best.business.setupCost);
      resultFit.textContent = `${Math.round(best.score)}/100`;

      if (recommendations.length > 1) {
        const heading = document.createElement("span");
        heading.className = "result-label";
        heading.style.marginTop = "4px";
        heading.textContent = text.alternatives;
        alternatives.appendChild(heading);
      }

      recommendations.slice(1, 3).forEach((item) => {
        const row = document.createElement("div");
        row.className = "alternative";
        const name = document.createElement("span");
        name.textContent = item.business.name[lang];
        const fit = document.createElement("strong");
        fit.textContent = `${Math.round(item.score)}/100`;
        row.append(name, fit);
        alternatives.appendChild(row);
      });
    }

    function save() {
      localStorage.setItem(storageKey, JSON.stringify({
        profile: profile.value,
        budget: budget.value,
        hours: hours.value,
        priority: priority.value,
        friction: friction.value
      }));
    }

    function restore() {
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) ?? "null");
        if (!saved) return;
        profile.value = saved.profile ?? profile.value;
        budget.value = saved.budget ?? budget.value;
        hours.value = saved.hours ?? hours.value;
        priority.value = saved.priority ?? priority.value;
        friction.value = saved.friction ?? friction.value;
      } catch {
        localStorage.removeItem(storageKey);
      }
    }

    profile.addEventListener("change", () => {
      if (profile.value === "casual") {
        priority.value = "low-friction";
        friction.value = "4";
        hours.value = "4";
      } else if (profile.value === "grinder") {
        priority.value = "max-income";
        friction.value = "10";
        hours.value = "15";
      } else {
        priority.value = "fast-payback";
        friction.value = "6";
        hours.value = "6";
      }
      save();
      render();
    });

    [budget, hours, priority, friction].forEach((control) => {
      control.addEventListener("input", () => { save(); render(); });
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      save();
      render();
      window.dispatchEvent(new CustomEvent("money-meta:decision-completed", { detail: readInput() }));
    });

    restore();
    render();
  }
</script>
