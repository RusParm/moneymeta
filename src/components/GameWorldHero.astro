---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt?: string;
  worldCode: string;
}

const { image, alt = "", worldCode } = Astro.props;
---

<section class="hero vertical-hero cinematic-hero">
  <Image
    class="cinematic-hero-art"
    src={image}
    alt={alt}
    widths={[640, 960, 1280, 1672]}
    sizes="(max-width: 1180px) calc(100vw - 40px), 1180px"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="cinematic-hero-content">
    <slot />
  </div>
  <div class="world-stamp" aria-hidden="true">
    <span>Money Meta original</span>
    <strong>{worldCode}</strong>
  </div>
</section>
