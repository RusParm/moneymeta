---
import { wowEconomyNodes } from "../data/wow-hub";
import { migrateHubHref } from "../lib/hub-links";
import WowMarketMark from "./WowMarketMark.astro";

interface Props { lang: "ru" | "en"; }
const { lang } = Astro.props;
const first = wowEconomyNodes[0]!;
const hrefFor = (href: string) => migrateHubHref("wow", lang, href);

const copy = lang === "ru" ? {
  kicker: "Карта экономики · оборот капитала",
  title: "Проследи путь одной монеты: от материала до следующего рыночного цикла",
  text: "Экономика WoW Retail работает как цепочка оборотного капитала. Материалы становятся товаром, товар проходит через рынок, а следующий ход финансирует только реально полученное золото.",
  label: "Интерактивная карта экономики WoW Retail",
  signal: "Ключевой сигнал",
  decision: "Решение игрока",
  open: "Открыть связанный инструмент"
} : {
  kicker: "Economy map · market flywheel",
  title: "Follow one gold from reagent to the next market cycle",
  text: "WoW Retail is a working-capital chain. Materials become stock, stock passes through the market, and only realized cash funds the next move.",
  label: "Interactive WoW Retail economy map",
  signal: "Key signal",
  decision: "Player decision",
  open: "Open the connected tool"
};
---

<section id="economy-map" class="section hub-section hub-map-section" aria-labelledby="wow-economy-map-title">
  <div class="section-head hub-section-head">
    <div>
      <span class="section-kicker">{copy.kicker}</span>
      <h2 id="wow-economy-map-title">{copy.title}</h2>
      <p class="section-copy">{copy.text}</p>
    </div>
    <span class="count">{lang === "ru" ? "01-07 · интерактивная карта" : "01-07 · interactive"}</span>
  </div>

  <div class="economy-map wow-economy-map" data-wow-map>
    <div class="economy-flow" aria-label={copy.label}>
      {wowEconomyNodes.map((node, index) => (
        <button
          class="economy-node wow-economy-node"
          type="button"
          aria-pressed={index === 0 ? "true" : "false"}
          data-map-node
          data-code={node.code}
          data-title={node.title[lang]}
          data-phase={node.phase[lang]}
          data-summary={node.summary[lang]}
          data-decision={node.decision[lang]}
          data-signal={node.signal[lang]}
          data-href={hrefFor(node.href)}
          data-mark={node.mark.code[lang]}
          data-tone={node.mark.tone}
          data-glyph={node.mark.glyph}
          data-mark-label={node.mark.label[lang]}
        >
          <WowMarketMark mark={node.mark} lang={lang} />
          <span class="economy-node-index">{node.code}</span>
          <span class="economy-node-copy"><small>{node.phase[lang]}</small><strong>{node.title[lang]}</strong></span>
          <span class="economy-node-pulse" aria-hidden="true"></span>
        </button>
      ))}
    </div>

    <article class="economy-detail wow-economy-detail" aria-live="polite">
      <div class="economy-detail-top">
        <span class="economy-detail-code" data-map-code>{first.code}</span>
        <WowMarketMark mark={first.mark} lang={lang} large />
        <span class="pill teal" data-map-phase>{first.phase[lang]}</span>
      </div>
      <h3 data-map-title>{first.title[lang]}</h3>
      <p data-map-summary>{first.summary[lang]}</p>
      <div class="economy-detail-grid">
        <div><span>{copy.signal}</span><strong data-map-signal>{first.signal[lang]}</strong></div>
        <div><span>{copy.decision}</span><strong data-map-decision>{first.decision[lang]}</strong></div>
      </div>
      <a class="map-tool-link" data-map-link href={hrefFor(first.href)}>{copy.open} →</a>
    </article>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-wow-map]").forEach((root) => {
    const nodes = [...root.querySelectorAll<HTMLButtonElement>("[data-map-node]")];
    const code = root.querySelector<HTMLElement>("[data-map-code]")!;
    const phase = root.querySelector<HTMLElement>("[data-map-phase]")!;
    const title = root.querySelector<HTMLElement>("[data-map-title]")!;
    const summary = root.querySelector<HTMLElement>("[data-map-summary]")!;
    const signal = root.querySelector<HTMLElement>("[data-map-signal]")!;
    const decision = root.querySelector<HTMLElement>("[data-map-decision]")!;
    const link = root.querySelector<HTMLAnchorElement>("[data-map-link]")!;
    const mark = root.querySelector<HTMLElement>(".wow-economy-detail .wow-market-mark")!;
    const glyph = mark.querySelector<HTMLElement>("i")!;
    const markCode = mark.querySelector<HTMLElement>("small")!;

    const select = (node: HTMLButtonElement) => {
      nodes.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === node)));
      code.textContent = node.dataset.code ?? "";
      phase.textContent = node.dataset.phase ?? "";
      title.textContent = node.dataset.title ?? "";
      summary.textContent = node.dataset.summary ?? "";
      signal.textContent = node.dataset.signal ?? "";
      decision.textContent = node.dataset.decision ?? "";
      link.href = node.dataset.href ?? "#";
      mark.className = `wow-market-mark is-large tone-${node.dataset.tone ?? "arcane"}`;
      mark.setAttribute("aria-label", node.dataset.markLabel ?? "");
      glyph.textContent = node.dataset.glyph ?? "";
      markCode.textContent = node.dataset.mark ?? "";
    };

    nodes.forEach((node) => node.addEventListener("click", () => select(node)));
  });
</script>
