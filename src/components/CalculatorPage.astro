---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "./BrandHeader.astro";
import BusinessCalculator from "./BusinessCalculator.astro";
import NextMove from "./NextMove.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props { lang: "ru" | "en"; }
const { lang } = Astro.props;
const root = lang === "ru" ? "/gta-online/" : "/en/gta-online/";
const path = `${root}calculators/business-roi/`;

const copy = lang === "ru" ? {
  title: "Калькулятор бизнесов GTA Online — Money Meta",
  description: "Персональная рекомендация, ROI, окупаемость, сравнение и оптимизация портфеля бизнесов GTA Online.",
  back: "← GTA Online Hub",
  eyebrow: "GTA Online · Decision Toolkit",
  heading: "Не просто считай прибыль. Принимай следующий ход.",
  lede: "Сначала получи персональную рекомендацию под свой капитал и время. Затем раскрой модель, измени допущения и собери портфель — без магических tier list и скрытых цифр.",
  start: "Подобрать следующий ход",
  inspect: "Открыть Model Lab",
  heroProof: [["1", "персональный next move"], ["7", "сравнимых активов"], ["2", "optimizers"], ["Share", "сценарные ссылки"]]
} : {
  title: "GTA Online Business Calculator — Money Meta",
  description: "Get a personal recommendation, ROI, payback, comparison and GTA Online business portfolio optimization.",
  back: "← GTA Online Hub",
  eyebrow: "GTA Online · Decision Toolkit",
  heading: "Do not just calculate profit. Make the next move.",
  lede: "Start with a personal recommendation for your capital and time. Then inspect the model, edit assumptions and build a portfolio without magic tier lists or hidden numbers.",
  start: "Find my next move",
  inspect: "Open Model Lab",
  heroProof: [["1", "personal next move"], ["7", "comparable assets"], ["2", "optimizers"], ["Share", "scenario links"]]
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={path}
  alternatePath={lang === "ru" ? "/en/gta-online/calculators/business-roi/" : "/gta-online/calculators/business-roi/"}
  schema={{
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: copy.title,
    description: copy.description,
    applicationCategory: "GameApplication",
    operatingSystem: "Web",
    isAccessibleForFree: true,
    about: { "@type": "VideoGame", name: "Grand Theft Auto Online" }
  }}
>
  <main class="page">
    <div class="shell">
      <BrandHeader lang={lang} ruPath="/gta-online/calculators/business-roi/" enPath="/en/gta-online/calculators/business-roi/" backPath={root} backLabel={copy.back} />

      <section class="hero">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1 style="font-size:clamp(40px,6vw,66px)">{copy.heading}</h1>
        <p class="lede">{copy.lede}</p>
        <div class="hero-actions">
          <a class="button primary" href="#next-move">{copy.start} →</a>
          <a class="button ghost" href="#model-lab">{copy.inspect}</a>
        </div>
        <div class="proof-strip">
          {copy.heroProof.map(([value, label]) => <div class="proof-item"><strong>{value}</strong><span>{label}</span></div>)}
        </div>
      </section>

      <NextMove lang={lang} />
      <BusinessCalculator lang={lang} />
      <SiteFooter lang={lang} />
    </div>
  </main>
</BaseLayout>
