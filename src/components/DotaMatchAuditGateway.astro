---
import { dotaMatchAuditConfig, getDotaMatchAuditPath } from "../data/dota-match";
import type { DotaItemsLocale } from "../data/dota-items";
import "../styles/dota-match-audit.css";

interface Props { lang: DotaItemsLocale; }
const { lang } = Astro.props;
const copy = lang === "ru" ? {
  kicker: "Разбор матча · публичный Match ID",
  title: "Найди эпизод, который стоит пересмотреть.",
  text: "Сравни золото с выбранным соперником и командой. При полной хронологии Money Meta выделит три минуты внутри заметного отставания и покажет, что проверить в повторе.",
  action: "Разобрать мой матч",
  request: "Запрос",
  requestValue: "только по клику",
  identity: "Личность",
  identityValue: "имена скрыты",
  result: "Результат",
  resultValue: "эпизод для проверки"
} : {
  kicker: "Match audit · public Match ID",
  title: "Find the episode worth watching again.",
  text: "Compare your gold with a chosen opponent and both teams. With complete timelines, Money Meta narrows a material decline to three observed minutes and shows what to check in the replay.",
  action: "Audit my match",
  request: "Request",
  requestValue: "click only",
  identity: "Identity",
  identityValue: "names hidden",
  result: "Output",
  resultValue: "one replay episode"
};
---

<section class="section hub-section dota-match-audit-gateway" aria-labelledby="dota-match-audit-gateway-title">
  <div>
    <span>{copy.kicker}</span>
    <h2 id="dota-match-audit-gateway-title">{copy.title}</h2>
    <p>{copy.text}</p>
    <a class="button primary button-large" href={getDotaMatchAuditPath(lang)}>{copy.action} →</a>
  </div>
  <aside>
    <span>OpenDota · {dotaMatchAuditConfig.checkedAt}</span>
    <div><small>{copy.request}</small><strong>{copy.requestValue}</strong></div>
    <div><small>{copy.identity}</small><strong>{copy.identityValue}</strong></div>
    <div><small>{copy.result}</small><strong>{copy.resultValue}</strong></div>
  </aside>
</section>
