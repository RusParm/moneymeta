---
interface Props {
  lang: "ru" | "en";
  ruPath: string;
  enPath: string;
  backPath?: string;
  backLabel?: string;
}

const { lang, ruPath, enPath, backPath, backLabel } = Astro.props;
---

<header class="topbar">
  <a class="brand" href={lang === "ru" ? "/" : "/en/"} aria-label="Money Meta home">
    <span class="brand-mark" aria-hidden="true">$</span>
    <span class="brand-name">Money<span class="magenta">Meta</span></span>
  </a>
  <div class="topbar-actions">
    {backPath && <a class="version" href={backPath}>{backLabel}</a>}
    <span class="version">Beta · v0.3</span>
    <nav class="lang-switch" aria-label="Language">
      <a href={ruPath} aria-current={lang === "ru" ? "page" : undefined}>RU</a>
      <a href={enPath} aria-current={lang === "en" ? "page" : undefined}>EN</a>
    </nav>
  </div>
</header>
