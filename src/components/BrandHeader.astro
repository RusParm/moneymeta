---
interface Props {
  lang: "ru" | "en";
  ruPath: string;
  enPath: string;
  backPath?: string;
  backLabel?: string;
}

const { lang, ruPath, enPath, backPath, backLabel } = Astro.props;
const currentPath = Astro.url.pathname;
const links = [
  { id: "home", label: lang === "ru" ? "Обзор" : "Overview", href: lang === "ru" ? "/" : "/en/" },
  { id: "gta", label: "GTA Online", href: lang === "ru" ? "/gta-online/" : "/en/gta-online/" },
  { id: "dota", label: "Dota 2", href: lang === "ru" ? "/dota-2/" : "/en/dota-2/" },
  { id: "wow", label: "WoW Retail", href: lang === "ru" ? "/wow/" : "/en/wow/" },
  { id: "insights", label: lang === "ru" ? "Разборы" : "Field Notes", href: lang === "ru" ? "/insights/" : "/en/insights/" }
];
const active = currentPath.includes("insights") ? "insights" : currentPath.includes("gta-online") ? "gta" : currentPath.includes("dota-2") ? "dota" : currentPath.includes("wow") ? "wow" : "home";
---

<div class="site-chrome">
  <header class="topbar">
    <a class="brand" href={lang === "ru" ? "/" : "/en/"} aria-label="Money Meta home">
      <span class="brand-mark" aria-hidden="true">$</span>
      <span class="brand-name">Money<span class="magenta">Meta</span></span>
    </a>
    <div class="topbar-actions">
      {backPath && <a class="version back-link" href={backPath}>{backLabel}</a>}
      <nav class="lang-switch" aria-label="Language">
        <a href={ruPath} aria-current={lang === "ru" ? "page" : undefined}>RU</a>
        <a href={enPath} aria-current={lang === "en" ? "page" : undefined}>EN</a>
      </nav>
    </div>
  </header>
  <nav class="economy-nav" aria-label={lang === "ru" ? "Экономики" : "Economies"}>
    {links.map((link) => <a href={link.href} class={`economy-link economy-${link.id}`} aria-current={active === link.id ? "page" : undefined}><span></span>{link.label}</a>)}
  </nav>
</div>
