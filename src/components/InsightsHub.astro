---
import { insightGameLabels, insights, type InsightLocale } from "../data/insights";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "./BrandHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import "../styles/gta-vi.css";
import "../styles/insight-library.css";

interface Props { lang: InsightLocale; }
const { lang } = Astro.props;
const prefix = lang === "ru" ? "" : "/en";
const path = `${prefix}/insights/`;
const availableGames = [...new Set(insights.map((insight) => insight.game))];
const copy = lang === "ru" ? {
  title: "Разборы игровых экономик Money Meta",
  description: "Практические разборы пяти живых игровых экономик и дорелизное досье GTA VI с официальным контекстом, моделями и конкретным следующим действием.",
  back: "← Главная",
  kicker: "Прикладные разборы · решения, а не новости",
  heading: "Разбираем экономику игры до конкретного действия.",
  lede: "Каждый материал отвечает на один вопрос игрока, показывает расчёт и заканчивается моделью, которую можно пересчитать под себя.",
  featured: "Найди ответ на свой вопрос",
  read: "Читать разбор"
} : {
  title: "Money Meta Field Notes - game economy analysis",
  description: "Practical analysis across five live game economies and a pre-release GTA VI dossier with primary context, models and a concrete next action.",
  back: "← Home",
  kicker: "Field Notes · decisions, not news",
  heading: "Take a game economy all the way to an action.",
  lede: "Every note answers one player question, shows the calculation and ends with a model you can rerun for your own case.",
  featured: "Find an answer to your question",
  read: "Read the analysis"
};
---

<BaseLayout title={copy.title} description={copy.description} lang={lang} canonicalPath={path} alternatePath={lang === "ru" ? "/en/insights/" : "/insights/"}>
  <main class="page insights-hub">
    <div class="shell">
      <BrandHeader lang={lang} ruPath="/insights/" enPath="/en/insights/" backPath={lang === "ru" ? "/" : "/en/"} backLabel={copy.back} />
      <section class="insights-hero">
        <p class="eyebrow">{copy.kicker}</p>
        <h1>{copy.heading}</h1>
        <p class="lede">{copy.lede}</p>
      </section>
      <section class="section" data-insight-library>
        <div class="section-head"><div><span class="section-kicker">{copy.featured}</span><h2>{lang === "ru" ? "Библиотека разборов" : "Analysis library"}</h2></div><span class="count">{insights.length} {lang === "ru" ? "материалов · RU/EN" : "notes · RU/EN"}</span></div>
        <div class="insight-library-filters" data-library-controls hidden>
          <label>{lang === "ru" ? "Название или тема" : "Title or topic"}<input type="search" data-library-search maxlength="120" placeholder={lang === "ru" ? "Например, Midas или казна" : "For example, Midas or treasury"} /></label>
          <label>{lang === "ru" ? "Игра" : "Game"}<select data-library-game><option value="all">{lang === "ru" ? "Все игры" : "All games"}</option>{availableGames.map((game) => <option value={game}>{insightGameLabels[game]}</option>)}</select></label>
          <button type="button" class="mini-action" data-library-reset>{lang === "ru" ? "Сбросить фильтры" : "Clear filters"}</button>
        </div>
        <p class="insight-library-status" role="status" data-library-status hidden></p>
        <p class="insight-library-empty" data-library-empty hidden>{lang === "ru" ? "Подходящих материалов нет. Попробуй другое слово или выбери все игры." : "No matching notes. Try another word or select all games."}</p>
        <div class="insight-card-grid">
          {insights.map((insight, index) => {
            const content = insight.content[lang];
            const game = insightGameLabels[insight.game];
            return <a class={`insight-card insight-card-${insight.game}`} href={`${prefix}/insights/${insight.slug}/`} data-insight-card data-insight-game={insight.game} data-insight-search={[game, content.title, content.description, content.kicker, content.toolLabel].join(" ")}>
              <div class="insight-card-top"><span>{game}</span><b>{String(index + 1).padStart(2, "0")}</b></div>
              <div><span class="game-tag">{content.kicker}</span><h2>{content.title}</h2><p>{content.description}</p></div>
              <div class="insight-card-foot"><span>{content.readTime} · {insight.updatedAt}<br />{lang === "ru" ? (insight.evidenceStatus === "verified" ? "проверено" : "оценка") : insight.evidenceStatus} · {insight.gameVersion[lang]}</span><strong>{copy.read} ↗</strong></div>
            </a>;
          })}
        </div>
        <button type="button" class="mini-action insight-library-more" data-library-more hidden>{lang === "ru" ? "Показать ещё" : "Show more"}</button>
      </section>
      <SiteFooter lang={lang} />
    </div>
  </main>
</BaseLayout>

<script>
  import { initializeInsightLibrary } from "../lib/insight-library";
  initializeInsightLibrary();
</script>
