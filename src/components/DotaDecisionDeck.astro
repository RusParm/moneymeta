---
import { dotaScenarios } from "../data/dota-hub";
import { dotaPatchContext } from "../data/dota-economy";
import DotaMedia from "./DotaMedia.astro";

interface Props { lang: "ru" | "en"; }
const { lang } = Astro.props;

const kindLabel = lang === "ru" ? {
  farm: "Возможности фарма",
  timing: "Время покупки",
  utility: "Польза для команды",
  objective: "Реализация преимущества",
  review: "Разбор повтора",
  midas: "Окно для жадной покупки",
  sensitivity: "Проверка допущений",
  buyback: "Запас на выкуп"
} : {
  farm: "Farm capacity",
  timing: "Timing allocation",
  utility: "Team utility",
  objective: "Objective conversion",
  review: "Replay review",
  midas: "Greed window",
  sensitivity: "Sensitivity",
  buyback: "Liquidity reserve"
};

const copy = lang === "ru" ? {
  kicker: "Восемь решений во время матча",
  title: "В Dota нет одного экономического вопроса.",
  text: "Выбери реальную развилку матча: где фармить, когда перестать жадничать, как использовать новый предмет, сохранять ли золото на выкуп и что проверить в повторе.",
  cta: "Открыть сценарий"
} : {
  kicker: "Decision deck · eight match decisions",
  title: "Dota never has only one economic question.",
  text: "Choose the actual match fork: where to farm, when greed must end, how to convert a timing, whether to hold buyback or what to test in the replay.",
  cta: "Open scenario"
};
---

<section id="decision-deck" class="section hub-section" aria-labelledby="dota-decision-deck-title">
  <div class="section-head hub-section-head">
    <div>
      <span class="section-kicker">{copy.kicker}</span>
      <h2 id="dota-decision-deck-title">{copy.title}</h2>
      <p class="section-copy">{copy.text}</p>
    </div>
    <span class="count">{lang === "ru" ? "8 решений · калькуляторы и разборы" : "8 decisions · calculators + playbooks"}</span>
  </div>

  <div class="decision-deck-grid dota-decision-deck">
    {dotaScenarios.map((scenario, index) => (
      <a class={`decision-deck-card dota-decision-card ${scenario.featured ? "is-featured" : ""}`} href={scenario.href[lang]}>
        <div class="decision-deck-top">
          <span>0{index + 1} · {kindLabel[scenario.kind]}</span>
          <DotaMedia asset={scenario.media} lang={lang} />
        </div>
        <div>
          <span class="game-tag">Dota 2 · {dotaPatchContext.patch}</span>
          <h3>{scenario.title[lang]}</h3>
          <p>{scenario.text[lang]}</p>
        </div>
        <strong>{copy.cta} →</strong>
      </a>
    ))}
  </div>
</section>
