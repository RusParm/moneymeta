---
import gtaEconomyWorld from "../assets/game-worlds/gta-economy-world.webp";
import { gtaBusinesses, weeklyMeta } from "../data/gta-businesses";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "./BrandHeader.astro";
import GameWorldHero from "./GameWorldHero.astro";
import GtaDecisionDeck from "./GtaDecisionDeck.astro";
import GtaEconomyMap from "./GtaEconomyMap.astro";
import GtaLibrary from "./GtaLibrary.astro";
import GtaPlayerPaths from "./GtaPlayerPaths.astro";
import GtaPulse from "./GtaPulse.astro";
import GtaRankings from "./GtaRankings.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props { lang: "ru" | "en"; }
const { lang } = Astro.props;
const root = lang === "ru" ? "/gta-online/" : "/en/gta-online/";
const calculator = root + "calculators/business-roi/";

const copy = lang === "ru" ? {
  title: "GTA Online Economy Hub - карта экономики, мета и калькуляторы | Money Meta",
  description: "Полноценная карта экономики GTA Online: персональные маршруты, официальный Weekly Pulse, условные рейтинги бизнесов, сценарии и библиотека разборов.",
  back: "← Все экономики",
  eyebrow: "GTA Online · Living Economy Hub",
  heading: "Los Santos - это портфель. Управляй им как системой.",
  lede: "Проследи путь капитала, выбери маршрут под свой стиль и проверь следующий ход на цифрах. Не ещё один tier list - живая модель того, где деньги входят, застревают и возвращаются.",
  primary: "Выбрать мой путь",
  secondary: "Увидеть карту экономики",
  heroProof: [
    ["7", "активов в модели"],
    ["3", "пути игрока"],
    ["6", "полных разборов"],
    ["Auto", "freshness guard"]
  ],
  navLabel: "Навигация по GTA Economy Hub",
  nav: [
    ["Карта", "#economy-map"],
    ["Мой путь", "#player-paths"],
    ["Pulse", "#weekly-pulse"],
    ["Рейтинги", "#conditional-rankings"],
    ["Сценарии", "#scenario-deck"],
    ["Библиотека", "#research-library"]
  ],
  manifestoEyebrow: "The Money Meta difference",
  manifestoTitle: "Каждая цифра должна закончиться действием.",
  manifestoText: "Гайд говорит, что популярно. Money Meta показывает, что подходит твоему банку, времени и допустимой возне - и где ответ перестаёт быть верным.",
  manifestoPoints: [
    ["Capital", "Сколько GTA$ реально можно заморозить"],
    ["Time", "Production-hours отдельно от active grind"],
    ["Friction", "Сможешь ли ты повторять цикл каждую неделю"],
    ["Freshness", "Бонус исчезает из current, когда окно закрыто"]
  ],
  trustKicker: "Trust rail · method before confidence",
  trustTitle: "Где факт, где модель и где твоё решение",
  trustText: "Money Meta не маскирует рабочие оценки под официальные цифры. Источник, дата, версия и ограничение остаются рядом с выводом.",
  trustCards: [
    {
      label: "Production dataset",
      status: "Estimated",
      title: "Редактируемая рабочая модель",
      text: "Семь активов проверены как единый estimate set. Setup, sale, supplies и production time можно заменить своими значениями.",
      meta: "Checked · 2026-07-01"
    },
    {
      label: "Weekly Pulse",
      status: "Verified",
      title: "Официальный источник и срок",
      text: "Текущие события привязаны к конкретному Rockstar Newswire и автоматически переходят в архив после valid-through.",
      meta: "Checked · " + weeklyMeta.checkedAt
    },
    {
      label: "Independence",
      status: "Independent",
      title: "Никакой скрытой аффилиации",
      text: "Money Meta - независимый аналитический продукт. Он не связан с Rockstar Games и не строится на читах, продаже аккаунтов или нарушении правил.",
      meta: "Owned visuals · transparent models"
    }
  ],
  source: "Официальный Weekly-источник",
  fullModel: "Открыть полный Calculator Suite"
} : {
  title: "GTA Online Economy Hub - economy map, meta and calculators | Money Meta",
  description: "A complete GTA Online economy map with personal routes, official Weekly Pulse, conditional business rankings, scenarios and a deep research library.",
  back: "← All economies",
  eyebrow: "GTA Online · Living Economy Hub",
  heading: "Los Santos is a portfolio. Run it as a system.",
  lede: "Follow the capital, choose a route for your play style and test the next move against the numbers. Not another tier list - a living model of where money enters, gets trapped and comes back.",
  primary: "Choose my path",
  secondary: "See the economy map",
  heroProof: [
    ["7", "modeled assets"],
    ["3", "player paths"],
    ["6", "complete analyses"],
    ["Auto", "freshness guard"]
  ],
  navLabel: "GTA Economy Hub navigation",
  nav: [
    ["Map", "#economy-map"],
    ["My path", "#player-paths"],
    ["Pulse", "#weekly-pulse"],
    ["Rankings", "#conditional-rankings"],
    ["Scenarios", "#scenario-deck"],
    ["Library", "#research-library"]
  ],
  manifestoEyebrow: "The Money Meta difference",
  manifestoTitle: "Every number should end in an action.",
  manifestoText: "A guide tells you what is popular. Money Meta shows what fits your bank, time and friction tolerance - and where the answer stops being true.",
  manifestoPoints: [
    ["Capital", "How much GTA$ can actually be locked up"],
    ["Time", "Production hours separated from active grind"],
    ["Friction", "Whether the loop can be repeated every week"],
    ["Freshness", "A bonus loses current status when its window closes"]
  ],
  trustKicker: "Trust rail · method before confidence",
  trustTitle: "Know what is fact, model and personal judgement",
  trustText: "Money Meta never disguises working estimates as official numbers. Source, date, version and limitation stay next to the conclusion.",
  trustCards: [
    {
      label: "Production dataset",
      status: "Estimated",
      title: "Editable working model",
      text: "Seven assets are checked as one estimate set. Setup, sale, supplies and production time can be replaced with your own values.",
      meta: "Checked · 2026-07-01"
    },
    {
      label: "Weekly Pulse",
      status: "Verified",
      title: "Official source and expiry",
      text: "Current events are tied to one Rockstar Newswire source and automatically move to archive after valid-through.",
      meta: "Checked · " + weeklyMeta.checkedAt
    },
    {
      label: "Independence",
      status: "Independent",
      title: "No hidden affiliation",
      text: "Money Meta is an independent analysis product. It is not affiliated with Rockstar Games and does not promote cheats, account sales or rule-breaking.",
      meta: "Owned visuals · transparent models"
    }
  ],
  source: "Official weekly source",
  fullModel: "Open the full Calculator Suite"
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={root}
  alternatePath={lang === "ru" ? "/en/gta-online/" : "/gta-online/"}
  schema={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: copy.title,
    about: { "@type": "VideoGame", name: "Grand Theft Auto Online", publisher: "Rockstar Games" },
    description: copy.description,
    inLanguage: lang,
    hasPart: [
      { "@type": "SoftwareApplication", name: "GTA Online Next Best Move", applicationCategory: "GameApplication" },
      { "@type": "ItemList", name: "Conditional GTA Online business rankings", numberOfItems: gtaBusinesses.length }
    ]
  }}
>
  <main class="page game-page game-gta gta-living-hub">
    <div class="shell">
      <BrandHeader lang={lang} ruPath="/gta-online/" enPath="/en/gta-online/" backPath={lang === "ru" ? "/" : "/en/"} backLabel={copy.back} />

      <GameWorldHero
        image={gtaEconomyWorld}
        alt={lang === "ru" ? "Оригинальная иллюстрация Money Meta: ночной город и сеть денежных потоков GTA Online" : "Original Money Meta illustration of a night city and GTA Online cash-flow network"}
        worldCode="CITY NETWORK / 01"
      >
        <div class="hero-live-line"><span></span>Portfolio economy · active model</div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="lede">{copy.lede}</p>
        <div class="hero-actions">
          <a class="button primary button-large" href="#player-paths">{copy.primary} →</a>
          <a class="button ghost button-large" href="#economy-map">{copy.secondary}</a>
        </div>
        <div class="proof-strip">
          {copy.heroProof.map(([value, label]) => <div class="proof-item"><strong>{value}</strong><span>{label}</span></div>)}
        </div>
      </GameWorldHero>

      <nav class="hub-jump-nav" aria-label={copy.navLabel}>
        <span class="hub-jump-brand"><i aria-hidden="true"></i>GTA / ECONOMY OS</span>
        <div>
          {copy.nav.map(([label, href], index) => <a href={href}><span>0{index + 1}</span>{label}</a>)}
        </div>
      </nav>

      <section class="hub-manifesto" aria-labelledby="hub-manifesto-title">
        <div>
          <span class="section-kicker">{copy.manifestoEyebrow}</span>
          <h2 id="hub-manifesto-title">{copy.manifestoTitle}</h2>
          <p>{copy.manifestoText}</p>
        </div>
        <div class="manifesto-grid">
          {copy.manifestoPoints.map(([label, text], index) => (
            <div><span>0{index + 1}</span><strong>{label}</strong><p>{text}</p></div>
          ))}
        </div>
      </section>

      <GtaEconomyMap lang={lang} />
      <GtaPlayerPaths lang={lang} />
      <GtaPulse lang={lang} />
      <GtaRankings lang={lang} />
      <GtaDecisionDeck lang={lang} />
      <GtaLibrary lang={lang} />

      <section id="methodology" class="section hub-section trust-rail" aria-labelledby="trust-rail-title">
        <div class="section-head hub-section-head">
          <div>
            <span class="section-kicker">{copy.trustKicker}</span>
            <h2 id="trust-rail-title">{copy.trustTitle}</h2>
            <p class="section-copy">{copy.trustText}</p>
          </div>
          <a class="button ghost" href={calculator}>{copy.fullModel} →</a>
        </div>
        <div class="trust-grid">
          {copy.trustCards.map((card, index) => (
            <article class="trust-card">
              <div><span>0{index + 1} · {card.label}</span><span class={index === 1 ? "pill teal" : index === 0 ? "pill gold" : "pill muted"}>{card.status}</span></div>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
              <small>{card.meta}</small>
              {index === 1 && <a class="source-link" href={weeklyMeta.sourceUrl} target="_blank" rel="noopener noreferrer">{copy.source} ↗</a>}
            </article>
          ))}
        </div>
      </section>

      <SiteFooter lang={lang} />
    </div>
  </main>
</BaseLayout>
