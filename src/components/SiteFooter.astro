---
import UpdatesCta from "./UpdatesCta.astro";
interface Props { lang: "ru" | "en"; }
const { lang } = Astro.props;
---

<footer class="footer">
  <UpdatesCta lang={lang} />
  <div class="footer-status">
    <span class="console-signal">Money Meta · {lang === "ru" ? "Работает" : "Live"}</span>
    <span>{lang === "ru" ? "5 живых экономик · досье GTA VI · 16 моделей · RU/EN" : "5 live economies · GTA VI dossier · 16 models · RU/EN"}</span>
  </div>
  <div class="footer-grid">
    <p>
      {lang === "ru"
        ? "Money Meta является независимым аналитическим проектом. Он не связан с Rockstar Games, Take-Two Interactive, Valve, Blizzard Entertainment, Creative Assembly, SEGA, Paradox Interactive или другими издателями. Расчёты являются оценками игровых механик, а не официальными данными."
        : "Money Meta is an independent analytics project. It is not affiliated with Rockstar Games, Take-Two Interactive, Valve, Blizzard Entertainment, Creative Assembly, SEGA, Paradox Interactive or other publishers. Calculations are estimates of game mechanics, not official publisher data."}
    </p>
    <nav class="footer-nav" aria-label={lang === "ru" ? "Экономики" : "Economies"}>
      <a href={lang === "ru" ? "/gta-online/" : "/en/gta-online/"}>GTA Online</a>
      <a href={lang === "ru" ? "/gta-6/" : "/en/gta-6/"}>GTA VI</a>
      <a href={lang === "ru" ? "/dota-2/" : "/en/dota-2/"}>Dota 2</a>
      <a href={lang === "ru" ? "/wow/" : "/en/wow/"}>WoW Retail</a>
      <a href={lang === "ru" ? "/total-war/" : "/en/total-war/"}>Total War</a>
      <a href={lang === "ru" ? "/crusader-kings-3/" : "/en/crusader-kings-3/"}>Crusader Kings III</a>
      <a href={lang === "ru" ? "/insights/" : "/en/insights/"}>{lang === "ru" ? "Разборы" : "Field Notes"}</a>
    </nav>
  </div>
  <div class="footer-signature mono">{lang === "ru" ? "Пойми экономику. Сделай более разумный ход." : "Understand the economy. Make the smarter move."}</div>
</footer>
