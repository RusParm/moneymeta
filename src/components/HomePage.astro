---
import { Image } from "astro:assets";
import ck3EconomyWorld from "../assets/game-worlds/ck3-economy-world.webp";
import dotaEconomyWorld from "../assets/game-worlds/dota-economy-world.webp";
import gtaEconomyWorld from "../assets/game-worlds/gta-economy-world.webp";
import totalWarEconomyWorld from "../assets/game-worlds/total-war-economy-world.webp";
import wowEconomyWorld from "../assets/game-worlds/wow-economy-world.webp";
import { dotaPatchContext } from "../data/dota-economy";
import { weeklyMeta } from "../data/gta-businesses";
import { insights } from "../data/insights";
import { crusaderKingsHub, totalWarHub } from "../data/strategy-hubs";
import { wowPatchContext } from "../data/wow-economy";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "./BrandHeader.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props { lang: "ru" | "en"; }
const { lang } = Astro.props;

const homePath = lang === "ru" ? "/" : "/en/";
const gtaPath = lang === "ru" ? "/gta-online/" : "/en/gta-online/";
const dotaPath = lang === "ru" ? "/dota-2/" : "/en/dota-2/";
const wowPath = lang === "ru" ? "/wow/" : "/en/wow/";
const totalWarPath = lang === "ru" ? "/total-war/" : "/en/total-war/";
const ck3Path = lang === "ru" ? "/crusader-kings-3/" : "/en/crusader-kings-3/";
const calculatorPath = `${gtaPath}calculators/business-roi/`;

const copy = lang === "ru" ? {
  title: "Money Meta - аналитика и инструменты для игровых экономик",
  description: "Money Meta разбирает внутриигровые экономики и превращает их в решения: что купить, когда окупится, какой риск принять и что делать дальше.",
  kicker: "Игры как системы решений",
  headingA: "Пойми экономику любимой игры.",
  headingB: "Сделай лучший ход.",
  lede: "В каждой игре есть экономика: что покупать, на чём зарабатывать, когда рисковать и куда вкладывать время. Money Meta объясняет её без лишней сложности, а затем помогает выбрать следующий шаг под твой стиль игры.",
  start: "Понять, как это работает",
  explore: "Выбрать игру",
  promises: ["Сначала объясняем систему", "Затем показываем варианты", "В конце даём инструмент для решения"],
  atlasLabel: "Пять игровых экономик Money Meta",
  atlasKicker: "Одна идея · пять разных миров",
  atlasStatus: "Living economy atlas",
  atlasTitle: "У каждой игры своя валюта. Логика решений универсальна.",
  atlasText: "Money Meta показывает, как время, ресурсы, риск и прогресс связаны между собой.",
  worldTypes: ["Производство", "Экономика матча", "Рынок игроков", "Экономика кампании", "Капитал династии"],
  audienceKicker: "Для кого создан Money Meta",
  audienceTitle: "Начни со своей ситуации",
  audiences: [
    ["RETURNER", "Вернулся после перерыва", "Быстро поймёшь, что изменилось и на чём сосредоточиться."],
    ["LIMITED TIME", "Играешь несколько часов в неделю", "Выберешь маршрут с лучшей отдачей на время."],
    ["GRINDER", "Хочешь оптимизировать глубже", "Проверишь эффективность маршрутов, покупок и запасов."]
  ],
  whatKicker: "Как работает Money Meta",
  whatTitle: "Сначала понимаешь систему. Потом принимаешь решение.",
  whatText: "Мы соединяем игровой контекст, твою ситуацию и прозрачные модели. Можно начать с короткого объяснения и углубляться только тогда, когда это действительно нужно.",
  howSteps: [
    ["01", "Увидеть картину целиком", "Визуальная карта объясняет, откуда приходят ресурсы, где они застревают и что двигает прогресс."],
    ["02", "Найти свой маршрут", "Выбираешь стиль игры, доступное время и цель. Хаб показывает подходящий путь и реальные альтернативы."],
    ["03", "Проверить следующий ход", "Рейтинги, сценарии и калькуляторы помогают сравнить решения на твоих вводных."]
  ],
  canKicker: "Что есть внутри каждого игрового хаба",
  canSystem: "6 слоёв · один понятный путь",
  capabilities: [
    ["MAP", "Визуальная карта экономики и связей между её частями"],
    ["PATH", "Персональный путь для returner, casual и grinder"],
    ["PULSE", "Актуальная мета, патчи и изменения контекста"],
    ["LIBRARY", "Большая библиотека прикладных разборов"],
    ["RANKINGS", "Рейтинги и сравнения под разные ограничения"],
    ["LAB", "Калькуляторы и сценарии с редактируемыми вводными"]
  ],
  chooseKicker: "Когда смысл понятен",
  chooseTitle: "Теперь выбери экономику, которую хочешь освоить.",
  chooseText: "Каждый хаб начинается с карты и твоей ситуации, а уже потом ведёт к рейтингам, сценариям и калькуляторам.",
  active: "Доступно сейчас",
  gtaTag: "Production economy",
  gtaTitle: "GTA Online",
  gtaText: "Покупки на миллионы должны окупаться, а не просто красиво выглядеть в гараже.",
  gtaQuestions: [["Что купить следующим?", `${calculatorPath}#next-move`], ["Какой бизнес быстрее окупится?", gtaPath], ["Как собрать портфель под мой бюджет?", `${calculatorPath}#portfolio`]],
  dotaTag: "Match economy",
  dotaTitle: "Dota 2",
  dotaText: "Каждая покупка обменивает tempo сейчас на ценность позже. Посчитай этот trade-off.",
  dotaQuestions: [["Окупится ли Hand of Midas?", `${dotaPath}#midas-irr`], ["Хватит ли золота на buyback?", `${dotaPath}#buyback-reserve`]],
  wowTag: "Market economy",
  wowTitle: "WoW Retail",
  wowText: "Цена в Auction House ещё не прибыль. Комиссия, sell-through и inventory меняют ответ.",
  wowQuestions: [["Этот крафт реально прибыльный?", `${wowPath}#crafting-margin`], ["Сколько золота фарм приносит на деле?", `${wowPath}#farm-liquidity`]],
  totalWarTag: "Campaign economy",
  totalWarTitle: "Total War: Warhammer III",
  totalWarText: "Казна, провинции, армейский upkeep и захват должны работать как одна система.",
  totalWarQuestions: [["Окупится ли income-здание?", `${totalWarPath}#building-payback`], ["Хватит ли казны на новую армию?", `${totalWarPath}#war-reserve`], ["Sack или occupy?", `${totalWarPath}#conquest-choice`]],
  ck3Tag: "Dynasty economy",
  ck3Title: "Crusader Kings III",
  ck3Text: "Богатое правление важно только тогда, когда treasury переживает войну и наследование.",
  ck3Questions: [["Окупится ли здание домена?", `${ck3Path}#domain-payback`], ["Хватит ли gold на войну?", `${ck3Path}#war-chest`], ["Какой buffer получит наследник?", `${ck3Path}#succession-buffer`]],
  featuredKicker: "Flagship analysis",
  featuredTitle: "Цифры, которые меняют решение.",
  featuredText: "Короткие разборы ведут от популярного совета к проверяемому выводу и инструменту.",
  allNotes: "Все разборы",
  readNote: "Читать",
  signalKicker: "Money Meta pulse",
  signalTitle: "Контекст меняется. Модели это показывают.",
  signalText: "Каждый инструмент отделяет проверенный контекст от редактируемых baseline-оценок.",
  validThrough: "Действует до",
  checked: "Проверено",
  sourceState: "Статус данных",
  weekly: "GTA Weekly Meta",
  dota: "Dota patch context",
  wow: "WoW Retail context",
  totalWarPulse: "Total War campaign context",
  ck3Pulse: "CK3 dynasty context",
  compareKicker: "Почему не обычный гайд",
  compareTitle: "Гайд даёт мнение. Money Meta даёт решение.",
  generic: "Обычный гайд",
  moneyMeta: "Money Meta",
  compareRows: [
    ["Показывает теоретический доход", "Считает чистый результат после расходов"],
    ["Один tier list для всех", "Учитывает бюджет, время и стиль игры"],
    ["Скрытые или устаревшие допущения", "Inputs, дата и статус видны и редактируются"],
    ["Посмотрел и забыл", "Сохранил сценарий, сравнил и отправил ссылкой"]
  ],
  trustTitle: "Никакой выдуманной точности.",
  trustText: "Verified, estimated и community-reported никогда не смешиваются. Если данные устарели, Money Meta скажет это раньше, чем даст совет."
} : {
  title: "Money Meta - analytics and tools for in-game economies",
  description: "Money Meta takes in-game economies apart and turns them into decisions: what to buy, when it pays back, which risk to accept and what to do next.",
  kicker: "Games as decision systems",
  headingA: "Understand the economy of the game you love.",
  headingB: "Make the smarter move.",
  lede: "Every game has an economy: what to buy, how to earn, when to take risk and where to spend your time. Money Meta explains that economy clearly, then helps you choose the next move for your play style.",
  start: "See how it works",
  explore: "Choose a game",
  promises: ["First, understand the system", "Then, see the real options", "Finally, test your decision"],
  atlasLabel: "Five Money Meta game economies",
  atlasKicker: "One idea · five different worlds",
  atlasStatus: "Living economy atlas",
  atlasTitle: "Every game has its own currency. Decision logic travels.",
  atlasText: "Money Meta shows how time, resources, risk and progression connect.",
  worldTypes: ["Production", "Match economy", "Player market", "Campaign economy", "Dynasty capital"],
  audienceKicker: "Who Money Meta is for",
  audienceTitle: "Start with your situation",
  audiences: [
    ["RETURNER", "Back after a long break", "Catch up on what changed and where to focus first."],
    ["LIMITED TIME", "A few hours to play each week", "Choose the route with the best return on your time."],
    ["GRINDER", "Ready to optimize deeper", "Test the efficiency of routes, purchases and reserves."]
  ],
  whatKicker: "How Money Meta works",
  whatTitle: "Understand the system first. Make the decision second.",
  whatText: "We connect game context, your situation and transparent models. Start with a clear explanation and go deeper only when the decision calls for it.",
  howSteps: [
    ["01", "See the whole system", "A visual map explains where resources come from, where they get trapped and what drives progression."],
    ["02", "Find your path", "Choose your play style, available time and goal. The hub shows a fitting route and real alternatives."],
    ["03", "Test the next move", "Rankings, scenarios and calculators compare decisions using your own inputs."]
  ],
  canKicker: "What every game hub contains",
  canSystem: "6 layers · one clear path",
  capabilities: [
    ["MAP", "A visual map of the economy and the links inside it"],
    ["PATH", "A personal route for returners, casuals and grinders"],
    ["PULSE", "Current meta, patches and context changes"],
    ["LIBRARY", "A deep library of applied analysis"],
    ["RANKINGS", "Rankings and comparisons for different constraints"],
    ["LAB", "Calculators and scenarios with editable inputs"]
  ],
  chooseKicker: "Once the idea is clear",
  chooseTitle: "Now choose the economy you want to master.",
  chooseText: "Every hub begins with a map and your situation, then leads into rankings, scenarios and calculators.",
  active: "Available now",
  gtaTag: "Production economy",
  gtaTitle: "GTA Online",
  gtaText: "A multi-million-dollar purchase should pay back - not just look good in a garage.",
  gtaQuestions: [["What should I buy next?", `${calculatorPath}#next-move`], ["Which business pays back fastest?", gtaPath], ["Build a portfolio for my budget", `${calculatorPath}#portfolio`]],
  dotaTag: "Match economy",
  dotaTitle: "Dota 2",
  dotaText: "Every purchase trades tempo now for value later. Put a number on that trade-off.",
  dotaQuestions: [["Will Hand of Midas pay back?", `${dotaPath}#midas-irr`], ["Can I fund buyback in time?", `${dotaPath}#buyback-reserve`]],
  wowTag: "Market economy",
  wowTitle: "WoW Retail",
  wowText: "An Auction House price is not profit. Fees, sell-through and inventory change the answer.",
  wowQuestions: [["Is this craft actually profitable?", `${wowPath}#crafting-margin`], ["What does this farm really earn?", `${wowPath}#farm-liquidity`]],
  totalWarTag: "Campaign economy",
  totalWarTitle: "Total War: Warhammer III",
  totalWarText: "Treasury, provinces, army upkeep and conquest need to work as one system.",
  totalWarQuestions: [["Will the income building pay back?", `${totalWarPath}#building-payback`], ["Can the treasury fund another army?", `${totalWarPath}#war-reserve`], ["Sack or occupy?", `${totalWarPath}#conquest-choice`]],
  ck3Tag: "Dynasty economy",
  ck3Title: "Crusader Kings III",
  ck3Text: "A rich reign matters only when the treasury survives war and succession.",
  ck3Questions: [["Will the domain building pay back?", `${ck3Path}#domain-payback`], ["Can the treasury fund the war?", `${ck3Path}#war-chest`], ["What buffer will the heir receive?", `${ck3Path}#succession-buffer`]],
  featuredKicker: "Flagship analysis",
  featuredTitle: "Numbers that change the decision.",
  featuredText: "Focused field notes move from a popular claim to a testable conclusion and a tool.",
  allNotes: "All field notes",
  readNote: "Read",
  signalKicker: "Money Meta pulse",
  signalTitle: "Context moves. The models show it.",
  signalText: "Every tool separates verified context from editable baseline estimates.",
  validThrough: "Valid through",
  checked: "Checked",
  sourceState: "Data status",
  weekly: "GTA Weekly Meta",
  dota: "Dota patch context",
  wow: "WoW Retail context",
  totalWarPulse: "Total War campaign context",
  ck3Pulse: "CK3 dynasty context",
  compareKicker: "Why this is not another guide",
  compareTitle: "A guide gives an opinion. Money Meta gives a decision.",
  generic: "Typical guide",
  moneyMeta: "Money Meta",
  compareRows: [
    ["Shows theoretical income", "Calculates net outcome after costs"],
    ["One tier list for everyone", "Uses your budget, time and play style"],
    ["Hidden or stale assumptions", "Inputs, date and status stay visible"],
    ["Watch once and forget", "Save, compare and share the scenario"]
  ],
  trustTitle: "No invented precision.",
  trustText: "Verified, estimated and community-reported data never blur together. If a number is stale, Money Meta says so before giving advice."
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={homePath}
  alternatePath={lang === "ru" ? "/en/" : "/"}
  schema={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Money Meta",
    url: "https://themoneymeta.com",
    description: copy.description,
    inLanguage: ["ru", "en"]
  }}
>
  <main class="page home-v2">
    <div class="shell">
      <BrandHeader lang={lang} ruPath="/" enPath="/en/" />

      <section class="home-hero">
        <div class="home-hero-copy">
          <p class="eyebrow">{copy.kicker}</p>
          <h1>{copy.headingA}<br /><span class="magenta">{copy.headingB}</span></h1>
          <p class="lede">{copy.lede}</p>
          <div class="hero-actions">
            <a class="button primary button-large" href="#how-it-works">{copy.start} →</a>
            <a class="button ghost button-large" href="#choose-game">{copy.explore}</a>
          </div>
          <ul class="promise-list">
            {copy.promises.map((promise) => <li><span>✓</span>{promise}</li>)}
          </ul>
        </div>

        <aside class="home-world-atlas" aria-label={copy.atlasLabel}>
          <div class="atlas-topline"><span>{copy.atlasKicker}</span><strong><i></i>{copy.atlasStatus}</strong></div>
          <div class="atlas-world-grid" aria-hidden="true">
            {[
              { key: "gta", title: "GTA Online", type: copy.worldTypes[0], image: gtaEconomyWorld },
              { key: "dota", title: "Dota 2", type: copy.worldTypes[1], image: dotaEconomyWorld },
              { key: "wow", title: "WoW Retail", type: copy.worldTypes[2], image: wowEconomyWorld },
              { key: "total-war", title: "Total War", type: copy.worldTypes[3], image: totalWarEconomyWorld },
              { key: "ck3", title: "Crusader Kings III", type: copy.worldTypes[4], image: ck3EconomyWorld }
            ].map(({ key, title, type, image }) => (
              <div class={`atlas-world atlas-world-${key}`}>
                <Image src={image} alt="" widths={[320, 520]} sizes="260px" loading="eager" decoding="async" />
                <span><strong>{title}</strong><small>{type}</small></span>
              </div>
            ))}
          </div>
          <div class="atlas-caption">
            <span>Money Meta / Economy Atlas</span>
            <strong>{copy.atlasTitle}</strong>
            <p>{copy.atlasText}</p>
          </div>
        </aside>
      </section>

      <section class="audience-strip" aria-labelledby="audience-title">
        <div class="audience-strip-intro"><span>{copy.audienceKicker}</span><strong id="audience-title">{copy.audienceTitle}</strong></div>
        {copy.audiences.map(([code, title, text]) => <article><span>{code}</span><strong>{title}</strong><p>{text}</p></article>)}
      </section>

      <section id="how-it-works" class="section section-roomy home-explainer" aria-labelledby="home-explainer-title">
        <div class="home-explainer-intro">
          <div><span class="section-kicker">{copy.whatKicker}</span><h2 id="home-explainer-title">{copy.whatTitle}</h2></div>
          <p>{copy.whatText}</p>
        </div>
        <div class="home-step-grid">
          {copy.howSteps.map(([code, title, text]) => (
            <article><span>{code}</span><div class="home-step-line" aria-hidden="true"><i></i></div><h3>{title}</h3><p>{text}</p></article>
          ))}
        </div>
        <div class="home-capability-board">
          <div class="capability-board-head"><span>{copy.canKicker}</span><strong>{copy.canSystem}</strong></div>
          <div>{copy.capabilities.map(([code, text], index) => <div><span>0{index + 1}</span><strong>{code}</strong><p>{text}</p></div>)}</div>
        </div>
      </section>

      <section id="choose-game" class="section section-roomy">
        <div class="section-head">
          <div>
            <span class="section-kicker">{copy.chooseKicker}</span>
            <h2>{copy.chooseTitle}</h2>
            <p class="section-copy">{copy.chooseText}</p>
          </div>
          <span class="count">5 games · 15 live models</span>
        </div>

        <div class="game-entry-grid">
          {[
            { key: "gta", tag: copy.gtaTag, title: copy.gtaTitle, text: copy.gtaText, questions: copy.gtaQuestions, mark: "GTA$", image: gtaEconomyWorld },
            { key: "dota", tag: copy.dotaTag, title: copy.dotaTitle, text: copy.dotaText, questions: copy.dotaQuestions, mark: "M", image: dotaEconomyWorld },
            { key: "wow", tag: copy.wowTag, title: copy.wowTitle, text: copy.wowText, questions: copy.wowQuestions, mark: "AH", image: wowEconomyWorld },
            { key: "total-war", tag: copy.totalWarTag, title: copy.totalWarTitle, text: copy.totalWarText, questions: copy.totalWarQuestions, mark: "TW", image: totalWarEconomyWorld, isNew: true },
            { key: "ck3", tag: copy.ck3Tag, title: copy.ck3Title, text: copy.ck3Text, questions: copy.ck3Questions, mark: "CK", image: ck3EconomyWorld, isNew: true }
          ].map((game) => (
            <article class:list={["game-entry", `game-entry-${game.key}`, { "game-entry-new": game.isNew }]}>
              <Image class="game-entry-art" src={game.image} alt="" widths={[480, 720, 960]} sizes="(max-width: 820px) calc(100vw - 40px), 560px" loading="lazy" decoding="async" />
              <div class="game-entry-head">
                <span class={`game-sigil game-sigil-${game.key}`}>{game.mark}</span>
                <span class="availability"><i></i>{copy.active}{game.isNew ? " · v1.5" : ""}</span>
              </div>
              <span class="game-tag">{game.tag}</span>
              <h3>{game.title}</h3>
              <p>{game.text}</p>
              <nav class="question-list" aria-label={`${game.title} decisions`}>
                {game.questions.map(([label, href]) => <a href={href}><span>{label}</span><strong>↗</strong></a>)}
              </nav>
            </article>
          ))}
        </div>
      </section>

      <section class="section section-roomy home-insights">
        <div class="section-head">
          <div><span class="section-kicker">{copy.featuredKicker}</span><h2>{copy.featuredTitle}</h2><p class="section-copy">{copy.featuredText}</p></div>
          <a class="count count-link" href={lang === "ru" ? "/insights/" : "/en/insights/"}>{copy.allNotes} →</a>
        </div>
        <div class="home-insight-grid">
          {insights.map((insight, index) => {
            const content = insight.content[lang];
            const game = insight.game === "gta" ? "GTA Online" : insight.game === "dota" ? "Dota 2" : "WoW Retail";
            const href = `${lang === "ru" ? "" : "/en"}/insights/${insight.slug}/`;
            return <a class={`home-insight-card home-insight-${insight.game}`} href={href}>
              <div class="home-insight-meta"><span>{game}</span><b>0{index + 1}</b></div>
              <h3>{content.title}</h3>
              <p>{content.description}</p>
              <strong>{copy.readNote} · {content.readTime} ↗</strong>
            </a>;
          })}
        </div>
      </section>

      <section id="money-meta-pulse" class="section section-roomy pulse-section">
        <div class="section-head">
          <div>
            <span class="section-kicker">{copy.signalKicker}</span>
            <h2>{copy.signalTitle}</h2>
            <p class="section-copy">{copy.signalText}</p>
          </div>
        </div>
        <div class="pulse-grid">
          <a class="pulse-card pulse-gta" href={gtaPath}>
            <div class="pulse-head"><span>{copy.weekly}</span><span class="pulse-state">{weeklyMeta.status}</span></div>
            <strong>{weeklyMeta.items[lang][0]}</strong>
            <div class="pulse-meta"><span>{copy.validThrough}</span><b>{weeklyMeta.validThrough}</b></div>
          </a>
          <a class="pulse-card pulse-dota" href={dotaPath}>
            <div class="pulse-head"><span>{copy.dota}</span><span class="pulse-state">{dotaPatchContext.status}</span></div>
            <strong>Patch {dotaPatchContext.patch} · Midas + buyback models</strong>
            <div class="pulse-meta"><span>{copy.checked}</span><b>{dotaPatchContext.checkedAt}</b></div>
          </a>
          <a class="pulse-card pulse-wow" href={wowPath}>
            <div class="pulse-head"><span>{copy.wow}</span><span class="pulse-state">{wowPatchContext.status}</span></div>
            <strong>{wowPatchContext.release}</strong>
            <div class="pulse-meta"><span>{copy.checked}</span><b>{wowPatchContext.checkedAt}</b></div>
          </a>
          <a class="pulse-card pulse-total-war" href={totalWarPath}>
            <div class="pulse-head"><span>{copy.totalWarPulse}</span><span class="pulse-state">verified</span></div>
            <strong>{totalWarHub.version} · {totalWarHub.pulse.changes[0]!.title[lang]}</strong>
            <div class="pulse-meta"><span>{copy.checked}</span><b>{totalWarHub.checkedAt}</b></div>
          </a>
          <a class="pulse-card pulse-ck3" href={ck3Path}>
            <div class="pulse-head"><span>{copy.ck3Pulse}</span><span class="pulse-state">verified</span></div>
            <strong>{crusaderKingsHub.version} · Silk & Silver Q4 watch</strong>
            <div class="pulse-meta"><span>{copy.checked}</span><b>{crusaderKingsHub.checkedAt}</b></div>
          </a>
        </div>
      </section>

      <section class="section section-roomy comparison-section">
        <div class="section-head">
          <div>
            <span class="section-kicker">{copy.compareKicker}</span>
            <h2>{copy.compareTitle}</h2>
          </div>
        </div>
        <div class="comparison-table">
          <div class="comparison-head"><span>{copy.generic}</span><strong>{copy.moneyMeta}</strong></div>
          {copy.compareRows.map(([generic, product]) => <div class="comparison-row"><span><i>×</i>{generic}</span><strong><i>✓</i>{product}</strong></div>)}
        </div>
      </section>

      <section class="trust-banner">
        <span class="trust-icon">✓</span>
        <div><strong>{copy.trustTitle}</strong><p>{copy.trustText}</p></div>
      </section>

      <SiteFooter lang={lang} />
    </div>
  </main>
</BaseLayout>
