---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ck3World from "../assets/game-worlds/ck3-economy-world.webp";
import civilizationWorld from "../assets/game-worlds/civilization-economy-world.webp";
import dotaWorld from "../assets/game-worlds/dota-economy-world.webp";
import fableWorld from "../assets/game-worlds/fable-economy-world.webp";
import gtaWorld from "../assets/game-worlds/gta-economy-world.webp";
import totalWarWorld from "../assets/game-worlds/total-war-economy-world.webp";
import wowWorld from "../assets/game-worlds/wow-economy-world.webp";
import {
  DOTA_SNAPSHOT_MAX_AGE_HOURS,
  dotaItemsSnapshot,
  getDotaItemsPath
} from "../data/dota-items";
import { getHubFreshnessPolicy, getHubPath, hubPortals, type HubPortalId } from "../data/hub-portals";
import { civilizationHub, fableHub, getFrontierPath, type FrontierHubId } from "../data/frontier-hubs";
import { insightGameLabels, insights } from "../data/insights";
import type { FreshnessPolicy } from "../lib/freshness";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "./BrandHeader.astro";
import FreshnessIndicator from "./FreshnessIndicator.astro";
import SiteFooter from "./SiteFooter.astro";
import "../styles/home.css";

interface Props {
  lang: "ru" | "en";
}

interface HomeGame {
  id: HubPortalId | FrontierHubId;
  image: ImageMetadata;
  accent: string;
  accentRgb: string;
  name: string;
  shortName: string;
  version: string;
  root: string;
  statusPath: string;
  status: "live" | "watch";
  freshness: FreshnessPolicy;
  question: string;
  text: string;
  inputNote: string;
  actions: Array<{ label: string; path: string }>;
}

const { lang } = Astro.props;
const prefix = lang === "ru" ? "" : "/en";
const homePath = `${prefix}/`;
const copy = lang === "ru" ? {
  title: "Money Meta | следующий ход в экономике игры",
  description: "Выбери ситуацию в одной из шести живых игровых экономик или открой предрелизное досье Fable. Подставь свои цифры и проверь следующий ход.",
  kicker: "ЭКОНОМИКА ИГР БЕЗ ОБЩИХ СОВЕТОВ",
  heading: "Что тебе выгоднее сделать в игре прямо сейчас?",
  lede: "Выбери игру и свой вопрос. Подставь банк, доход или свободное время и получи конкретный следующий ход, а не ещё один общий гайд.",
  jumpToDemo: "Выбрать свою игру",
  noAccount: "Семь игровых миров. Начни со своего.",
  chooseGame: "Выбери игру",
  chooseHint: "Шесть живых экономик и одно предрелизное досье",
  situation: "Твоя ситуация",
  openHub: "Открыть весь раздел",
  checked: "проверено",
  fetched: "получено",
  current: "Данные в пределах срока проверки",
  recent: "Срез получен недавно",
  recheck: "Данные нужно перепроверить",
  snapshotOld: "Срез требует обновления",
  eventEnded: "Событие завершилось",
  official: "Официальные сведения проверены",
  watchRecheck: "Предрелизные сведения нужно перепроверить",
  liveModel: "Живая модель",
  watchModel: "До релиза",
  matchInput: "Публичный Match ID",
  matchPlaceholder: "Например, 8978544633",
  matchLoad: "Загрузить матч",
  matchHelp: "Без Steam-входа. Только ID публичного матча.",
  updates: "Что сейчас можно проверить",
  updatesText: "Рядом с каждым выводом видна версия игры и дата проверки.",
  statusKicker: "АКТУАЛЬНОСТЬ",
  open: "Открыть",
  guides: "Разборы для следующей сессии",
  allGuides: "Все разборы",
  watch: "GTA VI и Fable: факты до релиза",
  watchText: "Два досье собирают только подтверждённые сведения и план измерений. Выдуманных доходов и фальшивых расчётов здесь нет.",
  watchLink: "GTA VI",
  fableWatchLink: "Fable",
  howTitle: "Что Money Meta считает, а что оставляет тебе",
  howText: "Сайт считает стоимость, время, окупаемость и последствия порядка действий. Ты выбираешь цель, риск и тот игровой момент, ради которого тратишь ресурс.",
  trust: "Проверенные механики, наблюдаемая статистика и твои допущения показаны отдельно. Расчёт помогает увидеть цену выбора, но не обещает победу."
} : {
  title: "Money Meta | your next move in a game economy",
  description: "Choose a situation in one of six live game economies or open the pre-release Fable dossier. Use your own numbers and test the next move.",
  kicker: "GAME ECONOMIES WITHOUT GENERIC ADVICE",
  heading: "What is the best move in your game right now?",
  lede: "Choose your game and your question. Add your bank, income or available time and get a concrete next move instead of another generic guide.",
  jumpToDemo: "Choose your game",
  noAccount: "Seven game worlds. Start with yours.",
  chooseGame: "Choose your game",
  chooseHint: "Six live economies and one pre-release dossier",
  situation: "Your situation",
  openHub: "Explore the full hub",
  checked: "checked",
  fetched: "fetched",
  current: "Data is within its review window",
  recent: "Snapshot collected recently",
  recheck: "Data needs another review",
  snapshotOld: "Snapshot needs an update",
  eventEnded: "The event has ended",
  official: "Official information is within review window",
  watchRecheck: "Pre-release information needs another review",
  liveModel: "Live model",
  watchModel: "Pre-release",
  matchInput: "Public Match ID",
  matchPlaceholder: "For example, 8978544633",
  matchLoad: "Load match",
  matchHelp: "No Steam sign-in. Public match ID only.",
  updates: "What you can check now",
  updatesText: "Every conclusion shows the game version and its review date.",
  statusKicker: "STATUS",
  open: "Open",
  guides: "Analysis for your next session",
  allGuides: "All analyses",
  watch: "GTA VI and Fable: facts before launch",
  watchText: "Both dossiers collect confirmed information and a measurement plan. There are no invented earnings or fake calculations.",
  watchLink: "GTA VI",
  fableWatchLink: "Fable",
  howTitle: "What Money Meta calculates and what remains your call",
  howText: "The site calculates cost, time, payback and the consequences of action order. You choose the goal, the risk and the moment worth spending for.",
  trust: "Verified mechanics, observed statistics and your assumptions are shown separately. A calculation reveals the price of a choice; it cannot promise a win."
};

const games: HomeGame[] = [
  {
    id: "gta",
    image: gtaWorld,
    accent: "#39e3c6",
    accentRgb: "57, 227, 198",
    name: hubPortals.gta.name,
    shortName: hubPortals.gta.shortName,
    version: hubPortals.gta.version[lang],
    root: getHubPath("gta", lang),
    statusPath: getHubPath("gta", lang, "meta"),
    status: "live",
    freshness: getHubFreshnessPolicy("gta"),
    question: lang === "ru"
      ? "До конца недели три часа. Стоит ли менять привычный денежный маршрут?"
      : "Three hours remain this week. Should I leave my normal money route?",
    text: lang === "ru"
      ? "Сравни 4X, 3X и 2X активности со своим реальным GTA$/ч. Условия доступа и награда GTA$1,000,000 показаны отдельно, а выплату и время сайт не придумывает за тебя."
      : "Compare the 4X, 3X and 2X activities with your realized GTA$/h. Access conditions and the GTA$1,000,000 challenge reward stay explicit, while the site never invents your payout or run time.",
    inputNote: lang === "ru" ? "Обычный темп + один замер + время" : "Normal rate + one sample + time",
    actions: [
      { label: lang === "ru" ? "Собрать план на эту неделю" : "Build this week's plan", path: "meta/#weekly-plan" },
      { label: lang === "ru" ? "Рассчитать следующую покупку" : "Calculate the next purchase", path: "calculators/business-roi/#next-move" }
    ]
  },
  {
    id: "dota",
    image: dotaWorld,
    accent: "#e7b95b",
    accentRgb: "231, 185, 91",
    name: hubPortals.dota.name,
    shortName: hubPortals.dota.shortName,
    version: hubPortals.dota.version[lang],
    root: getHubPath("dota", lang),
    statusPath: getDotaItemsPath(lang),
    status: "live",
    freshness: getHubFreshnessPolicy("dota"),
    question: lang === "ru"
      ? "До драки пять минут. Какой предмет я реально успею собрать?"
      : "The next fight is five minutes away. Which item can I actually finish?",
    text: lang === "ru"
      ? "Свяжи цену предмета с золотом сейчас, темпом фарма и задачей героя. Близкая цена ещё не означает одинаковый выбор."
      : "Connect item cost to current gold, farming rate and the hero’s job. A similar price does not mean an equal choice.",
    inputNote: lang === "ru" ? "Золото + темп фарма + минута" : "Gold + farming rate + minute",
    actions: [
      { label: lang === "ru" ? "Сравнить два предмета" : "Compare two items", path: "items/compare/" },
      { label: lang === "ru" ? "Собрать очередь покупок" : "Build an item queue", path: "items/planner/" }
    ]
  },
  {
    id: "wow",
    image: wowWorld,
    accent: "#78bfff",
    accentRgb: "120, 191, 255",
    name: hubPortals.wow.name,
    shortName: hubPortals.wow.shortName,
    version: hubPortals.wow.version[lang],
    root: getHubPath("wow", lang),
    statusPath: getHubPath("wow", lang, "meta"),
    status: "live",
    freshness: getHubFreshnessPolicy("wow"),
    question: lang === "ru"
      ? "Крафт выглядит прибыльным. Сколько золота останется после продажи?"
      : "The craft looks profitable. How much gold remains after the sale?",
    text: lang === "ru"
      ? "Комиссия, вероятность продажи и непроданный запас превращают красивую маржу в совсем другой результат."
      : "Fees, sell-through and unsold stock can turn an attractive margin into a very different result.",
    inputNote: lang === "ru" ? "Материалы + комиссия + шанс продажи" : "Materials + fees + sell-through",
    actions: [
      { label: lang === "ru" ? "Посчитать реальную маржу" : "Calculate realized margin", path: "tools/#crafting-margin" },
      { label: lang === "ru" ? "Оценить прибыль от фарма" : "Estimate farming profit", path: "tools/#farm-liquidity" }
    ]
  },
  {
    id: "total-war",
    image: totalWarWorld,
    accent: "#e2ad55",
    accentRgb: "226, 173, 85",
    name: hubPortals["total-war"].name,
    shortName: hubPortals["total-war"].shortName,
    version: hubPortals["total-war"].version[lang],
    root: getHubPath("total-war", lang),
    statusPath: getHubPath("total-war", lang, "meta"),
    status: "live",
    freshness: getHubFreshnessPolicy("total-war"),
    question: lang === "ru"
      ? "Эта постройка окупится до того, как мне понадобится новая армия?"
      : "Will this building pay back before I need another army?",
    text: lang === "ru"
      ? "Сравни срок окупаемости с военным окном и не замораживай казну в доходе, который придёт слишком поздно."
      : "Compare payback time with the military window and avoid locking the treasury into income that arrives too late.",
    inputNote: lang === "ru" ? "Цена + доход за ход + военный срок" : "Cost + income per turn + war deadline",
    actions: [
      { label: lang === "ru" ? "Проверить окупаемость" : "Check building payback", path: "tools/#building-payback" },
      { label: lang === "ru" ? "Рассчитать запас на войну" : "Calculate a war reserve", path: "tools/#war-reserve" }
    ]
  },
  {
    id: "ck3",
    image: ck3World,
    accent: "#8fbda7",
    accentRgb: "143, 189, 167",
    name: hubPortals.ck3.name,
    shortName: hubPortals.ck3.shortName,
    version: hubPortals.ck3.version[lang],
    root: getHubPath("ck3", lang),
    statusPath: getHubPath("ck3", lang, "meta"),
    status: "live",
    freshness: getHubFreshnessPolicy("ck3"),
    question: lang === "ru"
      ? "Сколько оставить наследнику, чтобы первая война не закончила правление?"
      : "How much should the heir keep so the first war does not end the reign?",
    text: lang === "ru"
      ? "Улучшение домена конкурирует с подарками, наёмниками и запасом после наследования. Здесь важен порядок, а не только сумма."
      : "Domain upgrades compete with gifts, mercenaries and the post-succession reserve. Order matters as much as the amount.",
    inputNote: lang === "ru" ? "Казна + доход + риск наследования" : "Treasury + income + succession risk",
    actions: [
      { label: lang === "ru" ? "Оценить улучшение домена" : "Evaluate a domain upgrade", path: "tools/#domain-payback" },
      { label: lang === "ru" ? "Собрать подушку наследника" : "Build an heir’s reserve", path: "tools/#succession-buffer" }
    ]
  },
  {
    id: "civ7",
    image: civilizationWorld,
    accent: "#efbd64",
    accentRgb: "239, 189, 100",
    name: civilizationHub.name,
    shortName: civilizationHub.shortName,
    version: civilizationHub.version[lang],
    root: getFrontierPath("civ7", lang),
    statusPath: getFrontierPath("civ7", lang, "meta"),
    status: "live",
    freshness: { checkedAt: civilizationHub.checkedAt, staleAfterDays: civilizationHub.staleAfterDays },
    question: lang === "ru"
      ? "Эта постройка успеет вернуть производство до следующего контрольного срока?"
      : "Can this building return its production before the next checkpoint?",
    text: lang === "ru"
      ? "Сравни стоимость, задержку и полезность за ход. Модель использует цифры твоей партии и не назначает универсальную ценность цивилизации."
      : "Compare cost, delay and per-turn utility. The model uses numbers from your game and assigns no universal value to a civilization.",
    inputNote: lang === "ru" ? "Производство + польза за ход + срок" : "Production + value per turn + horizon",
    actions: [
      { label: lang === "ru" ? "Проверить окно окупаемости" : "Test the payback window", path: "tools/#building-payback" },
      { label: lang === "ru" ? "Разобрать Test of Time" : "Review Test of Time", path: "meta/" }
    ]
  },
  {
    id: "fable",
    image: fableWorld,
    accent: "#9bc96f",
    accentRgb: "155, 201, 111",
    name: fableHub.name,
    shortName: fableHub.shortName,
    version: fableHub.version[lang],
    root: getFrontierPath("fable", lang),
    statusPath: getFrontierPath("fable", lang, "sources"),
    status: "watch",
    freshness: { checkedAt: fableHub.checkedAt, staleAfterDays: fableHub.staleAfterDays },
    question: lang === "ru"
      ? "Репутация меняет цены. Что нужно измерить в первые часы после релиза?"
      : "Reputation changes prices. What should be measured in the first hours after launch?",
    text: lang === "ru"
      ? "Работа, собственность и живые жители подтверждены. Формулы не опубликованы, поэтому вместо фальшивого калькулятора здесь протокол запуска."
      : "Jobs, property and living residents are confirmed. Formulas are not public, so the hub starts with a launch protocol instead of a fake calculator.",
    inputNote: lang === "ru" ? "Версия + поселение + репутация + повтор" : "Version + settlement + reputation + repeat",
    actions: [
      { label: lang === "ru" ? "Открыть первые 72 часа" : "Open the first 72 hours", path: "launch-watch/" },
      { label: lang === "ru" ? "Проверить подтверждённое" : "Review confirmed signals", path: "economy/" }
    ]
  }
];

const activeGameId: HubPortalId = "gta";
const activeGame = games.find((game) => game.id === activeGameId)!;
const snapshotPolicy = {
  checkedAt: dotaItemsSnapshot.fetchedAt,
  maxAgeHours: DOTA_SNAPSHOT_MAX_AGE_HOURS
};
const featuredInsights = insights.filter((insight) => insight.featuredInHub).slice(0, 3);
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={homePath}
  alternatePath={lang === "ru" ? "/en/" : "/"}
  schema={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Money Meta",
    url: "https://themoneymeta.com",
    inLanguage: lang
  }}
>
  <main
    class="page mm-home"
    style={`--home-accent: ${activeGame.accent}; --home-accent-rgb: ${activeGame.accentRgb};`}
  >
    <div class="shell">
      <BrandHeader lang={lang} ruPath="/" enPath="/en/" />

      <section class="mm-home-hero" aria-labelledby="home-title">
        <div class="mm-home-pitch">
          <span class="section-kicker">{copy.kicker}</span>
          <h1 id="home-title">{copy.heading}</h1>
          <p>{copy.lede}</p>
          <div class="mm-home-pitch-actions">
            <a class="button primary" href="#game-picker">{copy.jumpToDemo} <span aria-hidden="true">↓</span></a>
            <small>{copy.noAccount}</small>
          </div>
        </div>

        <div id="game-picker" class="mm-home-launcher" data-home-launcher>
          <div class="mm-home-launcher-head">
            <h2>{copy.chooseGame}</h2>
            <span>{copy.chooseHint}</span>
          </div>

          <div
            class="mm-home-game-tabs"
            role="tablist"
            aria-label={copy.chooseGame}
          >
            {games.map((game) => {
              const selected = game.id === activeGameId;
              return (
                <button
                  type="button"
                  role="tab"
                  id={`home-tab-${game.id}`}
                  aria-controls={`home-stage-${game.id}`}
                  aria-selected={selected ? "true" : "false"}
                  tabindex={selected ? 0 : -1}
                  data-home-game-tab
                  data-game-id={game.id}
                  data-accent={game.accent}
                  data-accent-rgb={game.accentRgb}
                >
                  <Image
                    src={game.image}
                    alt=""
                    widths={[112, 168]}
                    sizes="56px"
                    loading="eager"
                    decoding="async"
                  />
                  <span>{game.shortName}</span>
                </button>
              );
            })}
          </div>

          <div class="mm-home-stage">
            {games.map((game) => {
              const isDota = game.id === "dota";
              return (
                <article
                  id={`home-stage-${game.id}`}
                  class="mm-home-stage-panel"
                  role="tabpanel"
                  aria-labelledby={`home-tab-${game.id}`}
                  data-home-game-panel
                  data-game-id={game.id}
                  hidden={game.id !== activeGameId}
                >
                  <Image
                    class="mm-home-stage-art"
                    src={game.image}
                    alt=""
                    widths={[720, 1080, 1500]}
                    sizes="(max-width: 760px) 100vw, 1100px"
                    loading={game.id === activeGameId ? "eager" : "lazy"}
                    decoding="async"
                  />
                  <div class="mm-home-stage-shade"></div>
                  <div class="mm-home-stage-content">
                    <div class="mm-home-stage-meta">
                      <span>{game.name}</span>
                      <small>{game.version}</small>
                      <small class:list={["mm-home-stage-mode", { "is-watch": game.status === "watch" }]}>{game.status === "live" ? copy.liveModel : copy.watchModel}</small>
                    </div>
                    <span class="mm-home-stage-kicker">{copy.situation}</span>
                    <h3>{game.question}</h3>
                    <p>{game.text}</p>
                    {isDota ? (
                      <form class="mm-home-match-loader" action={`${game.root}matches/audit/`} method="get">
                        <label for={`home-match-${lang}`}>{copy.matchInput}</label>
                        <div>
                          <input id={`home-match-${lang}`} name="match" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" placeholder={copy.matchPlaceholder} />
                          <input name="autoload" type="hidden" value="1" />
                          <button class="button primary" type="submit">{copy.matchLoad} <span aria-hidden="true">→</span></button>
                        </div>
                        <small>{copy.matchHelp}</small>
                      </form>
                    ) : <div class="mm-home-stage-input-note">{game.inputNote}</div>}
                    <div class="mm-home-stage-actions">
                      {game.actions.map((action, index) => (
                        <a class:list={["button", { primary: index === 0 }]} href={`${game.root}${action.path}`}>
                          {action.label} <span aria-hidden="true">→</span>
                        </a>
                      ))}
                      <a class="mm-home-stage-hub" href={game.root}>{copy.openHub} {game.shortName}</a>
                    </div>
                    <FreshnessIndicator
                      policy={isDota ? snapshotPolicy : game.freshness}
                      current={isDota ? copy.recent : game.status === "watch" ? copy.official : copy.current}
                      stale={game.id === "gta" ? copy.eventEnded : isDota ? copy.snapshotOld : game.status === "watch" ? copy.watchRecheck : copy.recheck}
                      dateLabel={isDota ? copy.fetched : copy.checked}
                      lang={lang}
                    />
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <section class="mm-home-depth" aria-labelledby="updates-title">
        <div class="mm-home-section-head">
          <div>
            <span class="section-kicker">{copy.statusKicker}</span>
            <h2 id="updates-title">{copy.updates}</h2>
          </div>
          <p>{copy.updatesText}</p>
        </div>
        <div class="mm-home-status-board">
          {games.map((game, index) => {
            const isDota = game.id === "dota";
            return (
              <a href={game.statusPath}>
                <span class="mm-home-status-index">{String(index + 1).padStart(2, "0")}</span>
                <div class="mm-home-status-game">
                  <strong>{game.name}</strong>
                  <span>{game.version}</span>
                </div>
                <FreshnessIndicator
                  policy={isDota ? snapshotPolicy : game.freshness}
                  current={isDota ? copy.recent : game.status === "watch" ? copy.official : copy.current}
                  stale={game.id === "gta" ? copy.eventEnded : isDota ? copy.snapshotOld : game.status === "watch" ? copy.watchRecheck : copy.recheck}
                  dateLabel={isDota ? copy.fetched : copy.checked}
                  lang={lang}
                />
                <b>{copy.open} <span aria-hidden="true">↗</span></b>
              </a>
            );
          })}
        </div>
      </section>

      <div class="mm-home-bottom">
        <section class="mm-home-guides" aria-labelledby="guides-title">
          <div class="mm-home-guides-head">
            <h2 id="guides-title">{copy.guides}</h2>
            <a href={`${prefix}/insights/`}>{copy.allGuides} →</a>
          </div>
          <div class="mm-home-guide-list">
            {featuredInsights.map((insight) => (
              <a href={`${prefix}/insights/${insight.slug}/`}>
                <span>{insightGameLabels[insight.game]} · {insight.content[lang].readTime}</span>
                <strong>{insight.content[lang].title}</strong>
                <b aria-hidden="true">↗</b>
              </a>
            ))}
          </div>
        </section>

        <aside class="mm-home-watch">
          <span class="section-kicker">GTA VI</span>
          <h2>{copy.watch}</h2>
          <p>{copy.watchText}</p>
          <div class="mm-home-watch-links"><a href={`${prefix}/gta-6/`}>{copy.watchLink} →</a><a href={getFrontierPath("fable", lang)}>{copy.fableWatchLink} →</a></div>
        </aside>
      </div>

      <details class="mm-home-how">
        <summary>{copy.howTitle}</summary>
        <div>
          <p>{copy.howText}</p>
          <p>{copy.trust}</p>
        </div>
      </details>

      <SiteFooter lang={lang} />
    </div>
  </main>
</BaseLayout>

<script>
  const launcher = document.querySelector<HTMLElement>("[data-home-launcher]");
  const home = launcher?.closest<HTMLElement>(".mm-home");
  const tabs = Array.from(launcher?.querySelectorAll<HTMLButtonElement>("[data-home-game-tab]") ?? []);
  const panels = Array.from(launcher?.querySelectorAll<HTMLElement>("[data-home-game-panel]") ?? []);

  function selectGame(tab: HTMLButtonElement, focus = false) {
    const gameId = tab.dataset.gameId;
    if (!gameId) return;

    tabs.forEach((candidate) => {
      const selected = candidate === tab;
      candidate.setAttribute("aria-selected", String(selected));
      candidate.tabIndex = selected ? 0 : -1;
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.gameId !== gameId;
    });
    home?.style.setProperty("--home-accent", tab.dataset.accent ?? "#e7b95b");
    home?.style.setProperty("--home-accent-rgb", tab.dataset.accentRgb ?? "231, 185, 91");
    if (focus) tab.focus();
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectGame(tab));
    tab.addEventListener("keydown", (event) => {
      let next = index;
      if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (index + 1) % tabs.length;
      else if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = tabs.length - 1;
      else return;
      event.preventDefault();
      selectGame(tabs[next]!, true);
    });
  });
</script>
