  readNote: "Читать",
  signalKicker: "Проверка актуальности",
  signalTitle: "Контекст меняется. Модели это показывают.",
  signalText: "Каждый инструмент отделяет проверенные данные от рабочих оценок, которые можно изменить.",
  validThrough: "Действует до",
  checked: "Проверено",
  lastChecked: "Последняя проверка",
  ended: "Действовало до",
  archive: "архив",
  recheck: "нужна проверка",
  gtaExpired: "Событие завершилось. В хабе сохранён архив, а постоянные модели работают с твоими вводными.",
  dotaStale: `Патч ${dotaPatchContext.patch} требует повторной проверки перед использованием как актуального контекста.`,
  wowStale: `${wowPatchContext.release} требует повторной проверки перед использованием как актуального контекста.`,
  totalWarStale: `${totalWarHub.version.ru} требует повторной проверки по официальному источнику.`,
  ck3Stale: `${crusaderKingsHub.version.ru} требует повторной проверки по официальному источнику.`,
  sourceState: "Статус данных",
  weekly: "Еженедельные события GTA",
  dota: "Актуальный патч Dota 2",
  wow: "Актуальный контекст WoW Retail",
  totalWarPulse: "Контекст кампании Total War",
  ck3Pulse: "Контекст династии CK3",
  compareKicker: "Почему не обычный гайд",
  compareTitle: "Гайд даёт мнение. Money Meta даёт решение.",
  generic: "Обычный гайд",
  moneyMeta: "Money Meta",
  compareRows: [
    ["Показывает теоретический доход", "Считает чистый результат после расходов"],
    ["Один рейтинг для всех", "Учитывает бюджет, время и стиль игры"],
    ["Скрытые или устаревшие допущения", "Вводные, дата и статус видны и редактируются"],
    ["Посмотрел и забыл", "Сохранил сценарий, сравнил и отправил ссылкой"]
  ],
  trustTitle: "Никакой выдуманной точности.",
  trustText: "Проверенные данные, рабочие оценки и сведения от сообщества не смешиваются. Если информация устарела, Money Meta предупредит об этом до рекомендации."
} : {
  title: "Money Meta - analytics and tools for in-game economies",
  description: "Money Meta takes in-game economies apart and turns them into decisions: what to buy, when it pays back, which risk to accept and what to do next.",
