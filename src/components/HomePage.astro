---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={homePath}
  alternatePath={lang === "ru" ? "/en/" : "/"}
  schema={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Money Meta",
    url: "https://themoneymeta.com",
    description: copy.description,
    inLanguage: ["ru", "en"]
  }}
>
  <main class="page home-v2">
    <div class="shell">
      <BrandHeader lang={lang} ruPath="/" enPath="/en/" />

      <section class="home-hero">
        <div class="home-hero-copy">
          <p class="eyebrow">{copy.kicker}</p>
          <h1>{copy.headingA}<br /><span class="magenta">{copy.headingB}</span></h1>
          <p class="lede">{copy.lede}</p>
          <div class="hero-actions">
            <a class="button primary button-large" href="#how-it-works">{copy.start} →</a>
            <a class="button ghost button-large" href="#choose-game">{copy.explore}</a>
          </div>
          <ul class="promise-list">
            {copy.promises.map((promise) => <li><span>✓</span>{promise}</li>)}
          </ul>
        </div>

        <aside class="home-world-atlas" aria-label={copy.atlasLabel}>
          <div class="atlas-topline"><span>{copy.atlasKicker}</span><strong><i></i>{copy.atlasStatus}</strong></div>
          <div class="atlas-world-grid" aria-hidden="true">
            {[
              { key: "gta", title: "GTA Online", type: copy.worldTypes[0], image: gtaEconomyWorld },
              { key: "dota", title: "Dota 2", type: copy.worldTypes[1], image: dotaEconomyWorld },
              { key: "wow", title: "WoW Retail", type: copy.worldTypes[2], image: wowEconomyWorld },
              { key: "total-war", title: "Total War", type: copy.worldTypes[3], image: totalWarEconomyWorld },
              { key: "ck3", title: "Crusader Kings III", type: copy.worldTypes[4], image: ck3EconomyWorld }
            ].map(({ key, title, type, image }) => (
              <div class={`atlas-world atlas-world-${key}`}>
                <Image src={image} alt="" widths={[320, 520]} sizes="260px" loading="eager" decoding="async" />
                <span><strong>{title}</strong><small>{type}</small></span>
              </div>
            ))}
          </div>
          <div class="atlas-caption">
            <span>{lang === "ru" ? "Money Meta / Атлас экономики" : "Money Meta / Economy Atlas"}</span>
            <strong>{copy.atlasTitle}</strong>
            <p>{copy.atlasText}</p>
          </div>
        </aside>
      </section>

      <section class="audience-strip" aria-labelledby="audience-title">
        <div class="audience-strip-intro"><span>{copy.audienceKicker}</span><strong id="audience-title">{copy.audienceTitle}</strong></div>
        {copy.audiences.map(([code, title, text]) => <article><span>{code}</span><strong>{title}</strong><p>{text}</p></article>)}
      </section>

      <section id="how-it-works" class="section section-roomy home-explainer" aria-labelledby="home-explainer-title">
        <div class="home-explainer-intro">
          <div><span class="section-kicker">{copy.whatKicker}</span><h2 id="home-explainer-title">{copy.whatTitle}</h2></div>
          <p>{copy.whatText}</p>
        </div>
        <div class="home-step-grid">
          {copy.howSteps.map(([code, title, text]) => (
            <article><span>{code}</span><div class="home-step-line" aria-hidden="true"><i></i></div><h3>{title}</h3><p>{text}</p></article>
          ))}
        </div>
        <div class="home-capability-board">
          <div class="capability-board-head"><span>{copy.canKicker}</span><strong>{copy.canSystem}</strong></div>
          <div>{copy.capabilities.map(([code, text], index) => <div><span>0{index + 1}</span><strong>{code}</strong><p>{text}</p></div>)}</div>
        </div>
      </section>

      <section id="choose-game" class="section section-roomy">
        <div class="section-head">
          <div>
            <span class="section-kicker">{copy.chooseKicker}</span>
            <h2>{copy.chooseTitle}</h2>
            <p class="section-copy">{copy.chooseText}</p>
          </div>
          <span class="count">{lang === "ru" ? "5 игр · 15 рабочих моделей" : "5 games · 15 live models"}</span>
        </div>

        <div class="game-entry-grid">
          {[
            { key: "gta", tag: copy.gtaTag, title: copy.gtaTitle, text: copy.gtaText, questions: copy.gtaQuestions, mark: "GTA$", image: gtaEconomyWorld },
            { key: "dota", tag: copy.dotaTag, title: copy.dotaTitle, text: copy.dotaText, questions: copy.dotaQuestions, mark: "M", image: dotaEconomyWorld },
            { key: "wow", tag: copy.wowTag, title: copy.wowTitle, text: copy.wowText, questions: copy.wowQuestions, mark: lang === "ru" ? "АУК" : "AH", image: wowEconomyWorld },
            { key: "total-war", tag: copy.totalWarTag, title: copy.totalWarTitle, text: copy.totalWarText, questions: copy.totalWarQuestions, mark: "TW", image: totalWarEconomyWorld, isNew: true },
            { key: "ck3", tag: copy.ck3Tag, title: copy.ck3Title, text: copy.ck3Text, questions: copy.ck3Questions, mark: "CK", image: ck3EconomyWorld, isNew: true }
          ].map((game) => (
            <article class:list={["game-entry", `game-entry-${game.key}`, { "game-entry-new": game.isNew }]}>
              <Image class="game-entry-art" src={game.image} alt="" widths={[480, 720, 960]} sizes="(max-width: 820px) calc(100vw - 40px), 560px" loading="lazy" decoding="async" />
              <div class="game-entry-head">
                <span class={`game-sigil game-sigil-${game.key}`}>{game.mark}</span>
                <span class="availability"><i></i>{copy.active}{game.isNew ? (lang === "ru" ? " · новое" : " · new") : ""}</span>
              </div>
              <span class="game-tag">{game.tag}</span>
              <h3>{game.title}</h3>
              <p>{game.text}</p>
              <nav class="question-list" aria-label={lang === "ru" ? `Решения по ${game.title}` : `${game.title} decisions`}>
                {game.questions.map(([label, href]) => <a href={href}><span>{label}</span><strong>↗</strong></a>)}
              </nav>
            </article>
          ))}
        </div>
      </section>

      <section class="section section-roomy home-insights">
        <div class="section-head">
          <div><span class="section-kicker">{copy.featuredKicker}</span><h2>{copy.featuredTitle}</h2><p class="section-copy">{copy.featuredText}</p></div>
          <a class="count count-link" href={lang === "ru" ? "/insights/" : "/en/insights/"}>{copy.allNotes} →</a>
        </div>
        <div class="home-insight-grid">
          {featuredInsights.map((insight, index) => {
            const content = insight.content[lang];
            const game = insightGameLabels[insight.game];
            const href = `${lang === "ru" ? "" : "/en"}/insights/${insight.slug}/`;
            return <a class={`home-insight-card home-insight-${insight.game}`} href={href}>
              <div class="home-insight-meta"><span>{game}</span><b>0{index + 1}</b></div>
              <h3>{content.title}</h3>
              <p>{content.description}</p>
              <strong>{copy.readNote} · {content.readTime} ↗</strong>
            </a>;
          })}
        </div>
      </section>

      <section id="money-meta-pulse" class="section section-roomy pulse-section">
        <div class="section-head">
          <div>
            <span class="section-kicker">{copy.signalKicker}</span>
            <h2>{copy.signalTitle}</h2>
            <p class="section-copy">{copy.signalText}</p>
          </div>
        </div>
        <div class="pulse-grid">
          <a
            class:list={["pulse-card", "pulse-gta", { "is-stale": pulseFreshness.gta }]}
            href={gtaPath}
            data-home-pulse-card
            data-freshness-mode="expires"
            data-valid-through={weeklyMeta.validThrough}
            data-current-status={lang === "ru" ? (weeklyMeta.status === "verified" ? "проверено" : "оценка") : weeklyMeta.status}
            data-stale-status={copy.archive}
            data-current-copy={weeklyMeta.items[lang][0]}
            data-stale-copy={copy.gtaExpired}
            data-current-label={copy.validThrough}
            data-stale-label={copy.ended}
          >
            <div class="pulse-head"><span>{copy.weekly}</span><span class="pulse-state" data-freshness-state>{pulseFreshness.gta ? copy.archive : (lang === "ru" ? (weeklyMeta.status === "verified" ? "проверено" : "оценка") : weeklyMeta.status)}</span></div>
            <strong data-freshness-copy>{pulseFreshness.gta ? copy.gtaExpired : weeklyMeta.items[lang][0]}</strong>
            <div class="pulse-meta"><span data-freshness-label>{pulseFreshness.gta ? copy.ended : copy.validThrough}</span><b>{weeklyMeta.validThrough}</b></div>
          </a>
          <a
            class:list={["pulse-card", "pulse-dota", { "is-stale": pulseFreshness.dota }]}
            href={dotaPath}
            data-home-pulse-card
            data-freshness-mode="age"
            data-checked-at={dotaPulse.checkedAt}
            data-stale-after={dotaPulse.staleAfterDays}
            data-current-status={lang === "ru" ? "частично проверено" : dotaPatchContext.status}
            data-stale-status={copy.recheck}
            data-current-copy={lang === "ru" ? `Патч ${dotaPatchContext.patch} · модели Midas и выкупа` : `Patch ${dotaPatchContext.patch} · Midas + buyback models`}
            data-stale-copy={copy.dotaStale}
            data-current-label={copy.checked}
            data-stale-label={copy.lastChecked}
          >
            <div class="pulse-head"><span>{copy.dota}</span><span class="pulse-state" data-freshness-state>{pulseFreshness.dota ? copy.recheck : (lang === "ru" ? "частично проверено" : dotaPatchContext.status)}</span></div>
            <strong data-freshness-copy>{pulseFreshness.dota ? copy.dotaStale : (lang === "ru" ? `Патч ${dotaPatchContext.patch} · модели Midas и выкупа` : `Patch ${dotaPatchContext.patch} · Midas + buyback models`)}</strong>
            <div class="pulse-meta"><span data-freshness-label>{pulseFreshness.dota ? copy.lastChecked : copy.checked}</span><b>{dotaPatchContext.checkedAt}</b></div>
          </a>
          <a
            class:list={["pulse-card", "pulse-wow", { "is-stale": pulseFreshness.wow }]}
            href={wowPath}
            data-home-pulse-card
            data-freshness-mode="age"
            data-checked-at={wowPulse.checkedAt}
            data-stale-after={wowPulse.staleAfterDays}
            data-current-status={lang === "ru" ? "частично проверено" : wowPatchContext.status}
            data-stale-status={copy.recheck}
            data-current-copy={wowPatchContext.release}
            data-stale-copy={copy.wowStale}
            data-current-label={copy.checked}
            data-stale-label={copy.lastChecked}
          >
            <div class="pulse-head"><span>{copy.wow}</span><span class="pulse-state" data-freshness-state>{pulseFreshness.wow ? copy.recheck : (lang === "ru" ? "частично проверено" : wowPatchContext.status)}</span></div>
            <strong data-freshness-copy>{pulseFreshness.wow ? copy.wowStale : wowPatchContext.release}</strong>
            <div class="pulse-meta"><span data-freshness-label>{pulseFreshness.wow ? copy.lastChecked : copy.checked}</span><b>{wowPatchContext.checkedAt}</b></div>
          </a>
          <a
            class:list={["pulse-card", "pulse-total-war", { "is-stale": pulseFreshness.totalWar }]}
            href={totalWarPath}
            data-home-pulse-card
            data-freshness-mode="age"
            data-checked-at={totalWarHub.checkedAt}
            data-stale-after={totalWarHub.staleAfterDays}
            data-current-status={lang === "ru" ? "проверено" : "verified"}
            data-stale-status={copy.recheck}
            data-current-copy={`${totalWarHub.version[lang]} · ${totalWarHub.pulse.changes[0]!.title[lang]}`}
            data-stale-copy={copy.totalWarStale}
            data-current-label={copy.checked}
            data-stale-label={copy.lastChecked}
          >
            <div class="pulse-head"><span>{copy.totalWarPulse}</span><span class="pulse-state" data-freshness-state>{pulseFreshness.totalWar ? copy.recheck : (lang === "ru" ? "проверено" : "verified")}</span></div>
            <strong data-freshness-copy>{pulseFreshness.totalWar ? copy.totalWarStale : `${totalWarHub.version[lang]} · ${totalWarHub.pulse.changes[0]!.title[lang]}`}</strong>
            <div class="pulse-meta"><span data-freshness-label>{pulseFreshness.totalWar ? copy.lastChecked : copy.checked}</span><b>{totalWarHub.checkedAt}</b></div>
          </a>
          <a
            class:list={["pulse-card", "pulse-ck3", { "is-stale": pulseFreshness.ck3 }]}
            href={ck3Path}
            data-home-pulse-card
            data-freshness-mode="age"
            data-checked-at={crusaderKingsHub.checkedAt}
            data-stale-after={crusaderKingsHub.staleAfterDays}
            data-current-status={lang === "ru" ? "проверено" : "verified"}
            data-stale-status={copy.recheck}
            data-current-copy={`${crusaderKingsHub.version[lang]} · ${lang === "ru" ? "следим за Silk & Silver в IV квартале" : "Silk & Silver Q4 watch"}`}
            data-stale-copy={copy.ck3Stale}
            data-current-label={copy.checked}
            data-stale-label={copy.lastChecked}
          >
            <div class="pulse-head"><span>{copy.ck3Pulse}</span><span class="pulse-state" data-freshness-state>{pulseFreshness.ck3 ? copy.recheck : (lang === "ru" ? "проверено" : "verified")}</span></div>
            <strong data-freshness-copy>{pulseFreshness.ck3 ? copy.ck3Stale : `${crusaderKingsHub.version[lang]} · ${lang === "ru" ? "следим за Silk & Silver в IV квартале" : "Silk & Silver Q4 watch"}`}</strong>
            <div class="pulse-meta"><span data-freshness-label>{pulseFreshness.ck3 ? copy.lastChecked : copy.checked}</span><b>{crusaderKingsHub.checkedAt}</b></div>
          </a>
        </div>
      </section>

      <section class="section section-roomy comparison-section">
        <div class="section-head">
          <div>
            <span class="section-kicker">{copy.compareKicker}</span>
            <h2>{copy.compareTitle}</h2>
          </div>
        </div>
        <div class="comparison-table">
          <div class="comparison-head"><span>{copy.generic}</span><strong>{copy.moneyMeta}</strong></div>
          {copy.compareRows.map(([generic, product]) => <div class="comparison-row"><span><i>×</i>{generic}</span><strong><i>✓</i>{product}</strong></div>)}
        </div>
      </section>

      <section class="trust-banner">
        <span class="trust-icon">✓</span>
        <div><strong>{copy.trustTitle}</strong><p>{copy.trustText}</p></div>
      </section>

      <SiteFooter lang={lang} />
    </div>
  </main>
</BaseLayout>

<script>
  import { isExpired, isOlderThanDays } from "../lib/freshness";

  document.querySelectorAll<HTMLElement>("[data-home-pulse-card]").forEach((root) => {
    const stale = root.dataset.freshnessMode === "expires"
      ? isExpired(root.dataset.validThrough ?? "")
      : isOlderThanDays(root.dataset.checkedAt ?? "", Number(root.dataset.staleAfter ?? 0));
    root.classList.toggle("is-stale", stale);
    const state = root.querySelector<HTMLElement>("[data-freshness-state]");
    const summary = root.querySelector<HTMLElement>("[data-freshness-copy]");
    const label = root.querySelector<HTMLElement>("[data-freshness-label]");
    if (state) state.textContent = stale ? root.dataset.staleStatus ?? "Recheck" : root.dataset.currentStatus ?? "Current";
    if (summary) summary.textContent = stale ? root.dataset.staleCopy ?? "" : root.dataset.currentCopy ?? "";
    if (label) label.textContent = stale ? root.dataset.staleLabel ?? "Last checked" : root.dataset.currentLabel ?? "Checked";
  });
</script>
