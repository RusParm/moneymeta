---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ck3World from "../assets/game-worlds/ck3-economy-world.webp";
import civilizationWorld from "../assets/game-worlds/civilization-economy-world.webp";
import dotaWorld from "../assets/game-worlds/dota-economy-world.webp";
import fableWorld from "../assets/game-worlds/fable-economy-world.webp";
import gtaWorld from "../assets/game-worlds/gta-economy-world.webp";
import totalWarWorld from "../assets/game-worlds/total-war-economy-world.webp";
import wowWorld from "../assets/game-worlds/wow-economy-world.webp";
import {
  DOTA_SNAPSHOT_MAX_AGE_HOURS,
  dotaItemsSnapshot,
  getDotaItemsPath
} from "../data/dota-items";
import { getHubFreshnessPolicy, getHubPath, hubPortals, type HubPortalId } from "../data/hub-portals";
import { civilizationHub, fableHub, getFrontierPath, type FrontierHubId } from "../data/frontier-hubs";
import { insightGameLabels, insights } from "../data/insights";
import type { FreshnessPolicy } from "../lib/freshness";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "./BrandHeader.astro";
import FreshnessIndicator from "./FreshnessIndicator.astro";
import SiteFooter from "./SiteFooter.astro";
import HomeDecisionExample from "./HomeDecisionExample.astro";
import type { ScenarioGame } from "../data/scenario-tools";
import "../styles/home.css";

interface Props {
  lang: "ru" | "en";
}

interface HomeGame {
  id: HubPortalId | FrontierHubId;
  image: ImageMetadata;
  accent: string;
  accentRgb: string;
  name: string;
  shortName: string;
  version: string;
  root: string;
  statusPath: string;
  status: "live" | "watch";
  freshness: FreshnessPolicy;

}

const { lang } = Astro.props;
const prefix = lang === "ru" ? "" : "/en";
const homePath = `${prefix}/`;
const copy = lang === "ru" ? {
  title: "Money Meta | следующий ход в экономике игры",
  description: "Выбери ситуацию в одной из шести живых игровых экономик или открой предрелизное досье Fable. Подставь свои цифры и проверь следующий ход.",
  kicker: "MONEY META · ЭКОНОМИКА ИГР",
  heading: "На что потратить золото и время в игре?",
  lede: "Выбери игру и посмотри готовый пример: сколько денег останется, хватит ли времени или какой эпизод матча стоит пересмотреть. Затем проверь свою ситуацию.",
  chooseGame: "Выбери игру",
  chooseHint: "Готовый пример → твои вводные → решение",
  openHub: "Открыть весь раздел",
  checked: "проверено",
  fetched: "получено",
  current: "Данные в пределах срока проверки",
  recent: "Срез получен недавно",
  recheck: "Данные нужно перепроверить",
  snapshotOld: "Срез требует обновления",
  eventEnded: "Событие завершилось",
  official: "Официальные сведения проверены",
  watchRecheck: "Предрелизные сведения нужно перепроверить",
  updates: "Что сейчас можно проверить",
  updatesText: "Рядом с каждым выводом видна версия игры и дата проверки.",
  statusKicker: "АКТУАЛЬНОСТЬ",
  open: "Открыть",
  guides: "Разборы для следующей сессии",
  allGuides: "Все разборы",
  watch: "GTA VI и Fable: факты до релиза",
  watchText: "Два досье собирают только подтверждённые сведения и план измерений. Выдуманных доходов и фальшивых расчётов здесь нет.",
  watchLink: "GTA VI",
  fableWatchLink: "Fable",
  howTitle: "Что Money Meta считает, а что оставляет тебе",
  howText: "Сайт считает стоимость, время, окупаемость и последствия порядка действий. Ты выбираешь цель, риск и тот игровой момент, ради которого тратишь ресурс.",
  trust: "Проверенные механики, наблюдаемая статистика и твои допущения показаны отдельно. Расчёт помогает увидеть цену выбора, но не обещает победу."
} : {
  title: "Money Meta | your next move in a game economy",
  description: "Choose a situation in one of six live game economies or open the pre-release Fable dossier. Use your own numbers and test the next move.",
  kicker: "MONEY META · GAME ECONOMIES",
  heading: "Where should your gold and gaming time go?",
  lede: "Choose a game and see a worked answer: cash left over, time to a goal or a match episode worth reviewing. Then check your own situation.",
  chooseGame: "Choose your game",
  chooseHint: "Worked example → your inputs → decision",
  openHub: "Explore the full hub",
  checked: "checked",
  fetched: "fetched",
  current: "Data is within its review window",
  recent: "Snapshot collected recently",
  recheck: "Data needs another review",
  snapshotOld: "Snapshot needs an update",
  eventEnded: "The event has ended",
  official: "Official information is within review window",
  watchRecheck: "Pre-release information needs another review",
  updates: "What you can check now",
  updatesText: "Every conclusion shows the game version and its review date.",
  statusKicker: "STATUS",
  open: "Open",
  guides: "Analysis for your next session",
  allGuides: "All analyses",
  watch: "GTA VI and Fable: facts before launch",
  watchText: "Both dossiers collect confirmed information and a measurement plan. There are no invented earnings or fake calculations.",
  watchLink: "GTA VI",
  fableWatchLink: "Fable",
  howTitle: "What Money Meta calculates and what remains your call",
  howText: "The site calculates cost, time, payback and the consequences of action order. You choose the goal, the risk and the moment worth spending for.",
  trust: "Verified mechanics, observed statistics and your assumptions are shown separately. A calculation reveals the price of a choice; it cannot promise a win."
};

const games: HomeGame[] = [
  {
    id: "gta",
    image: gtaWorld,
    accent: "#39e3c6",
    accentRgb: "57, 227, 198",
    name: hubPortals.gta.name,
    shortName: hubPortals.gta.shortName,
    version: hubPortals.gta.version[lang],
    root: getHubPath("gta", lang),
    statusPath: getHubPath("gta", lang, "meta"),
    status: "live",
    freshness: getHubFreshnessPolicy("gta")

  },
  {
    id: "dota",
    image: dotaWorld,
    accent: "#e7b95b",
    accentRgb: "231, 185, 91",
    name: hubPortals.dota.name,
    shortName: hubPortals.dota.shortName,
    version: hubPortals.dota.version[lang],
    root: getHubPath("dota", lang),
    statusPath: getDotaItemsPath(lang),
    status: "live",
    freshness: getHubFreshnessPolicy("dota")

  },
  {
    id: "wow",
    image: wowWorld,
    accent: "#78bfff",
    accentRgb: "120, 191, 255",
    name: hubPortals.wow.name,
    shortName: hubPortals.wow.shortName,
    version: hubPortals.wow.version[lang],
    root: getHubPath("wow", lang),
    statusPath: getHubPath("wow", lang, "meta"),
    status: "live",
    freshness: getHubFreshnessPolicy("wow")

  },
  {
    id: "total-war",
    image: totalWarWorld,
    accent: "#e2ad55",
    accentRgb: "226, 173, 85",
    name: hubPortals["total-war"].name,
    shortName: hubPortals["total-war"].shortName,
    version: hubPortals["total-war"].version[lang],
    root: getHubPath("total-war", lang),
    statusPath: getHubPath("total-war", lang, "meta"),
    status: "live",
    freshness: getHubFreshnessPolicy("total-war"),

  },
  {
    id: "ck3",
    image: ck3World,
    accent: "#8fbda7",
    accentRgb: "143, 189, 167",
    name: hubPortals.ck3.name,
    shortName: hubPortals.ck3.shortName,
    version: hubPortals.ck3.version[lang],
    root: getHubPath("ck3", lang),
    statusPath: getHubPath("ck3", lang, "meta"),
    status: "live",
    freshness: getHubFreshnessPolicy("ck3"),

  },
  {
    id: "civ7",
    image: civilizationWorld,
    accent: "#efbd64",
    accentRgb: "239, 189, 100",
    name: civilizationHub.name,
    shortName: civilizationHub.shortName,
    version: civilizationHub.version[lang],
    root: getFrontierPath("civ7", lang),
    statusPath: getFrontierPath("civ7", lang, "meta"),
    status: "live",
    freshness: { checkedAt: civilizationHub.checkedAt, staleAfterDays: civilizationHub.staleAfterDays },

  },
  {
    id: "fable",
    image: fableWorld,
    accent: "#9bc96f",
    accentRgb: "155, 201, 111",
    name: fableHub.name,
    shortName: fableHub.shortName,
    version: fableHub.version[lang],
    root: getFrontierPath("fable", lang),
    statusPath: getFrontierPath("fable", lang, "sources"),
    status: "watch",
    freshness: { checkedAt: fableHub.checkedAt, staleAfterDays: fableHub.staleAfterDays },

  }
];

const liveGames = games.filter((game) => game.status === "live");
const activeGameId: HubPortalId = "gta";
const activeGame = games.find((game) => game.id === activeGameId)!;
const snapshotPolicy = {
  checkedAt: dotaItemsSnapshot.fetchedAt,
  maxAgeHours: DOTA_SNAPSHOT_MAX_AGE_HOURS
};
const featuredInsights = insights.filter((insight) => insight.featuredInHub).slice(0, 3);
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={homePath}
  alternatePath={lang === "ru" ? "/en/" : "/"}
  schema={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Money Meta",
    url: "https://themoneymeta.com",
    inLanguage: lang
  }}
>
  <main
    class="page mm-home"
    data-home-lang={lang}
    style={`--home-accent: ${activeGame.accent}; --home-accent-rgb: ${activeGame.accentRgb};`}
  >
    <div class="shell">
      <BrandHeader lang={lang} ruPath="/" enPath="/en/" />

      <section class="mm-home-hero" aria-labelledby="home-title">
        <div class="mm-home-pitch">
          <span class="section-kicker">{copy.kicker}</span>
          <h1 id="home-title">{copy.heading}</h1>
          <p>{copy.lede}</p>

        </div>

        <div id="game-picker" class="mm-home-launcher" data-home-launcher>
          <div class="mm-home-launcher-head">
            <h2>{copy.chooseGame}</h2>
            <span>{copy.chooseHint}</span>
          </div>

          <nav class="mm-home-game-tabs" aria-label={copy.chooseGame} data-home-tabs>
            {liveGames.map((game) => (
              <a href={`#home-stage-${game.id}`} id={`home-tab-${game.id}`}
                data-home-game-tab data-game-id={game.id}
                data-accent={game.accent} data-accent-rgb={game.accentRgb}>
                <Image src={game.image} alt="" widths={[112, 168]} sizes="44px" loading="eager" decoding="async" />
                <span>{game.shortName}</span>
              </a>
            ))}
          </nav>
          <div class="mm-home-stage">
            {liveGames.map((game) => (
              <article id={`home-stage-${game.id}`} class="mm-home-stage-panel"
                aria-labelledby={`home-tab-${game.id}`} data-home-game-panel data-game-id={game.id}
                hidden={game.id !== activeGameId}>
                <Image class="mm-home-stage-art" src={game.image} alt="" widths={[720, 1080]}
                  sizes="(max-width: 760px) 100vw, 1100px" loading={game.id === activeGameId ? "eager" : "lazy"} decoding="async" />
                <div class="mm-home-stage-shade"></div>
                <div class="mm-home-stage-content">
                  <div class="mm-home-stage-meta">
                    <span>{game.name}</span><small>{game.version}</small>
                    <a href={game.root}>{copy.openHub} →</a>
                  </div>
                  <aside class="mm-home-resume" data-home-resume data-game-id={game.id} hidden
                    aria-label={lang === "ru" ? "Вернуться к своему расчёту" : "Resume your calculation"}>
                    <div><strong>{lang === "ru" ? "Продолжи свой план" : "Continue your plan"}</strong>
                      <a href={`${prefix}/saved/?game=${game.id}`}>{lang === "ru" ? "Все мои расчёты →" : "All my calculations →"}</a></div>
                    <div data-home-resume-list></div>
                    <small>{lang === "ru" ? "Сохранённые результаты в этом браузере. Открой расчёт, чтобы проверить его заново." : "Saved results in this browser. Open a calculation to review it again."}</small>
                  </aside>
                  {game.id === "wow" && <aside class="mm-home-resume" data-home-batch-resume hidden
                    aria-label={lang === "ru" ? "Продажи твоей партии" : "Your batch sales"}>
                    <div><strong>{lang === "ru" ? "Вернись к своей партии" : "Return to your batch"}</strong></div>
                    <div data-home-resume-list></div>
                    <small>{lang === "ru" ? "Сопоставь продажи с исходным планом и подготовь следующую партию." : "Compare sales with the original plan and prepare your next batch."}</small>
                  </aside>}
                  <HomeDecisionExample gameId={game.id as ScenarioGame} lang={lang} />
                </div>
              </article>
            ))}
          </div>
          <noscript><style is:inline>.mm-home [data-home-game-panel][hidden] { display: block !important; }</style></noscript>
        </div>
      </section>

      <details class="mm-home-depth mm-home-source-details">
        <summary>{lang === "ru" ? "Версии игр и источники данных" : "Game versions and data sources"}</summary>
        <div class="mm-home-section-head">
          <div>
            <span class="section-kicker">{copy.statusKicker}</span>
            <h2 id="updates-title">{copy.updates}</h2>
          </div>
          <p>{copy.updatesText}</p>
        </div>
        <div class="mm-home-status-board">
          {games.map((game, index) => {
            const isDota = game.id === "dota";
            return (
              <a href={game.statusPath}>
                <span class="mm-home-status-index">{String(index + 1).padStart(2, "0")}</span>
                <div class="mm-home-status-game">
                  <strong>{game.name}</strong>
                  <span>{game.version}</span>
                </div>
                <FreshnessIndicator
                  policy={isDota ? snapshotPolicy : game.freshness}
                  current={isDota ? copy.recent : game.status === "watch" ? copy.official : copy.current}
                  stale={game.id === "gta" ? copy.eventEnded : isDota ? copy.snapshotOld : game.status === "watch" ? copy.watchRecheck : copy.recheck}
                  dateLabel={isDota ? copy.fetched : copy.checked}
                  lang={lang}
                />
                <b>{copy.open} <span aria-hidden="true">↗</span></b>
              </a>
            );
          })}
        </div>
      </details>

      <div class="mm-home-bottom">
        <section class="mm-home-guides" aria-labelledby="guides-title">
          <div class="mm-home-guides-head">
            <h2 id="guides-title">{copy.guides}</h2>
            <a href={`${prefix}/insights/`}>{copy.allGuides} →</a>
          </div>
          <div class="mm-home-guide-list">
            {featuredInsights.map((insight) => (
              <a href={`${prefix}/insights/${insight.slug}/`}>
                <span>{insightGameLabels[insight.game]} · {insight.content[lang].readTime}</span>
                <strong>{insight.content[lang].title}</strong>
                <b aria-hidden="true">↗</b>
              </a>
            ))}
          </div>
        </section>

        <aside class="mm-home-watch">
          <span class="section-kicker">GTA VI</span>
          <h2>{copy.watch}</h2>
          <p>{copy.watchText}</p>
          <div class="mm-home-watch-links"><a href={`${prefix}/gta-6/`}>{copy.watchLink} →</a><a href={getFrontierPath("fable", lang)}>{copy.fableWatchLink} →</a></div>
        </aside>
      </div>

      <details class="mm-home-how">
        <summary>{copy.howTitle}</summary>
        <div>
          <p>{copy.howText}</p>
          <p>{copy.trust}</p>
        </div>
      </details>

      <SiteFooter lang={lang} />
    </div>
  </main>
</BaseLayout>

<script>
  import { initializeHome } from "../lib/home-page";
  initializeHome();
</script>
