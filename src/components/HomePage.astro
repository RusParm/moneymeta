const activeGameId: HubPortalId = "dota";
const activeGame = games.find((game) => game.id === activeGameId)!;
const snapshotPolicy = {
  checkedAt: dotaItemsSnapshot.fetchedAt,
  maxAgeHours: DOTA_SNAPSHOT_MAX_AGE_HOURS
};
const featuredInsights = insights.filter((insight) => insight.featuredInHub).slice(0, 3);
const demoItems = ["blink", "force_staff"].map((key) => dotaItemsByKey.get(key)!);
const demoInput = {
  itemKeys: demoItems.map((item) => item.key),
  availableGold: 1000,
  goldPerMinute: 400,
  currentMinute: 12,
  role: "core" as const
};
const initialComparison = compareDotaItems(demoItems, demoInput);
const demoItemsJson = JSON.stringify(demoItems.map((item) => ({
  ...item,
  components: [],
  attributes: [],
  abilities: []
})));

const formatClock = (minute: number | null) => {
  if (minute === null) return copy.demoNoIncome;
  let whole = Math.floor(minute);
  let seconds = Math.round((minute - whole) * 60);
  if (seconds === 60) {
    whole += 1;
    seconds = 0;
  }
  return `${whole}:${String(seconds).padStart(2, "0")}`;
};

const initialConclusion = lang === "ru"
  ? "По таймингу почти ничья. Решает задача: Blink Dagger даёт первый вход, Force Staff даёт управляемое смещение и спасение."
  : "The timing is almost even. The job decides it: Blink Dagger creates the first move, while Force Staff provides controlled repositioning and a save.";
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={homePath}
  alternatePath={lang === "ru" ? "/en/" : "/"}
  schema={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Money Meta",
    url: "https://themoneymeta.com",
    inLanguage: lang
  }}
>
  <main
    class="page mm-home"
    style={`--home-accent: ${activeGame.accent}; --home-accent-rgb: ${activeGame.accentRgb};`}
  >
    <div class="shell">
      <BrandHeader lang={lang} ruPath="/" enPath="/en/" />

      <section class="mm-home-hero" aria-labelledby="home-title">
        <div class="mm-home-pitch">
          <span class="section-kicker">{copy.kicker}</span>
          <h1 id="home-title">{copy.heading}</h1>
          <p>{copy.lede}</p>
          <div class="mm-home-pitch-actions">
            <a class="button primary" href="#dota-check">{copy.jumpToDemo} <span aria-hidden="true">↓</span></a>
            <small>{copy.noAccount}</small>
          </div>
        </div>

        <div class="mm-home-launcher" data-home-launcher>
          <div class="mm-home-launcher-head">
            <h2>{copy.chooseGame}</h2>
            <span>{copy.chooseHint}</span>
          </div>

          <div
            class="mm-home-game-tabs"
            role="tablist"
            aria-label={copy.chooseGame}
          >
            {games.map((game) => {
              const selected = game.id === activeGameId;
              return (
                <button
                  type="button"
                  role="tab"
                  id={`home-tab-${game.id}`}
                  aria-controls={`home-stage-${game.id}`}
                  aria-selected={selected ? "true" : "false"}
                  tabindex={selected ? 0 : -1}
                  data-home-game-tab
                  data-game-id={game.id}
                  data-accent={game.accent}
                  data-accent-rgb={game.accentRgb}
                >
                  <Image
                    src={game.image}
                    alt=""
                    widths={[112, 168]}
                    sizes="56px"
                    loading="eager"
                    decoding="async"
                  />
                  <span>{game.shortName}</span>
                </button>
              );
            })}
          </div>

          <div class="mm-home-stage">
            {games.map((game) => {
              const isDota = game.id === "dota";
              return (
                <article
                  id={`home-stage-${game.id}`}
                  class="mm-home-stage-panel"
                  role="tabpanel"
                  aria-labelledby={`home-tab-${game.id}`}
                  data-home-game-panel
                  data-game-id={game.id}
                  hidden={game.id !== activeGameId}
                >
                  <Image
                    class="mm-home-stage-art"
                    src={game.image}
                    alt=""
                    widths={[720, 1080, 1500]}
                    sizes="(max-width: 760px) 100vw, 1100px"
                    loading={isDota ? "eager" : "lazy"}
                    decoding="async"
                  />
                  <div class="mm-home-stage-shade"></div>
                  <div class="mm-home-stage-content">
                    <div class="mm-home-stage-meta">
                      <span>{game.name}</span>
                      <small>{game.version}</small>
                      <small class:list={["mm-home-stage-mode", { "is-watch": game.status === "watch" }]}>{game.status === "live" ? copy.liveModel : copy.watchModel}</small>
                    </div>
                    <span class="mm-home-stage-kicker">{copy.situation}</span>
                    <h3>{game.question}</h3>
                    <p>{game.text}</p>
                    <div class="mm-home-stage-input-note">{game.inputNote}</div>
                    <div class="mm-home-stage-actions">
                      {game.actions.map((action, index) => (
                        <a class:list={["button", { primary: index === 0 }]} href={`${game.root}${action.path}`}>
                          {action.label} <span aria-hidden="true">→</span>
                        </a>
                      ))}
                      <a class="mm-home-stage-hub" href={game.root}>{copy.openHub} {game.shortName}</a>
                    </div>
                    <FreshnessIndicator
                      policy={isDota ? snapshotPolicy : game.freshness}
                      current={isDota ? copy.recent : game.status === "watch" ? copy.official : copy.current}
                      stale={game.id === "gta" ? copy.eventEnded : isDota ? copy.snapshotOld : game.status === "watch" ? copy.watchRecheck : copy.recheck}
                      dateLabel={isDota ? copy.fetched : copy.checked}
                      lang={lang}
                    />
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <section
        id="dota-check"
        class="mm-home-demo"
        aria-labelledby="demo-title"
        data-home-demo
        data-lang={lang}
        data-demo-items={demoItemsJson}
      >
        <div class="mm-home-demo-head">
          <div>
            <span class="section-kicker">{copy.demoKicker}</span>
            <h2 id="demo-title">{copy.demoTitle}</h2>
            <p>{copy.demoText}</p>
          </div>
          <div class="mm-home-demo-source">
            <span>{copy.demoPatch}</span>
            <strong>{dotaItemsSnapshot.patch.label}</strong>
          </div>
        </div>

        <div class="mm-home-demo-workbench">
          <form class="mm-home-demo-inputs" data-demo-form>
            <label>
              <span>{copy.demoGold}</span>
              <div>
                <input
                  name="availableGold"
                  type="number"
                  min="0"
                  max="100000"
                  step="50"
                  value={demoInput.availableGold}
                  inputmode="numeric"
                />
                <small>{copy.demoInputGold}</small>
              </div>
            </label>
            <label>
              <span>{copy.demoGpm}</span>
              <div>
                <input
                  name="goldPerMinute"
                  type="number"
                  min="0"
                  max="2500"
                  step="25"
                  value={demoInput.goldPerMinute}
                  inputmode="numeric"
                />
                <small>{copy.demoInputGpm}</small>
              </div>
            </label>
            <label>
              <span>{copy.demoMinute}</span>
              <div>
                <input
                  name="currentMinute"
                  type="number"
                  min="0"
                  max="180"
                  step="1"
                  value={demoInput.currentMinute}
                  inputmode="numeric"
                />
                <small>{copy.demoInputMinute}</small>
              </div>
            </label>
          </form>

          <div class="mm-home-demo-results">
            {initialComparison.map((option, index) => (
              <article
                class:list={["mm-home-demo-result", { "is-ready": option.goldNeeded === 0 }]}
                data-demo-result
                data-item-key={option.item.key}
              >
                <div class="mm-home-demo-item">
                  <img src={option.item.image} alt="" width="80" height="60" loading="lazy" />
                  <div>
                    <span>{index === 0 ? copy.demoFirstMove : copy.demoSave}</span>
                    <h3>{option.item.name}</h3>
                  </div>
                </div>
                <dl>
                  <div>
                    <dt>{copy.demoCost}</dt>
                    <dd>{format.format(option.item.cost)}</dd>
                  </div>
                  <div>
                    <dt>{copy.demoReady}</dt>
                    <dd data-demo-ready>{option.minutesToAfford === 0 ? copy.demoNow : formatClock(option.projectedMinute)}</dd>
                  </div>
                </dl>
                <p data-demo-gap>
                  {option.goldNeeded === 0
                    ? copy.demoEnough
                    : `${copy.demoMissing} ${format.format(option.goldNeeded)} ${copy.demoInputGold}`}
                </p>
              </article>
            ))}
          </div>

          <div class="mm-home-demo-verdict">
            <span aria-hidden="true">Σ</span>
            <div>
              <strong>{copy.proofTitle}</strong>
              <p data-demo-verdict aria-live="polite">{initialConclusion}</p>
            </div>
            <a href={getDotaItemComparePath(lang)}>{copy.demoFull} <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section class="mm-home-depth" aria-labelledby="updates-title">
        <div class="mm-home-section-head">
          <div>
            <span class="section-kicker">{copy.statusKicker}</span>
            <h2 id="updates-title">{copy.updates}</h2>
          </div>
          <p>{copy.updatesText}</p>
        </div>
        <div class="mm-home-status-board">
          {games.map((game, index) => {
            const isDota = game.id === "dota";
            return (
              <a href={game.statusPath}>
                <span class="mm-home-status-index">{String(index + 1).padStart(2, "0")}</span>
                <div class="mm-home-status-game">
                  <strong>{game.name}</strong>
                  <span>{game.version}</span>
                </div>
                <FreshnessIndicator
                  policy={isDota ? snapshotPolicy : game.freshness}
                  current={isDota ? copy.recent : game.status === "watch" ? copy.official : copy.current}
                  stale={game.id === "gta" ? copy.eventEnded : isDota ? copy.snapshotOld : game.status === "watch" ? copy.watchRecheck : copy.recheck}
                  dateLabel={isDota ? copy.fetched : copy.checked}
                  lang={lang}
                />
                <b>{copy.open} <span aria-hidden="true">↗</span></b>
              </a>
            );
          })}
        </div>
      </section>

      <div class="mm-home-bottom">
        <section class="mm-home-guides" aria-labelledby="guides-title">
          <div class="mm-home-guides-head">
            <h2 id="guides-title">{copy.guides}</h2>
            <a href={`${prefix}/insights/`}>{copy.allGuides} →</a>
          </div>
          <div class="mm-home-guide-list">
            {featuredInsights.map((insight) => (
              <a href={`${prefix}/insights/${insight.slug}/`}>
                <span>{insightGameLabels[insight.game]} · {insight.content[lang].readTime}</span>
                <strong>{insight.content[lang].title}</strong>
                <b aria-hidden="true">↗</b>
              </a>
            ))}
          </div>
        </section>

        <aside class="mm-home-watch">
          <span class="section-kicker">GTA VI</span>
          <h2>{copy.watch}</h2>
          <p>{copy.watchText}</p>
          <div class="mm-home-watch-links"><a href={`${prefix}/gta-6/`}>{copy.watchLink} →</a><a href={getFrontierPath("fable", lang)}>{copy.fableWatchLink} →</a></div>
        </aside>
      </div>

      <details class="mm-home-how">
        <summary>{copy.howTitle}</summary>
        <div>
          <p>{copy.howText}</p>
          <p>{copy.trust}</p>
        </div>
      </details>

      <SiteFooter lang={lang} />
    </div>
  </main>
</BaseLayout>

<script>
  import { compareDotaItems, type DotaItemRecord } from "../lib/dota-items";

  const launcher = document.querySelector<HTMLElement>("[data-home-launcher]");
  const home = launcher?.closest<HTMLElement>(".mm-home");
  const tabs = Array.from(launcher?.querySelectorAll<HTMLButtonElement>("[data-home-game-tab]") ?? []);
  const panels = Array.from(launcher?.querySelectorAll<HTMLElement>("[data-home-game-panel]") ?? []);

  function selectGame(tab: HTMLButtonElement, focus = false) {
    const gameId = tab.dataset.gameId;
    if (!gameId) return;

    tabs.forEach((candidate) => {
      const selected = candidate === tab;
      candidate.setAttribute("aria-selected", String(selected));
      candidate.tabIndex = selected ? 0 : -1;
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.gameId !== gameId;
    });
    home?.style.setProperty("--home-accent", tab.dataset.accent ?? "#e7b95b");
    home?.style.setProperty("--home-accent-rgb", tab.dataset.accentRgb ?? "231, 185, 91");
    if (focus) tab.focus();
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectGame(tab));
    tab.addEventListener("keydown", (event) => {
      let next = index;
      if (event.key === "ArrowRight" || event.key === "ArrowDown") next = (index + 1) % tabs.length;
      else if (event.key === "ArrowLeft" || event.key === "ArrowUp") next = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = tabs.length - 1;
      else return;
      event.preventDefault();
      selectGame(tabs[next]!, true);
    });
  });

  const demo = document.querySelector<HTMLElement>("[data-home-demo]");
  const form = demo?.querySelector<HTMLFormElement>("[data-demo-form]");

  if (demo && form) {
    const lang = demo.dataset.lang === "en" ? "en" : "ru";
    const locale = lang === "ru" ? "ru-RU" : "en-US";
    const number = new Intl.NumberFormat(locale);
    const items = JSON.parse(demo.dataset.demoItems ?? "[]") as DotaItemRecord[];
    const resultCards = Array.from(demo.querySelectorAll<HTMLElement>("[data-demo-result]"));
    const verdict = demo.querySelector<HTMLElement>("[data-demo-verdict]");

    const value = (name: string) => Number(new FormData(form).get(name) ?? 0);
    const clock = (minute: number | null) => {
      if (minute === null) return lang === "ru" ? "нет темпа фарма" : "no farming rate";
      let whole = Math.floor(minute);
      let seconds = Math.round((minute - whole) * 60);
      if (seconds === 60) {
        whole += 1;
        seconds = 0;
      }
      return `${whole}:${String(seconds).padStart(2, "0")}`;
    };
    const duration = (minutes: number) => {
      const seconds = Math.max(1, Math.round(minutes * 60));
      if (seconds < 60) return lang === "ru" ? `${seconds} сек.` : `${seconds} sec`;
      const rounded = Math.round(minutes * 10) / 10;
      return lang === "ru" ? `${rounded} мин.` : `${rounded} min`;
    };

    const update = () => {
      const options = compareDotaItems(items, {
        itemKeys: ["blink", "force_staff"],
        availableGold: value("availableGold"),
        goldPerMinute: value("goldPerMinute"),
        currentMinute: value("currentMinute"),
        role: "core"
      });

      resultCards.forEach((card) => {
        const option = options.find((candidate) => candidate.item.key === card.dataset.itemKey);
        if (!option) return;
        const ready = card.querySelector<HTMLElement>("[data-demo-ready]");
        const gap = card.querySelector<HTMLElement>("[data-demo-gap]");
        card.classList.toggle("is-ready", option.goldNeeded === 0);
        if (ready) {
          ready.textContent = option.minutesToAfford === 0
            ? (lang === "ru" ? "можно купить" : "available now")
            : clock(option.projectedMinute);
        }
        if (gap) {
          gap.textContent = option.goldNeeded === 0
            ? (lang === "ru" ? "золота хватает" : "enough gold")
            : lang === "ru"
              ? `не хватает ${number.format(option.goldNeeded)} золота`
              : `${number.format(option.goldNeeded)} gold missing`;
        }
      });

      if (!verdict || options.length < 2) return;
      const [blink, force] = options;
      if (blink!.projectedMinute === null || force!.projectedMinute === null) {
        verdict.textContent = lang === "ru"
          ? "Без темпа фарма нельзя назвать минуту покупки. Добавь ожидаемое золото в минуту."
          : "A completion minute needs a farming rate. Add the gold you expect to earn each minute.";
      } else if (blink!.goldNeeded === 0 && force!.goldNeeded === 0) {
        verdict.textContent = lang === "ru"
          ? "На оба предмета уже хватает. Решает задача: первый вход или управляемое смещение и спасение."
          : "You can afford both. The job decides it: first move or controlled repositioning and a save.";
      } else if (force!.goldNeeded === 0 && blink!.goldNeeded > 0) {
        verdict.textContent = lang === "ru"
          ? `Force Staff доступен сейчас. До Blink Dagger ещё ${duration(blink!.minutesToAfford ?? 0)} Если драка уже начинается, эта разница реальна.`
          : `Force Staff is available now. Blink Dagger needs another ${duration(blink!.minutesToAfford ?? 0)} If the fight is starting, that gap is real.`;
      } else {
        const difference = Math.abs((blink!.projectedMinute ?? 0) - (force!.projectedMinute ?? 0));
        verdict.textContent = lang === "ru"
          ? `По таймингу почти ничья: разница ${duration(difference)} Решает не цена, а первый вход против управляемого смещения и спасения.`
          : `The timing is almost even: a ${duration(difference)} gap. The decision is not price, but first move versus controlled repositioning and a save.`;
      }
    };

    form.addEventListener("submit", (event) => event.preventDefault());
    form.addEventListener("input", update);
    update();
  }
</script>
