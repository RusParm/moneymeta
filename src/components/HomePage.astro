  dotaTag: "Match economy",
  dotaTitle: "Dota 2",
  dotaText: "Every purchase trades tempo now for value later. Put a number on that trade-off.",
  dotaQuestions: [["Will Hand of Midas pay back?", `${dotaPath}#midas-irr`], ["Can I fund buyback in time?", `${dotaPath}#buyback-reserve`]],
