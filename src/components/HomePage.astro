---
import { Image } from "astro:assets";
import ck3EconomyWorld from "../assets/game-worlds/ck3-economy-world.webp";
import dotaEconomyWorld from "../assets/game-worlds/dota-economy-world.webp";
import gtaEconomyWorld from "../assets/game-worlds/gta-economy-world.webp";
import totalWarEconomyWorld from "../assets/game-worlds/total-war-economy-world.webp";
import wowEconomyWorld from "../assets/game-worlds/wow-economy-world.webp";
import { dotaPatchContext } from "../data/dota-economy";
import { dotaPulse } from "../data/dota-hub";
import { weeklyMeta } from "../data/gta-businesses";
import { insightGameLabels, insights } from "../data/insights";
import { crusaderKingsHub, totalWarHub } from "../data/strategy-hubs";
import { wowPatchContext } from "../data/wow-economy";
import { wowPulse } from "../data/wow-hub";
import { isExpired, isOlderThanDays } from "../lib/freshness";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "./BrandHeader.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props { lang: "ru" | "en"; }
const { lang } = Astro.props;

const homePath = lang === "ru" ? "/" : "/en/";
const gtaPath = lang === "ru" ? "/gta-online/" : "/en/gta-online/";
const dotaPath = lang === "ru" ? "/dota-2/" : "/en/dota-2/";
const wowPath = lang === "ru" ? "/wow/" : "/en/wow/";
const totalWarPath = lang === "ru" ? "/total-war/" : "/en/total-war/";
const ck3Path = lang === "ru" ? "/crusader-kings-3/" : "/en/crusader-kings-3/";
const calculatorPath = `${gtaPath}calculators/business-roi/`;
const featuredInsights = insights.filter((insight) => insight.featuredInHub);
const pulseFreshness = {
  gta: isExpired(weeklyMeta.validThrough),
  dota: isOlderThanDays(dotaPulse.checkedAt, dotaPulse.staleAfterDays),
  wow: isOlderThanDays(wowPulse.checkedAt, wowPulse.staleAfterDays),
  totalWar: isOlderThanDays(totalWarHub.checkedAt, totalWarHub.staleAfterDays),
  ck3: isOlderThanDays(crusaderKingsHub.checkedAt, crusaderKingsHub.staleAfterDays)
};

const copy = lang === "ru" ? {
  title: "Money Meta | аналитика и инструменты для игровых экономик",
  description: "Money Meta разбирает внутриигровые экономики и превращает их в решения: что купить, когда окупится, какой риск принять и что делать дальше.",
  kicker: "Игры как системы решений",
  headingA: "Пойми экономику любимой игры.",
  headingB: "Сделай лучший ход.",
  lede: "В каждой игре есть экономика: что покупать, на чём зарабатывать, когда рисковать и куда вкладывать время. Money Meta объясняет её без лишней сложности, а затем помогает выбрать следующий шаг под твой стиль игры.",
  start: "Понять, как это работает",
  explore: "Выбрать игру",
  promises: ["Сначала объясняем систему", "Затем показываем варианты", "В конце даём инструмент для решения"],
  atlasLabel: "Пять игровых экономик Money Meta",
  atlasKicker: "Одна идея · пять разных миров",
  atlasStatus: "Атлас игровых экономик",
  atlasTitle: "У каждой игры своя валюта. Логика решений универсальна.",
  atlasText: "Money Meta показывает, как время, ресурсы, риск и прогресс связаны между собой.",
  worldTypes: ["Производство", "Экономика матча", "Рынок игроков", "Экономика кампании", "Капитал династии"],
  audienceKicker: "Для кого создан Money Meta",
  audienceTitle: "Начни со своей ситуации",
  audiences: [
    ["ВОЗВРАЩЕНИЕ", "Вернулся после перерыва", "Быстро поймёшь, что изменилось и на чём сосредоточиться."],
    ["МАЛО ВРЕМЕНИ", "Играешь несколько часов в неделю", "Выберешь маршрут с лучшей отдачей на время."],
    ["ОПТИМИЗАЦИЯ", "Хочешь разобраться глубже", "Проверишь эффективность маршрутов, покупок и запасов."]
