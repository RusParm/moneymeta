---
import { Image } from "astro:assets";
import ck3World from "../assets/game-worlds/ck3-economy-world.webp";
import dotaWorld from "../assets/game-worlds/dota-economy-world.webp";
import gtaWorld from "../assets/game-worlds/gta-economy-world.webp";
import totalWarWorld from "../assets/game-worlds/total-war-economy-world.webp";
import wowWorld from "../assets/game-worlds/wow-economy-world.webp";
import { DOTA_SNAPSHOT_MAX_AGE_HOURS, dotaItemsByKey, dotaItemsSnapshot, getDotaItemComparePath } from "../data/dota-items";
import { getHubFreshnessPolicy, getHubPath, hubPortals, type HubPortalId } from "../data/hub-portals";
import { insightGameLabels, insights } from "../data/insights";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "./BrandHeader.astro";
import FreshnessIndicator from "./FreshnessIndicator.astro";
import SiteFooter from "./SiteFooter.astro";
import "../styles/home.css";

interface Props { lang: "ru" | "en"; }
const { lang } = Astro.props;
const prefix = lang === "ru" ? "" : "/en";
const homePath = `${prefix}/`;
const format = new Intl.NumberFormat(lang === "ru" ? "ru-RU" : "en-US");
const copy = lang === "ru" ? {
  title: "Money Meta | экономика игр, гайды и расчёты",
  description: "Сравни покупки, заработок и планы в GTA Online, Dota 2, WoW, Total War и Crusader Kings III. Гайды и расчёты с твоими вводными.",
  kicker: "GTA · DOTA · WOW · СТРАТЕГИИ",
  heading: "Пойми экономику игры.", accent: "Выбери следующий ход.",
  lede: "Гайды и расчёты, которые помогают тратить игровое золото и время с умом. Сравни покупки и проверь свой план на конкретных цифрах.",
  choose: "Выбрать игру", how: "Как это работает", free: "Без регистрации. Со своими вводными.",
  example: "Попробуй на примере Dota 2", exampleTitle: "Blink или Force Staff?",
  exampleText: "Близкая цена, разные задачи. Посмотри, на что хватит золота и сколько придётся копить на каждый вариант.",
  purposes: ["Выход на дистанцию инициации", "Смещение себя или союзника"],
  compare: "Сравнить предметы", gold: "золота", snapshot: "патч среза",
  games: "Начни со своей игры", gamesNote: "Выбери вопрос или открой весь раздел.",
  updates: "Данные и обновления", updatesNote: "Дата получения статистики и проверка механик учитываются отдельно.",
  guides: "Что почитать", allGuides: "Все разборы", open: "Открыть раздел",
  recent: "Срез получен недавно", old: "Срез требует обновления", fetched: "получено", checked: "проверено",
  context: "В пределах срока проверки", recheck: "Нужна проверка", ended: "Событие завершилось",
  watch: "Наблюдаем за GTA VI", watchText: "Подтверждённые факты и вопросы к будущей экономике игры. Без расчётов на выдуманных механиках.", watchLink: "Открыть досье",
  howTitle: "Как пользоваться Money Meta",
  howText: "Выбери игру и задачу. Измени бюджет, доход или время под свою ситуацию. Сравни результат, сохрани сценарий или отправь ссылку другу.",
  trust: "Мы разделяем проверенные механики, наблюдаемую статистику и твои допущения. Расчёт объясняет последствия выбора, но не обещает победу или гарантированный доход."
} : {
  title: "Money Meta | game economies, guides and calculators",
  description: "Compare purchases, earnings and plans in GTA Online, Dota 2, WoW, Total War and Crusader Kings III. Guides and calculators using your own inputs.",
  kicker: "GTA · DOTA · WOW · STRATEGY",
  heading: "Understand the game economy.", accent: "Choose your next move.",
  lede: "Guides and calculators to help you spend in-game gold and time wisely. Compare purchases and test your plan with real numbers.",
  choose: "Choose a game", how: "How it works", free: "No account needed. Use your own inputs.",
  example: "Try a Dota 2 example", exampleTitle: "Blink or Force Staff?",
  exampleText: "Similar prices, different jobs. See what you can afford and how long each option would take to save for.",
  purposes: ["Reach an initiation position", "Reposition yourself or an ally"],
  compare: "Compare items", gold: "gold", snapshot: "snapshot patch",
  games: "Start with your game", gamesNote: "Choose a question or explore the full hub.",
  updates: "Data and updates", updatesNote: "Statistics collection and mechanics reviews have separate dates.",
  guides: "Worth a read", allGuides: "All guides", open: "Explore hub",
  recent: "Recently collected", old: "Snapshot needs an update", fetched: "fetched", checked: "checked",
  context: "Within review window", recheck: "Review needed", ended: "Event has ended",
  watch: "Following GTA VI", watchText: "Confirmed facts and open questions about its economy. No calculations based on invented mechanics.", watchLink: "Open the dossier",
  howTitle: "How to use Money Meta",
  howText: "Choose a game and a question. Adjust the budget, income or time to fit your situation. Compare the result, save your scenario or share a link with a friend.",
  trust: "We separate verified mechanics, observed statistics and your assumptions. A calculation explains the consequences of a choice; it cannot promise a win or a guaranteed return."
};
const games: Array<{ id: HubPortalId; image: typeof gtaWorld; text: string; questions: [string, string][] }> = [
  { id: "gta", image: gtaWorld, text: lang === "ru" ? "Бизнесы, доход и время на продажи." : "Businesses, earnings and time spent selling.", questions: [[lang === "ru" ? "Что купить следующим?" : "What should I buy next?", "calculators/business-roi/#next-move"], [lang === "ru" ? "Что с недельными бонусами?" : "What about weekly bonuses?", "meta/"]] },
  { id: "dota", image: dotaWorld, text: lang === "ru" ? "Цена предметов и время до покупки." : "Item costs and time to the next purchase.", questions: [[lang === "ru" ? "Какой предмет выбрать?" : "Which item should I choose?", "items/compare/"], [lang === "ru" ? "Когда соберу свой билд?" : "When can I finish my build?", "items/planner/"]] },
  { id: "wow", image: wowWorld, text: lang === "ru" ? "Крафт, аукцион и прибыль от фарма." : "Crafting, auctions and farming profit.", questions: [[lang === "ru" ? "Этот крафт принесёт прибыль?" : "Will this craft make a profit?", "tools/#crafting-margin"], [lang === "ru" ? "Сколько приносит фарм?" : "What does farming really earn?", "tools/#farm-liquidity"]] },
  { id: "total-war", image: totalWarWorld, text: lang === "ru" ? "Доход провинций и содержание армий." : "Province income and army upkeep.", questions: [[lang === "ru" ? "Когда окупится здание?" : "When will a building pay back?", "tools/#building-payback"], [lang === "ru" ? "Хватит ли казны на армию?" : "Can I afford another army?", "tools/#war-reserve"]] },
  { id: "ck3", image: ck3World, text: lang === "ru" ? "Домен, войны и казна наследника." : "Your domain, wars and the heir’s treasury.", questions: [[lang === "ru" ? "Стоит ли улучшать домен?" : "Should I improve my domain?", "tools/#domain-payback"], [lang === "ru" ? "Что останется наследнику?" : "What will my heir inherit?", "tools/#succession-buffer"]] }
];
const exampleItems = ["blink", "force_staff"].map((key) => dotaItemsByKey.get(key)!);
const featuredInsights = insights.filter((insight) => insight.featuredInHub);
const snapshotPolicy = { checkedAt: dotaItemsSnapshot.fetchedAt, maxAgeHours: DOTA_SNAPSHOT_MAX_AGE_HOURS };
---

<BaseLayout title={copy.title} description={copy.description} lang={lang} canonicalPath={homePath} alternatePath={lang === "ru" ? "/en/" : "/"} schema={{ "@context": "https://schema.org", "@type": "WebSite", name: "Money Meta", url: "https://themoneymeta.com", inLanguage: lang }}>
  <main class="page mm-home">
    <div class="shell">
      <BrandHeader lang={lang} ruPath="/" enPath="/en/" />
      <section class="mm-home-intro" aria-labelledby="home-title">
        <div class="mm-home-pitch">
          <span class="section-kicker">{copy.kicker}</span>
          <h1 id="home-title">{copy.heading} <span>{copy.accent}</span></h1>
          <p>{copy.lede}</p>
          <div class="mm-home-actions"><a class="button primary" href="#choose-game">{copy.choose} ↓</a><a href="#how-it-works">{copy.how}</a></div>
          <small>{copy.free}</small>
        </div>
        <aside class="mm-home-example" aria-labelledby="example-title">
          <div class="mm-home-example-meta"><span>{copy.example}</span><small>{copy.snapshot} {dotaItemsSnapshot.patch.label}</small></div>
          <h2 id="example-title">{copy.exampleTitle}</h2>
          <div class="mm-home-item-pair">
            {exampleItems.map((item, index) => <div><img src={item.image} alt="" width="66" height="48" loading="eager" /><strong>{item.name}</strong><b>{format.format(item.cost)} <small>{copy.gold}</small></b><p>{copy.purposes[index]}</p></div>)}
          </div>
          <p class="mm-home-example-note">{copy.exampleText}</p>
          <a class="mm-home-compare" href={getDotaItemComparePath(lang)}>{copy.compare} <span aria-hidden="true">→</span></a>
          <FreshnessIndicator policy={snapshotPolicy} current={copy.recent} stale={copy.old} dateLabel={copy.fetched} lang={lang} />
        </aside>
      </section>

      <section id="choose-game" class="mm-home-games" aria-labelledby="games-title">
        <div class="mm-home-section-head"><h2 id="games-title">{copy.games}</h2><p>{copy.gamesNote}</p></div>
        <div class="mm-home-game-grid">
          {games.map((game) => {
            const hub = hubPortals[game.id];
            const root = getHubPath(game.id, lang);
            return <article class={`mm-home-game mm-home-game-${game.id}`}>
              <a class="mm-home-game-cover" href={root}>
                <Image src={game.image} alt="" widths={[280, 440]} sizes="(max-width: 1050px) 220px, 240px" loading="eager" decoding="async" />
                <h3>{hub.name}</h3><span aria-hidden="true">↗</span>
              </a>
              <div class="mm-home-game-body"><p>{game.text}</p><div>{game.questions.map(([question, path]) => <a href={`${root}${path}`}>{question}<span aria-hidden="true">→</span></a>)}</div><a class="mm-home-hub-link" href={root}>{copy.open} →</a></div>
            </article>;
          })}
        </div>
      </section>

      <div class="mm-home-lower">
        <section id="money-meta-pulse" aria-labelledby="updates-title">
          <div class="mm-home-section-head"><h2 id="updates-title">{copy.updates}</h2><p>{copy.updatesNote}</p></div>
          <div class="mm-home-updates">{games.map(({ id }) => {
            const hub = hubPortals[id];
            return <a href={getHubPath(id, lang, id === "dota" ? undefined : "meta") + (id === "dota" ? "items/" : "")}>
              <div><strong>{hub.shortName}</strong><span>{id === "dota" ? `${copy.snapshot} ${dotaItemsSnapshot.patch.label}` : hub.version[lang]}</span></div>
              <FreshnessIndicator policy={id === "dota" ? snapshotPolicy : getHubFreshnessPolicy(id)} current={id === "dota" ? copy.recent : copy.context} stale={id === "gta" ? copy.ended : id === "dota" ? copy.old : copy.recheck} dateLabel={id === "dota" ? copy.fetched : copy.checked} lang={lang} />
            </a>;
          })}</div>
        </section>
        <section aria-labelledby="guides-title">
          <div class="mm-home-section-head mm-home-guides-head"><h2 id="guides-title">{copy.guides}</h2><a href={`${prefix}/insights/`}>{copy.allGuides} →</a></div>
          <div class="mm-home-guides">{featuredInsights.map((insight) => <a href={`${prefix}/insights/${insight.slug}/`}><span>{insightGameLabels[insight.game]} · {insight.content[lang].readTime}</span><strong>{insight.content[lang].title}</strong><b aria-hidden="true">↗</b></a>)}</div>
        </section>
      </div>
      <aside class="mm-home-watch"><div><h2>{copy.watch}</h2><p>{copy.watchText}</p></div><a href={`${prefix}/gta-6/`}>{copy.watchLink} →</a></aside>
      <details id="how-it-works" class="mm-home-how"><summary>{copy.howTitle}</summary><p>{copy.howText}</p><p>{copy.trust}</p></details>
      <SiteFooter lang={lang} />
    </div>
  </main>
</BaseLayout>

<script>
  const details = document.querySelector<HTMLDetailsElement>("#how-it-works");
  const revealHow = () => { if (details && location.hash === "#how-it-works") details.open = true; };
  revealHow();
  window.addEventListener("hashchange", revealHow);
</script>
