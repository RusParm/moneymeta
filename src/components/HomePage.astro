  featuredKicker: "Flagship analysis",
  featuredTitle: "Numbers that change the decision.",
  featuredText: "Focused field notes move from a popular claim to a testable conclusion and a tool.",
  allNotes: "All field notes",
  readNote: "Read",
  signalKicker: "Money Meta pulse",
  signalTitle: "Context moves. The models show it.",
  signalText: "Every tool separates verified context from editable baseline estimates.",
  validThrough: "Valid through",
  checked: "Checked",
  lastChecked: "Last checked",
  ended: "Ended",
  archive: "archive",
  recheck: "recheck required",
  gtaExpired: "The event has ended. The hub keeps an archive while permanent models continue to use player inputs.",
  dotaStale: `Patch ${dotaPatchContext.patch} needs a source recheck before it is treated as current context.`,
