  ],
  chooseKicker: "Когда смысл понятен",
  chooseTitle: "Теперь выбери экономику, которую хочешь освоить.",
  chooseText: "Каждый хаб начинается с карты и твоей ситуации, а уже потом ведёт к рейтингам, сценариям и калькуляторам.",
  active: "Доступно сейчас",
  gtaTag: "Экономика производства",
