import { insightGameLabels, insights } from "../data/insights";
import { compareDotaItems } from "../lib/dota-items";
import type { FreshnessPolicy } from "../lib/freshness";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "./BrandHeader.astro";
import FreshnessIndicator from "./FreshnessIndicator.astro";
import SiteFooter from "./SiteFooter.astro";
import "../styles/home.css";

interface Props {
  lang: "ru" | "en";
}

interface HomeGame {
  id: HubPortalId | FrontierHubId;
  image: ImageMetadata;
  accent: string;
  accentRgb: string;
  name: string;
  shortName: string;
  version: string;
  root: string;
  statusPath: string;
  status: "live" | "watch";
  freshness: FreshnessPolicy;
  question: string;
  text: string;
  inputNote: string;
  actions: Array<{ label: string; path: string }>;
}

