    ]
  },
  {
    id: "fable",
    image: fableWorld,
    accent: "#9bc96f",
    accentRgb: "155, 201, 111",
    name: fableHub.name,
    shortName: fableHub.shortName,
    version: fableHub.version[lang],
    root: getFrontierPath("fable", lang),
    statusPath: getFrontierPath("fable", lang, "sources"),
    status: "watch",
    freshness: { checkedAt: fableHub.checkedAt, staleAfterDays: fableHub.staleAfterDays },
    question: lang === "ru"
      ? "Репутация меняет цены. Что нужно измерить в первые часы после релиза?"
      : "Reputation changes prices. What should be measured in the first hours after launch?",
    text: lang === "ru"
      ? "Работа, собственность и живые жители подтверждены. Формулы не опубликованы, поэтому вместо фальшивого калькулятора здесь протокол запуска."
