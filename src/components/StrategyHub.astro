---
import type { ImageMetadata } from "astro";
import type { StrategyHubData, StrategyLocale } from "../data/strategy-hubs";
import "../styles/strategy-hub.css";
import { isOlderThanDays } from "../lib/freshness";
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "./BrandHeader.astro";
import GameWorldHero from "./GameWorldHero.astro";
import HubDecisionGateway from "./HubDecisionGateway.astro";
import SiteFooter from "./SiteFooter.astro";
import StrategyCalculators from "./StrategyCalculators.astro";
import StrategyMark from "./StrategyMark.astro";

interface Props { lang: StrategyLocale; data: StrategyHubData; image: ImageMetadata; }
const { lang, data, image } = Astro.props;
const prefix = lang === "ru" ? "" : "/en";
const root = `${prefix}/${data.slug}/`;
const alternatePath = `${lang === "ru" ? "/en" : ""}/${data.slug}/`;
const firstNode = data.economyNodes[0]!;
const pulseStale = isOlderThanDays(data.checkedAt, data.staleAfterDays);

const copy = lang === "ru" ? {
  back: "← Все экономики",
  nav: [["01", "Старт", "#quick-start"], ["02", "Карта", "#economy-map"], ["03", "Мой путь", "#player-paths"], ["04", "Обновления", data.id === "ck3" ? "#dynasty-pulse" : "#campaign-pulse"], ["05", "Решения", "#economy-lenses"], ["06", "Сценарии", "#decision-deck"], ["07", "Модели", "#scenario-lab"], ["08", "Библиотека", "#research-library"]],
  navLabel: `Навигация по экономике ${data.name}`,
  mapKicker: "Карта экономики · движение ресурсов",
  mapTitle: data.id === "ck3" ? "Проследи путь монеты через всё правление" : "Проследи путь монеты через всю кампанию",
  mapText: "Нажми на узел, чтобы увидеть ключевой сигнал, решение и инструмент для этой точки системы.",
  mapLabel: `Интерактивная карта экономики ${data.name}`,
  signal: "Ключевой сигнал",
  decision: "Решение игрока",
  openTool: "Открыть связанный инструмент",
  pathKicker: "Путь игрока · выбери свой подход",
  pathTitle: "Одна игра. Три разных способа вести кампанию.",
  pathText: "Выбери профиль, который ближе к твоей кампании. Получишь ограничения, порядок действий и условие, которое переворачивает план.",
  pathLabel: "Выбор профиля игрока",
  route: "Маршрут",
  flip: "Когда план меняется",
  runPath: "Открыть связанную модель",
  pulseKicker: data.id === "ck3" ? "Обновления династии · официальный контекст" : "Обновления кампании · официальный контекст",
  action: "Что делать иначе",
  source: "Первоисточник",
  verified: "Проверено по официальным источникам",
  recheck: "Нужна повторная проверка",
  freshnessTitle: "Проверка актуальности включена",
  freshnessCurrent: `Контекст проверен ${data.checkedAt} и находится внутри ${data.staleAfterDays}-дневного окна. Числа конкретной кампании по-прежнему вводит игрок.`,
  freshnessStale: `С последней проверки прошло ${data.staleAfterDays} дней. Материалы остаются историческим контекстом до повторной сверки источников.`,
  lensKicker: "Решения зависят от цели",
  lensTitle: data.id === "ck3" ? "Лучший ход меняется вместе с правлением" : "Лучший ход меняется вместе с фазой кампании",
  lensText: "Переключай цель и смотри, почему лучший вариант меняется. Здесь нет одной стратегии, которая подходит любой кампании.",
  question: "Вопрос",
  why: "Почему так",
  deckKicker: "Готовые сценарии · начни со своего вопроса",
  deckTitle: "Не начинай с пустого калькулятора. Начни со своей ситуации.",
  deckText: "Каждая карточка ведёт к подходящей модели или разделу. Останется заменить исходные значения цифрами своей кампании.",
  openScenario: "Открыть сценарий",
  libraryKicker: "Библиотека решений · первый выпуск",
  libraryTitle: "Не энциклопедия механик. Библиотека решений.",
  libraryText: `Шесть прикладных разборов по ${data.name}: главный вывод, границы расчёта и понятный следующий шаг.`,
  filters: [["all", "Все"], ["returner", "После перерыва"], ["casual", "Играю понемногу"], ["grinder", "Оптимизирую всё"]],
  showing: "материалов",
  takeaway: "Ключевой вывод",
  openBrief: "Проверить в модели",
  methodKicker: "Методика · источники · независимость",
  context: "Проверенный контекст",
  model: "Настраиваемая модель",
  independent: "Независимый проект",
  checked: "Проверено",
  sources: "Источники и границы модели",
  dataLabel: "Исходные значения"
} : {
  back: "← All economies",
  nav: [["01", "Start", "#quick-start"], ["02", "Map", "#economy-map"], ["03", "My path", "#player-paths"], ["04", "Pulse", data.id === "ck3" ? "#dynasty-pulse" : "#campaign-pulse"], ["05", "Decisions", "#economy-lenses"], ["06", "Scenarios", "#decision-deck"], ["07", "Models", "#scenario-lab"], ["08", "Library", "#research-library"]],
  navLabel: `${data.name} Economy Hub navigation`,
  mapKicker: "Economy map · capital flow",
  mapTitle: data.id === "ck3" ? "Follow one gold through an entire reign" : "Follow one gold through the entire campaign",
  mapText: "Select a node to see the key signal, the player decision and the connected tool at that point in the system.",
  mapLabel: `Interactive ${data.name} economy map`,
  signal: "Key signal",
  decision: "Player decision",
  openTool: "Open connected tool",
  pathKicker: "Personal path · choose your campaign system",
  pathTitle: "One game. Three different operating systems.",
  pathText: "Choose the profile closest to your campaign. Get constraints, an order of actions and the condition that changes the plan.",
  pathLabel: "Choose player profile",
  route: "Route",
  flip: "When the plan changes",
  runPath: "Open connected model",
  pulseKicker: data.id === "ck3" ? "Dynasty Pulse · official context" : "Campaign Pulse · official context",
  action: "What changes now",
  source: "Primary source",
  verified: "Verified · official",
  recheck: "Recheck required",
  freshnessTitle: "Freshness guard is on",
  freshnessCurrent: `Context was checked ${data.checkedAt} and remains inside the ${data.staleAfterDays}-day review window. Campaign values still come from the player.`,
  freshnessStale: `${data.staleAfterDays} days have passed since the last review. Cards remain historical context until the sources are checked again.`,
  lensKicker: "Decision lenses · no universal tier list",
  lensTitle: data.id === "ck3" ? "The best move changes with the reign" : "The best move changes with the campaign phase",
  lensText: "Switch the objective and see why the leader changes. This is a decision order, not one strategy promised to every player.",
  question: "Question",
  why: "Why this result",
  deckKicker: "Decision deck · prepared questions",
  deckTitle: "Do not start with an empty calculator. Start with your situation.",
  deckText: "Every card opens the relevant model or hub layer. Replace the baseline with values from your campaign from there.",
  openScenario: "Open scenario",
  libraryKicker: "Decision library · first release",
  libraryTitle: "Not a mechanics encyclopedia. A decision library.",
  libraryText: `Six practical ${data.name} briefs with a thesis, model boundary and direct path to action.`,
  filters: [["all", "All"], ["returner", "Returner"], ["casual", "Solo / casual"], ["grinder", "Optimizer"]],
  showing: "briefs",
  takeaway: "Key takeaway",
  openBrief: "Test in the model",
  methodKicker: "Methodology · sources · independence",
  context: "Verified context",
  model: "Editable model",
  independent: "Independent product",
  checked: "Checked",
  sources: "Sources and model boundaries",
  dataLabel: "Baseline numbers"
};

const pulseId = data.id === "ck3" ? "dynasty-pulse" : "campaign-pulse";
const proofValue = (value: string) => lang === "ru" && value === "Q4" ? "IV кв." : value;
---

<BaseLayout
  title={data.meta.title[lang]}
  description={data.meta.description[lang]}
  lang={lang}
  canonicalPath={root}
  alternatePath={alternatePath}
  schema={{
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: data.meta.title[lang],
    description: data.meta.description[lang],
    applicationCategory: "GameApplication",
    operatingSystem: "Web",
    isAccessibleForFree: true,
    inLanguage: lang,
    about: { "@type": "VideoGame", name: data.name, publisher: data.publisher },
    hasPart: data.models.map((model) => ({ "@type": "SoftwareApplication", name: model.title[lang], applicationCategory: "GameApplication" }))
  }}
>
  <main class={`page game-page strategy-living-hub strategy-${data.id}`} data-strategy-hub={data.id} data-lang={lang}>
    <div class="shell">
      <BrandHeader lang={lang} ruPath={`/${data.slug}/`} enPath={`/en/${data.slug}/`} backPath={lang === "ru" ? "/" : "/en/"} backLabel={copy.back} />

      <GameWorldHero
        image={image}
        alt={lang === "ru" ? `Оригинальная иллюстрация Money Meta: экономика ${data.name}` : `Original Money Meta illustration of the ${data.name} economy`}
        worldCode={data.worldCode[lang]}
        originalLabel={lang === "ru" ? "Оригинал Money Meta" : "Money Meta original"}
      >
        <div class="hero-live-line"><span></span>{data.hero.live[lang]}</div>
        <p class="eyebrow">{data.hero.eyebrow[lang]}</p>
        <h1>{data.hero.heading[lang]}</h1>
        <p class="lede">{data.hero.lede[lang]}</p>
        <div class="hero-actions">
          <a class="button primary button-large strategy-primary" href="#economy-map">{data.hero.primary[lang]} →</a>
          <a class="button ghost button-large" href={data.id === "ck3" ? "#succession-buffer" : "#war-reserve"}>{data.hero.secondary[lang]}</a>
        </div>
        <div class="proof-strip">
          {data.hero.proof.map(([value, label]) => <div class="proof-item"><strong>{proofValue(value)}</strong><span>{label[lang]}</span></div>)}
        </div>
        <div class="strategy-hero-loadout" aria-label={lang === "ru" ? `Системы ${data.name}` : `${data.name} systems`}>
          {data.hero.loadout.map((item) => (
            <div><StrategyMark mark={item.mark} lang={lang} /><span>{item.label[lang]}</span><strong>{item.value[lang]}</strong></div>
          ))}
        </div>
      </GameWorldHero>

      <nav class="hub-jump-nav strategy-jump-nav" aria-label={copy.navLabel}>
        <span class="hub-jump-brand"><i aria-hidden="true"></i>{lang === "ru" ? (data.id === "ck3" ? "CK3 / КАЗНА ДИНАСТИИ" : "TOTAL WAR / ЭКОНОМИКА КАМПАНИИ") : (data.id === "ck3" ? "CK3 / DYNASTY LEDGER" : "TOTAL WAR / CAMPAIGN OS")}</span>
        <div>{copy.nav.map(([code, label, href]) => <a href={href}><span>{code}</span>{label}</a>)}</div>
      </nav>

      <section class="hub-manifesto strategy-manifesto" aria-labelledby={`${data.id}-manifesto-title`}>
        <div>
          <span class="section-kicker">{data.manifesto.kicker[lang]}</span>
          <h2 id={`${data.id}-manifesto-title`}>{data.manifesto.title[lang]}</h2>
          <p>{data.manifesto.text[lang]}</p>
        </div>
        <div class="manifesto-grid">
          {data.manifesto.principles.map((principle, index) => (
            <div><span>0{index + 1} / {principle.title[lang]}</span><strong>{principle.title[lang]}</strong><p>{principle.text[lang]}</p></div>
          ))}
        </div>
      </section>

      <HubDecisionGateway hub={data.id} lang={lang} />
      <section id="economy-map" class="section hub-section hub-map-section strategy-map-section" aria-labelledby={`${data.id}-map-title`}>
        <div class="section-head hub-section-head">
          <div><span class="section-kicker">{copy.mapKicker}</span><h2 id={`${data.id}-map-title`}>{copy.mapTitle}</h2><p class="section-copy">{copy.mapText}</p></div>
          <span class="count">{lang === "ru" ? "01-07 · интерактивная карта" : "01-07 · interactive"}</span>
        </div>
        <div class="economy-map strategy-economy-map" data-strategy-map>
          <div class="economy-flow" aria-label={copy.mapLabel}>
            {data.economyNodes.map((node, index) => (
              <button
                class="economy-node strategy-economy-node"
                type="button"
                aria-pressed={index === 0 ? "true" : "false"}
                data-map-node
                data-code={node.code}
                data-title={node.title[lang]}
                data-phase={node.phase[lang]}
                data-summary={node.summary[lang]}
                data-signal={node.signal[lang]}
                data-decision={node.decision[lang]}
                data-href={node.href}
              >
                <StrategyMark mark={node.mark} lang={lang} />
                <span class="economy-node-index">{node.code}</span>
                <span class="economy-node-copy"><small>{node.phase[lang]}</small><strong>{node.title[lang]}</strong></span>
                <span class="economy-node-pulse" aria-hidden="true"></span>
              </button>
            ))}
          </div>
          <article class="economy-detail strategy-economy-detail" aria-live="polite">
            <div class="economy-detail-top"><span class="economy-detail-code" data-map-code>{firstNode.code}</span><StrategyMark mark={firstNode.mark} lang={lang} large /><span class="pill strategy-pill" data-map-phase>{firstNode.phase[lang]}</span></div>
            <h3 data-map-title>{firstNode.title[lang]}</h3>
            <p data-map-summary>{firstNode.summary[lang]}</p>
            <div class="economy-detail-grid">
              <div><span>{copy.signal}</span><strong data-map-signal>{firstNode.signal[lang]}</strong></div>
              <div><span>{copy.decision}</span><strong data-map-decision>{firstNode.decision[lang]}</strong></div>
            </div>
            <a class="map-tool-link" data-map-link href={firstNode.href}>{copy.openTool} →</a>
          </article>
        </div>
      </section>

      <section id="player-paths" class="section hub-section strategy-path-section" aria-labelledby={`${data.id}-paths-title`}>
        <div class="section-head hub-section-head">
          <div><span class="section-kicker">{copy.pathKicker}</span><h2 id={`${data.id}-paths-title`}>{copy.pathTitle}</h2><p class="section-copy">{copy.pathText}</p></div>
          <span class="count">{lang === "ru" ? "3 подхода к игре" : "3 player systems"}</span>
        </div>
        <div class="path-planner strategy-path-planner" data-strategy-paths>
          <div class="path-tabs" role="tablist" aria-label={copy.pathLabel}>
            {data.paths.map((path, index) => (
              <button type="button" role="tab" id={`${data.id}-path-tab-${path.id}`} aria-selected={index === 0 ? "true" : "false"} aria-controls={`${data.id}-path-panel-${path.id}`} tabindex={index === 0 ? "0" : "-1"} data-path-tab={path.id}>
                <StrategyMark mark={path.mark} lang={lang} /><span>0{index + 1}</span><strong>{path.label[lang]}</strong><small>{path.summary[lang]}</small>
              </button>
            ))}
          </div>
          <div class="path-panels">
            {data.paths.map((path, index) => (
              <article class="path-panel strategy-path-panel" id={`${data.id}-path-panel-${path.id}`} role="tabpanel" aria-labelledby={`${data.id}-path-tab-${path.id}`} hidden={index !== 0} data-path-panel={path.id}>
                <StrategyMark mark={path.mark} lang={lang} large />
                <div class="path-panel-head">
                  <div><span class="game-tag">{path.label[lang]} · {lang === "ru" ? "исходный сценарий" : "baseline"}</span><h3>{path.title[lang]}</h3></div>
                  <div class="path-constraints">{path.constraints.map((constraint) => <span><small>{constraint.label[lang]}</small><strong>{constraint.value[lang]}</strong></span>)}</div>
                </div>
                <div class="path-route">
                  <span class="path-route-label">{copy.route}</span>
                  {path.steps.map((step, stepIndex) => <div class="path-step"><span>{stepIndex + 1}</span><div><strong>{step.title[lang]}</strong><p>{step.text[lang]}</p></div></div>)}
                </div>
                <div class="path-panel-foot"><div class="path-flip"><span>{copy.flip}</span><p>{path.flip[lang]}</p></div><a class="button primary strategy-primary" href={path.href}>{copy.runPath} →</a></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section
        id={pulseId}
        class={`section hub-section pulse-section strategy-pulse-section ${pulseStale ? "is-stale" : "is-current"}`}
        data-strategy-pulse
        data-checked-at={data.checkedAt}
        data-stale-after={data.staleAfterDays}
        data-current-status={copy.verified}
        data-stale-status={copy.recheck}
        data-current-guard={copy.freshnessCurrent}
        data-stale-guard={copy.freshnessStale}
        aria-labelledby={`${data.id}-pulse-title`}
      >
        <div class="section-head hub-section-head">
          <div><span class="section-kicker">{copy.pulseKicker}</span><h2 id={`${data.id}-pulse-title`}>{data.pulse.title[lang]}</h2><p class="section-copy">{data.pulse.text[lang]}</p></div>
          <div class="pulse-status-stack"><span class="pill strategy-pill" data-pulse-status>{pulseStale ? copy.recheck : copy.verified}</span><span class="pulse-window">{data.version[lang]} · {data.checkedAt}</span></div>
        </div>
        <div class="pulse-grid">
          {data.pulse.changes.map((change, index) => (
            <article class="pulse-card strategy-pulse-card">
              <div class="strategy-pulse-head"><div class="pulse-card-top"><span>0{index + 1}</span><strong>{change.signal[lang]}</strong></div><StrategyMark mark={change.mark} lang={lang} /></div>
              <h3>{change.title[lang]}</h3><p>{change.summary[lang]}</p>
              <a class="strategy-source-link" href={change.sourceUrl} target="_blank" rel="noopener noreferrer">{copy.source} · {change.sourceLabel[lang]} ↗</a>
              <div class="pulse-decision"><span>{copy.action}</span><p>{change.decision[lang]}</p></div>
            </article>
          ))}
        </div>
        <div class="pulse-guard">
          <div class="pulse-orbit" aria-hidden="true"><span></span></div>
          <div><strong>{copy.freshnessTitle}</strong><p data-pulse-guard>{pulseStale ? copy.freshnessStale : copy.freshnessCurrent}</p></div>
          <a class="source-link" href={data.pulse.changes[0]!.sourceUrl} target="_blank" rel="noopener noreferrer">{copy.source} ↗</a>
        </div>
      </section>

      <section id="economy-lenses" class="section hub-section" aria-labelledby={`${data.id}-lenses-title`}>
        <div class="section-head hub-section-head"><div><span class="section-kicker">{copy.lensKicker}</span><h2 id={`${data.id}-lenses-title`}>{copy.lensTitle}</h2><p class="section-copy">{copy.lensText}</p></div><span class="pill strategy-pill">{lang === "ru" ? "Зависит от ситуации · оценка" : "Contextual · estimated"}</span></div>
        <div class="ranking-lab strategy-ranking-lab" data-strategy-lenses>
          <div class="ranking-tabs" role="tablist" aria-label={copy.lensKicker}>
            {data.lenses.map((lens, index) => <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? "0" : "-1"} data-lens-tab={lens.id}><small>0{index + 1}</small><strong>{lens.label[lang]}</strong></button>)}
          </div>
          {data.lenses.map((lens, lensIndex) => (
            <div class="ranking-panel" hidden={lensIndex !== 0} data-lens-panel={lens.id}>
              <div class="ranking-question"><div><span>{copy.question}</span><h3>{lens.question[lang]}</h3></div><code>{lens.formula[lang]}</code></div>
              <div class="conditional-rank-grid">
                {lens.cards.map((card, index) => (
                  <article class={`conditional-rank-card strategy-rank-card rank-${index + 1}`}>
                    <div class="conditional-rank-top"><span>0{index + 1}</span><div><StrategyMark mark={card.mark} lang={lang} /><span class={`pill ${index === 0 ? "strategy-pill" : "muted"}`}>{card.grade} · {card.fit}</span></div></div>
                    <h3>{card.title[lang]}</h3><p>{card.text[lang]}</p>
                    <div class="conditional-metrics">{card.metrics.map((metric) => <span><small>{metric.label[lang]}</small><strong>{metric.value[lang]}</strong></span>)}</div>
                  </article>
                ))}
              </div>
              <div class="ranking-note"><span>{copy.why}</span><p>{lens.note[lang]}</p></div>
            </div>
          ))}
        </div>
      </section>

      <section id="decision-deck" class="section hub-section" aria-labelledby={`${data.id}-deck-title`}>
        <div class="section-head hub-section-head"><div><span class="section-kicker">{copy.deckKicker}</span><h2 id={`${data.id}-deck-title`}>{copy.deckTitle}</h2><p class="section-copy">{copy.deckText}</p></div><span class="count">{lang === "ru" ? "6 готовых ситуаций" : "6 entry points"}</span></div>
        <div class="decision-deck-grid strategy-decision-deck">
          {data.scenarios.map((scenario, index) => (
            <a class:list={["decision-deck-card", "strategy-decision-card", { "is-featured": index === 1 }]} href={scenario.href}>
              <div class="decision-deck-top"><span>0{index + 1} · {scenario.mode[lang]}</span><StrategyMark mark={scenario.mark} lang={lang} /></div>
              <div><span class="game-tag">{scenario.eyebrow[lang]}</span><h3>{scenario.question[lang]}</h3><p>{scenario.outcome[lang]}</p></div>
              <strong>{copy.openScenario} →</strong>
            </a>
          ))}
        </div>
      </section>

      <StrategyCalculators lang={lang} data={data} />

      <section id="research-library" class="section hub-section" aria-labelledby={`${data.id}-library-title`} data-strategy-library>
        <div class="section-head hub-section-head"><div><span class="section-kicker">{copy.libraryKicker}</span><h2 id={`${data.id}-library-title`}>{copy.libraryTitle}</h2><p class="section-copy">{copy.libraryText}</p></div><span class="count"><span data-library-count>{data.briefs.length}</span> {copy.showing} · {lang === "ru" ? "на двух языках" : "RU/EN"}</span></div>
        <div class="library-filter" role="group" aria-label={copy.libraryKicker}>{copy.filters.map(([id, label], index) => <button type="button" aria-pressed={index === 0 ? "true" : "false"} data-library-filter={id}>{label}</button>)}</div>
        <div class="research-grid strategy-research-grid">
          {data.briefs.map((brief, index) => (
            <article class:list={["research-card", "strategy-research-card", { "research-featured": index === 0 }]} data-library-card data-audience={brief.audience}>
              <div class="research-card-meta"><span>0{index + 1}</span><div><StrategyMark mark={brief.mark} lang={lang} /><span class={`pill ${brief.status === "verified" ? "strategy-pill" : "muted"}`}>{lang === "ru" ? (brief.status === "verified" ? "проверено" : "модель") : brief.status}</span></div></div>
              <div class="research-card-body"><span class="game-tag">{brief.kicker[lang]}</span><h3>{brief.title[lang]}</h3><p>{brief.text[lang]}</p></div>
              <div class="strategy-brief-takeaway"><span>{copy.takeaway}</span><strong>{brief.takeaway[lang]}</strong></div>
              <a href={brief.href}>{copy.openBrief} →</a>
            </article>
          ))}
        </div>
      </section>

      <section id="methodology" class="section hub-section trust-rail strategy-trust-rail" aria-labelledby={`${data.id}-methodology-title`}>
        <div class="section-head hub-section-head"><div><span class="section-kicker">{copy.methodKicker}</span><h2 id={`${data.id}-methodology-title`}>{data.methodology.title[lang]}</h2><p class="section-copy">{data.methodology.text[lang]}</p></div><span class="count">{copy.checked} · {data.checkedAt}</span></div>
        <div class="trust-grid">
          <article class="trust-card"><div><span>01 · {copy.context}</span><span class="pill strategy-pill">{lang === "ru" ? "проверено" : "verified"}</span></div><h3>{data.version[lang]}</h3><p>{data.methodology.sources.map((source) => source.note[lang]).join(" ")}</p></article>
          <article class="trust-card"><div><span>02 · {copy.model}</span><span class="pill gold">{lang === "ru" ? "оценка" : "estimated"}</span></div><h3>{copy.dataLabel}</h3><p>{data.methodology.modelNote[lang]}</p></article>
          <article class="trust-card"><div><span>03 · {copy.independent}</span><span class="pill muted">{lang === "ru" ? "независимо" : "independent"}</span></div><h3>Money Meta</h3><p>{data.methodology.disclaimer[lang]}</p></article>
        </div>
        <details class="strategy-method-details"><summary>{copy.sources} ↓</summary><div>{data.methodology.sources.map((source) => <p><a class="source-link" href={source.url} target="_blank" rel="noopener noreferrer"><strong>{source.label[lang]} ↗</strong></a>: {source.note[lang]}</p>)}<p>{data.methodology.modelNote[lang]}</p><p>{data.methodology.disclaimer[lang]}</p><p>{data.methodology.roadmap[lang]}</p></div></details>
      </section>

      <SiteFooter lang={lang} />
    </div>
  </main>
</BaseLayout>

<script>
  import { isOlderThanDays } from "../lib/freshness";

  document.querySelectorAll<HTMLElement>("[data-strategy-pulse]").forEach((root) => {
    const checkedAt = root.dataset.checkedAt;
    const staleAfterDays = Number(root.dataset.staleAfter ?? 45);
    if (!checkedAt) return;
    const stale = isOlderThanDays(checkedAt, staleAfterDays);
    root.classList.toggle("is-stale", stale);
    root.classList.toggle("is-current", !stale);
    const status = root.querySelector<HTMLElement>("[data-pulse-status]");
    if (status) status.textContent = stale ? root.dataset.staleStatus ?? "Recheck" : root.dataset.currentStatus ?? "Verified";
    const guard = root.querySelector<HTMLElement>("[data-pulse-guard]");
    if (guard) guard.textContent = stale ? root.dataset.staleGuard ?? "Recheck" : root.dataset.currentGuard ?? "Current";
  });

  document.querySelectorAll<HTMLElement>("[data-strategy-map]").forEach((root) => {
    const nodes = [...root.querySelectorAll<HTMLButtonElement>("[data-map-node]")];
    const targets = {
      code: root.querySelector<HTMLElement>("[data-map-code]")!,
      phase: root.querySelector<HTMLElement>("[data-map-phase]")!,
      title: root.querySelector<HTMLElement>("[data-map-title]")!,
      summary: root.querySelector<HTMLElement>("[data-map-summary]")!,
      signal: root.querySelector<HTMLElement>("[data-map-signal]")!,
      decision: root.querySelector<HTMLElement>("[data-map-decision]")!,
      link: root.querySelector<HTMLAnchorElement>("[data-map-link]")!,
      mark: root.querySelector<HTMLElement>(".strategy-economy-detail .strategy-mark i")!
    };
    nodes.forEach((node) => node.addEventListener("click", () => {
      nodes.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === node)));
      targets.code.textContent = node.dataset.code ?? "";
      targets.phase.textContent = node.dataset.phase ?? "";
      targets.title.textContent = node.dataset.title ?? "";
      targets.summary.textContent = node.dataset.summary ?? "";
      targets.signal.textContent = node.dataset.signal ?? "";
      targets.decision.textContent = node.dataset.decision ?? "";
      targets.link.href = node.dataset.href ?? "#";
      targets.mark.textContent = node.querySelector<HTMLElement>(".strategy-mark i")?.textContent ?? "";
    }));
  });

  const activateTabs = (rootSelector: string, tabSelector: string, panelSelector: string, key: string) => {
    document.querySelectorAll<HTMLElement>(rootSelector).forEach((root) => {
      const tabs = [...root.querySelectorAll<HTMLButtonElement>(tabSelector)];
      const panels = [...root.querySelectorAll<HTMLElement>(panelSelector)];
      const activate = (tab: HTMLButtonElement) => {
        const id = tab.dataset[key];
        tabs.forEach((candidate) => { const selected = candidate === tab; candidate.setAttribute("aria-selected", String(selected)); candidate.tabIndex = selected ? 0 : -1; });
        panels.forEach((panel) => { panel.hidden = panel.dataset[key.replace("Tab", "Panel")] !== id; });
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(tab));
        tab.addEventListener("keydown", (event) => {
          if (event.key !== "ArrowRight" && event.key !== "ArrowLeft" && event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
          event.preventDefault();
          const direction = event.key === "ArrowRight" || event.key === "ArrowDown" ? 1 : -1;
          const next = tabs[(index + direction + tabs.length) % tabs.length]!;
          activate(next);
          next.focus();
        });
      });
    });
  };
  activateTabs("[data-strategy-paths]", "[data-path-tab]", "[data-path-panel]", "pathTab");
  activateTabs("[data-strategy-lenses]", "[data-lens-tab]", "[data-lens-panel]", "lensTab");

  document.querySelectorAll<HTMLElement>("[data-strategy-library]").forEach((root) => {
    const filters = [...root.querySelectorAll<HTMLButtonElement>("[data-library-filter]")];
    const cards = [...root.querySelectorAll<HTMLElement>("[data-library-card]")];
    const count = root.querySelector<HTMLElement>("[data-library-count]");
    filters.forEach((button) => button.addEventListener("click", () => {
      const filter = button.dataset.libraryFilter ?? "all";
      filters.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
      let visible = 0;
      cards.forEach((card) => { const matches = filter === "all" || card.dataset.audience === filter; card.hidden = !matches; if (matches) visible += 1; });
      if (count) count.textContent = String(visible);
    }));
  });
</script>
