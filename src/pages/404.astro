---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandHeader from "../components/BrandHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<BaseLayout title="404 — Money Meta" description="Page not found." canonicalPath="/404/">
  <main class="page">
    <div class="shell">
      <BrandHeader lang="ru" ruPath="/" enPath="/en/" />
      <section class="hero">
        <p class="eyebrow">404 · Lost transaction</p>
        <h1>Эта экономика пока не найдена.</h1>
        <p class="lede">Вернись на главную или открой GTA Online Economy Hub.</p>
        <div class="hero-actions">
          <a class="button primary" href="/">На главную</a>
          <a class="button ghost" href="/gta-online/">GTA Online Hub</a>
        </div>
      </section>
      <SiteFooter lang="ru" />
    </div>
  </main>
</BaseLayout>
